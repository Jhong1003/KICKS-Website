---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
	title: string;
	description?: string;
	header?: "default" | "custom";
}

const {
	title,
	description = "UIUC Korean-inspired futsal community · 리그 순위, 선수 기록, 경기 일정",
	header = "default",
} = Astro.props;

// Astro.site (set in astro.config.mjs) makes these absolute regardless of
// how deep the current route is (e.g. /players/[id]).
const ogImage = new URL("/og-image.png", Astro.site).toString();
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).toString();
---

<html lang="en">
	<head>
		<!--
			Language (see src/lib/i18n.ts). Runs before anything renders, so the
			page never flashes the wrong language: a saved choice wins, otherwise
			Korean browsers get Korean and everyone else English. Without
			JavaScript the page simply stays English (<html lang="en"> above).
		-->
		<script is:inline>
			(function () {
				var KEY = "kicks-lang";
				function pick() {
					var saved;
					try {
						saved = localStorage.getItem(KEY);
					} catch (e) {}
					if (saved === "en" || saved === "ko") return saved;
					var preferred = (navigator.languages && navigator.languages[0]) || navigator.language || "";
					return preferred.toLowerCase().indexOf("ko") === 0 ? "ko" : "en";
				}
				// Attributes can't hold two languages at once, so elements that need a
				// translated placeholder/aria-label carry both in data-i18n-attrs, e.g.
				// data-i18n-attrs='{"placeholder":{"en":"Password","ko":"비밀번호"}}'.
				function applyAttributes(lang) {
					document.querySelectorAll("[data-i18n-attrs]").forEach(function (el) {
						var map = JSON.parse(el.getAttribute("data-i18n-attrs"));
						Object.keys(map).forEach(function (attr) {
							el.setAttribute(attr, map[attr][lang]);
						});
					});
				}
				window.kicksSetLang = function (lang, remember) {
					document.documentElement.lang = lang;
					if (remember) {
						try {
							localStorage.setItem(KEY, lang);
						} catch (e) {}
					}
					applyAttributes(lang);
					document.dispatchEvent(new CustomEvent("kicks:langchange", { detail: lang }));
				};
				document.documentElement.lang = pick();
				document.addEventListener("DOMContentLoaded", function () {
					applyAttributes(document.documentElement.lang);
				});
			})();
		</script>
		<!-- Google tag (gtag.js) -->
		<script async src="https://www.googletagmanager.com/gtag/js?id=G-ZKK1G0QSJ8"></script>
		<script is:inline>
  			window.dataLayer = window.dataLayer || [];
  			function gtag(){dataLayer.push(arguments);}
  			gtag('js', new Date());

  			gtag('config', 'G-ZKK1G0QSJ8');
		</script>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<title>{title}</title>

		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="alternate icon" href="/favicon.ico" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />

		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:type" content="website" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />
	</head>
	<body>
		{header === "default" && <Header variant="default" />}
		<slot />
		<Footer />
	</body>
</html>
