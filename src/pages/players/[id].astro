---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PlayerCard from "../../components/PlayerCard.astro";
import BadgeGuide from "../../components/BadgeGuide.astro";
import T from "../../components/T.astro";
import WeeklyStatsChart from "../../components/WeeklyStatsChart.astro";
import profilesData from "../../data/player_profiles.json";
import playerPhotosData from "../../data/player-photos.json";
import { BADGES, BADGE_TIER_LABELS, BADGE_TIER_LABELS_KO, FEATURED_BADGE, sortBadges, type PlayerProfile } from "../../lib/players";
import { getLeague, getTeamColor, getTeamName } from "../../lib/leagues";
import { isLeagueFinished, isShownInLeague } from "../../lib/finale";

export function getStaticPaths() {
	const profiles = profilesData as PlayerProfile[];
	return profiles.map((player) => ({
		params: { id: player.id },
		props: { player },
	}));
}

interface Props {
	player: PlayerProfile;
}

const { player } = Astro.props;
const playerPhotos = playerPhotosData as Record<string, string>;

const plural = (count: number, word: string) => `${count} ${word}${count === 1 ? "" : "s"}`;
---

<BaseLayout
	title={`${player.name} | KICKS Players`}
	description={`${player.name}'s KICKS player profile — league stats, play style, and badges.`}
>
	<main>
		<section class="content-section player-detail-head" aria-labelledby="player-detail-title">
			<a class="back-link" href="/players">
				<T en="← All players" ko="← 전체 선수" />
			</a>
			<h1 id="player-detail-title">{player.name}</h1>
			{player.positions.length > 0 && (
				<p class="player-positions">
					{player.positions.map((position) => (
						<span class={`position-chip position-${position}`}>{position}</span>
					))}
				</p>
			)}
			{
				/* One league at a time, newest first; ?league=<id> (used by links
				   from that league's roster, stats and honours) opens that one. */
				player.leagues.length > 1 && (
					<div class="league-switcher" role="group" aria-label="Choose a league">
						{player.leagues.map((section, index) => (
							<button
								class="league-switcher-link"
								type="button"
								data-league-button={section.league}
								aria-pressed={index === 0 ? "true" : "false"}
							>
								{section.league}
							</button>
						))}
					</div>
				)
			}
		</section>
		{
			player.leagues.map((section, index) => {
				const league = getLeague(section.league);
				const teamName = getTeamName(section.current_team_id, league);
				const teamColor = getTeamColor(section.current_team_id, league);

				return (
					<div data-league-panel={section.league} hidden={index !== 0}>
						<section class="content-section" aria-labelledby={`player-league-${section.league}`}>
							<div class="player-name-row">
								<p class="section-label" id={`player-league-${section.league}`}>
									{section.league} · {teamName}
								</p>
								{isLeagueFinished(section.league) && isShownInLeague(player, section.league) && (
									<a class="wrapped-entry" href={`/wrapped/${section.league}/${player.id}`}>
										<span aria-hidden="true">🎁</span>
										<T en={`My ${section.league} Wrapped`} ko={`나의 ${section.league} Wrapped 보기`} />
										<span aria-hidden="true">→</span>
									</a>
								)}
							</div>

							<div class="about-intro player-detail">
								<div class="split-photo player-detail-card-col">
									<PlayerCard
										player={player}
										section={section}
										teamName={teamName}
										teamColor={teamColor}
										size="large"
										avatarPhoto={playerPhotos[player.id]}
									/>
								</div>
								<div class="about-intro-text">
									{section.team_history.length > 0 && (
										<div class="player-detail-meta">
											<p class="section-label"><T en="TEAM HISTORY" ko="이전 소속 팀" /></p>
											<T
												as="p"
												class="about-description"
												en={`Previously played for ${section.team_history.map((segment) => getTeamName(segment.team_id, league)).join(", ")} earlier in this league.`}
												ko={`이번 리그 초반에는 ${section.team_history.map((segment) => getTeamName(segment.team_id, league)).join(", ")} 소속이었어요.`}
											/>
										</div>
									)}

									{section.personal_best_week && (
										<div class="player-detail-meta">
											<p class="section-label"><T en="PERSONAL BEST WEEK" ko="개인 최고 기록 주간" /></p>
											<T
												as="p"
												class="about-description"
												en={`Week ${section.personal_best_week.week}: ${plural(section.personal_best_week.goals, "goal")} and ${plural(section.personal_best_week.assists, "assist")} (${plural(section.personal_best_week.attacking_points, "attacking point")}).`}
												ko={`${section.personal_best_week.week}주차: ${section.personal_best_week.goals}골 ${section.personal_best_week.assists}어시스트 (공격포인트 ${section.personal_best_week.attacking_points}개)`}
											/>
										</div>
									)}

									<div class="player-detail-meta">
										<div class="player-badge-head">
											<p class="section-label"><T en="BADGES" ko="배지" /></p>
											<button
												class="player-badge-guide-link"
												type="button"
												aria-haspopup="dialog"
												data-badge-guide-open={`badge-guide-${section.league}`}
											>
												<T en="All Badges" ko="배지 목록" /> →
											</button>
										</div>
										<BadgeGuide
											id={`badge-guide-${section.league}`}
											league={section.league}
											playerBadges={section.badges}
										/>
										<div class="player-badge-list">
											{sortBadges(section.badges).map((key) => (
												<div class:list={["player-badge-item", `player-badge-item--${BADGES[key].tier}`, { "player-badge-item--champion": key === FEATURED_BADGE }]}>
													<span class="player-badge-icon" aria-hidden="true">
														{BADGES[key].icon}
													</span>
													<div>
														<p class="player-badge-label">
															<T en={BADGES[key].label} ko={BADGES[key].labelKo ?? BADGES[key].label} />
															<span class="player-badge-tier">
																<T
																	en={BADGE_TIER_LABELS[BADGES[key].tier]}
																	ko={BADGE_TIER_LABELS_KO[BADGES[key].tier]}
																/>
															</span>
														</p>
														<T
															as="p"
															class="player-badge-description"
															en={BADGES[key].description}
															ko={BADGES[key].descriptionKo}
														/>
													</div>
												</div>
											))}
										</div>
									</div>
								</div>
							</div>
						</section>

						<section class="content-section" aria-labelledby={`player-chart-title-${section.league}`}>
							<h2 id={`player-chart-title-${section.league}`}><T en="Week by Week" ko="주차별 기록" /></h2>
							<WeeklyStatsChart weeklyStats={section.weekly_stats} />
						</section>
					</div>
				);
			})
		}
	</main>
</BaseLayout>

<script>
	const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-league-button]"));
	const panels = Array.from(document.querySelectorAll<HTMLElement>("[data-league-panel]"));

	function showLeague(id: string, updateUrl: boolean) {
		if (!panels.some((panel) => panel.dataset.leaguePanel === id)) return;
		buttons.forEach((button) => button.setAttribute("aria-pressed", String(button.dataset.leagueButton === id)));
		panels.forEach((panel) => {
			panel.hidden = panel.dataset.leaguePanel !== id;
		});
		if (updateUrl) {
			const url = new URL(window.location.href);
			url.searchParams.set("league", id);
			history.replaceState(null, "", url);
		}
	}

	buttons.forEach((button) => {
		button.addEventListener("click", () => showLeague(button.dataset.leagueButton ?? "", true));
	});
	const requested = new URLSearchParams(window.location.search).get("league");
	if (requested) showLeague(requested, false);
</script>
