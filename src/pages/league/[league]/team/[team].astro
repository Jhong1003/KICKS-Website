---
// One team's page within one league: /league/<league>/team/<team_id>
// (e.g. /league/FA26-L2/team/T1). Team ids are only unique inside a league
// and teams are re-drawn every league, so a team page always belongs to
// exactly one league — nothing here is combined across leagues.
//
// Shows the team's record (from league_table.json, already in official
// order), "This League" panels from src/lib/team-stats.ts (recent form,
// head-to-head, team records, team leaders counting only weeks on this
// team, published title chances), its squad (player cards, forwards to
// goalkeeper; never ordered by a stat, same rule as /players) and its
// fixtures/results week by week. Captain/motto/photo come from the
// hand-edited src/data/team-info.json.
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import { teamOgImage } from "../../../../lib/og";
import T from "../../../../components/T.astro";
import leagueTableData from "../../../../data/league_table.json";
import matchesData from "../../../../data/matches.json";
import goalEventsData from "../../../../data/goal_events.json";
import profilesData from "../../../../data/player_profiles.json";
import { getPlayerPhotos } from "../../../../lib/player-photos";
import { leagues, getTeamColor, getTeamName, type League, type LeagueTeam } from "../../../../lib/leagues";
import { getSection, getContrastingTextColor, type PlayerInLeague, type PlayerProfile } from "../../../../lib/players";
import { isLeagueFinished, isShownInLeague } from "../../../../lib/finale";
import { formatShortDate, weekLabel } from "../../../../lib/i18n";
import { titleHistory } from "../../../../lib/forecasts";
import { headToHead, recentForm, teamLeaders, teamRecords, teamResults } from "../../../../lib/team-stats";
import teamInfoData from "../../../../data/team-info.json";
import TeamDuos from "../../../../components/TeamDuos.astro";
import { teamDuos, DUO_MIN_TEAM_GOALS, type DuoGoal } from "../../../../lib/duos";
import { AXES, averageProfile, teamProfile, MIN_MATCHES, type ProfileGoal, type TeamProfile } from "../../../../lib/team-profile";
import { leagueParts } from "../../../../lib/leagues";

export function getStaticPaths() {
	return leagues.flatMap((league) => league.teams.map((team) => ({ params: { league: league.id, team: team.team_id }, props: { league, team } })));
}

interface Props {
	league: League;
	team: LeagueTeam;
}

interface MatchRecord {
	league: string;
	match_id: string;
	week: number;
	round: number;
	date: string;
	home_team_id: string | null;
	away_team_id: string | null;
	home_score: number | null;
	away_score: number | null;
	status: "completed" | "scheduled";
}

const { league, team } = Astro.props;
const color = getTeamColor(team.team_id, league);
const headerText = getContrastingTextColor(color);
const finished = isLeagueFinished(league.id);

// --- Record -----------------------------------------------------------------
const table = leagueTableData.filter((row) => row.league === league.id);
const row = table.find((entry) => entry.team_id === team.team_id);
const sharedRank = row ? table.filter((entry) => entry.rank === row.rank).length > 1 : false;
const isChampion = finished && row?.rank === 1;

// --- Squad --------------------------------------------------------------------
const POSITION_ORDER = ["FW", "MF", "DF", "GK"];
const positionRank = (entry: PlayerInLeague) => {
	const index = POSITION_ORDER.indexOf(entry.player.positions[0] ?? "");
	return index === -1 ? POSITION_ORDER.length : index;
};
const collator = new Intl.Collator("ko");

const inLeague = (profilesData as PlayerProfile[]).flatMap((player): PlayerInLeague[] => {
	const section = getSection(player, league.id);
	return section && isShownInLeague(player, league.id) ? [{ player, section }] : [];
});
const squad = inLeague
	.filter(({ section }) => section.current_team_id === team.team_id)
	.sort((a, b) => positionRank(a) - positionRank(b) || collator.compare(a.player.name, b.player.name));
// Players who moved to another team mid-league but played here first.
const formerPlayers = inLeague
	.filter(({ section }) => section.current_team_id !== team.team_id && section.team_history.some((segment) => segment.team_id === team.team_id))
	.sort((a, b) => collator.compare(a.player.name, b.player.name));

// --- Fixtures & results -------------------------------------------------------
const teamMatches = (matchesData as MatchRecord[])
	.filter((match) => match.league === league.id && (match.home_team_id === team.team_id || match.away_team_id === team.team_id))
	.map((match) => {
		const home = match.home_team_id === team.team_id;
		const opponentId = home ? match.away_team_id : match.home_team_id;
		const scored = match.home_score !== null && match.away_score !== null;
		const ours = scored ? (home ? match.home_score! : match.away_score!) : null;
		const theirs = scored ? (home ? match.away_score! : match.home_score!) : null;
		const result: "W" | "L" | "D" | null = ours === null || theirs === null ? null : ours > theirs ? "W" : ours < theirs ? "L" : "D";
		return { ...match, opponentId, ours, theirs, result };
	})
	.sort((a, b) => a.week - b.week || a.round - b.round || a.match_id.localeCompare(b.match_id));

const weeks = [...new Set(teamMatches.map((match) => match.week))].map((week) => {
	const matches = teamMatches.filter((match) => match.week === week);
	const played = matches.filter((match) => match.result);
	return {
		week,
		date: matches[0].date,
		matches,
		record: {
			W: played.filter((match) => match.result === "W").length,
			D: played.filter((match) => match.result === "D").length,
			L: played.filter((match) => match.result === "L").length,
		},
		played: played.length,
	};
});

const RESULT_TEXT = {
	W: { en: "W", ko: "승" },
	D: { en: "D", ko: "무" },
	L: { en: "L", ko: "패" },
} as const;

const otherTeams = league.teams.filter((entry) => entry.team_id !== team.team_id);

// --- This league's numbers (src/lib/team-stats.ts) -----------------------------
const results = teamResults(matchesData as MatchRecord[], league.id, team.team_id);
const form = recentForm(results);
const h2h = headToHead(results, otherTeams.map((entry) => entry.team_id)).filter((entry) => entry.played > 0);
const records = teamRecords(results);
const nameOf = new Map(inLeague.map(({ player }) => [player.player_id, player]));
const leaders = teamLeaders(
	inLeague.map(({ player, section }) => ({ playerId: player.player_id, weekly: section.weekly_stats })),
	team.team_id,
);
const leaderPlayers = (ids: string[]) => ids.flatMap((id) => (nameOf.has(id) ? [nameOf.get(id)!] : []));

// Published title chances (forecasts/title_forecasts.csv), this team only.
const titleChances = titleHistory(league.id)
	.filter((entry) => entry.chances[team.team_id] !== undefined)
	.map((entry) => ({ week: entry.week, p: entry.chances[team.team_id] }));
const pct = (p: number) => (p < 0.001 ? "<0.1%" : p > 0.999 ? ">99.9%" : `${(p * 100).toFixed(p < 0.1 ? 1 : 0)}%`);

// Team style hexagon (src/lib/team-profile.ts): this team + the league average.
// Everyone who played in this league counts (also players who later left),
// since their goals are in the team's numbers.
const leaguePlayers = (profilesData as PlayerProfile[]).flatMap((player) => {
	const section = getSection(player, league.id);
	return section ? [{ weekly: section.weekly_stats }] : [];
});
const profileOf = (teamId: string) =>
	teamProfile(league.id, teamId, matchesData as MatchRecord[], leaguePlayers, table.find((entry) => entry.team_id === teamId)?.participation_rate ?? null, goalEventsData as ProfileGoal[]);
const styleProfile = profileOf(team.team_id);
const leagueAverage = averageProfile(league.teams.map((entry) => profileOf(entry.team_id)).filter((p): p is TeamProfile => p !== null));

// Duos (src/lib/duos.ts): the pairs who have combined for the most goals. Names
// are joined here, as everywhere else, and a pair is dropped if either player
// can't be resolved rather than rendering a blank side.
const playerById = new Map((profilesData as PlayerProfile[]).map((player) => [player.player_id, player]));
type DuoSide = { id: string; name: string };
const duos = teamDuos(goalEventsData as DuoGoal[], league.id, team.team_id).flatMap((duo) => {
	const first = playerById.get(duo.playerIds[0]);
	const second = playerById.get(duo.playerIds[1]);
	if (!first || !second) return [];
	const players: [DuoSide, DuoSide] = [
		{ id: first.id, name: first.name },
		{ id: second.id, name: second.name },
	];
	return [{ players, goals: duo.goals }];
});

// Hand-edited extras (src/data/team-info.json): captain (exact name), motto, photo,
// reel (the team intro Instagram reel — its link or just its ID).
interface TeamInfo {
	captain?: string;
	motto?: string;
	motto_en?: string;
	photo?: string;
	reel?: string;
}
const info = ((teamInfoData as Record<string, Record<string, TeamInfo>>)[league.id] ?? {})[team.team_id] ?? {};
const captain = info.captain ? (profilesData as PlayerProfile[]).find((player) => player.name === info.captain) : undefined;
const captainId = captain?.player_id;
// Accept the copied share link (…/reel/<id>/?utm_source=…) or the bare ID.
const reelId = info.reel ? (info.reel.match(/\/(?:reels?|p)\/([A-Za-z0-9_-]+)/)?.[1] ?? info.reel.trim()) : undefined;
const reelValid = reelId !== undefined && /^[A-Za-z0-9_-]+$/.test(reelId);

// ---- KICKS 2.0 ----
const { season, name: leagueName } = leagueParts(league.id);
const stripColor = `color-mix(in srgb, ${color} 72%, #000)`;
// Captain first, then by name (same rule everywhere a squad is listed).
const squadOrdered = [...squad].sort(
	(a, b) => Number(b.player.player_id === captainId) - Number(a.player.player_id === captainId) || collator.compare(a.player.name, b.player.name),
);
// Team style: the six numbers, each compared with the league average on the same fixed scale.
const styleCells = styleProfile
	? AXES.map((axis, index) => {
			const mine = styleProfile.axes[index];
			const avg = leagueAverage[index];
			return {
				en: axis.en,
				ko: axis.ko,
				raw: mine.raw,
				state: mine.value === null || avg === null ? null : mine.value > avg + 0.005 ? "above" : mine.value < avg - 0.005 ? "below" : "even",
			};
		})
	: [];
const initialOf = (teamId: string | null) => (teamId ? getTeamName(teamId, league).slice(0, 1) : "?");
---

<BaseLayout ogImage={teamOgImage(league.id, team.team_id)} title={`${team.name} · ${league.id} | KICKS`} description={`${team.name} in KICKS ${league.id}: record, squad, and results.`}>
	<main class="k-page tp">
		<a class="k-link tp-back" href={`/league/${league.id}/`}>← <T en={`${season} ${leagueName}`} ko={`${season} ${leagueName}`} /></a>

		<section class="tp-strip" style={`background: ${stripColor}`} aria-labelledby="team-title">
			<div class="tp-strip-main">
				<span class="tp-emblem" style={`color: ${color}`} aria-hidden="true">{team.name.slice(0, 1)}</span>
				<div>
					{isChampion && <p class="tp-champion">Champions</p>}
					<h1 class="tp-name" id="team-title">{team.name}</h1>
					<p class="tp-line">
						{season} {leagueName}
						{info.captain && (
							<>
								{" · "}
								<T en="Captain " ko="주장 " />
								{captain ? <a href={`/players/${captain.id}/?league=${league.id}`}>{captain.name}</a> : info.captain}
							</>
						)}
					</p>
					{info.motto && <T as="p" class="tp-motto" en={`“${info.motto_en ?? info.motto}”`} ko={`“${info.motto}”`} />}
					{reelValid && (
						<button type="button" class="tp-reel" data-reel-open>
							▶ <T en="Team intro · Instagram" ko="팀 소개 · 인스타그램" />
						</button>
					)}
				</div>
			</div>
			{row && row.played > 0 && (
				<dl class="tp-numbers">
					<div>
						<dt><T en="Rank" ko="순위" /></dt>
						<dd>{sharedRank ? `T${row.rank}` : row.rank}</dd>
					</div>
					<div>
						<dt><T en="Points" ko="승점" /></dt>
						<dd>{row.points}</dd>
					</div>
					<div>
						<dt>W-D-L</dt>
						<dd>{row.wins}-{row.draws}-{row.losses}</dd>
					</div>
					<div>
						<dt><T en="GD" ko="득실" /></dt>
						<dd>{row.goal_difference > 0 ? `+${row.goal_difference}` : row.goal_difference}</dd>
					</div>
				</dl>
			)}
		</section>

		{
			reelValid && (
				<dialog class="team-reel-dialog" style={`--team-color: ${color};`} data-reel-dialog data-reel-src={`https://www.instagram.com/reel/${reelId}/embed`} aria-label={`${team.name} team intro reel`}>
					<button type="button" class="team-reel-close" data-reel-close aria-label="Close">✕</button>
					<div class="team-reel-frame">
						<iframe title={`${team.name} team intro reel`} allowfullscreen scrolling="no"></iframe>
					</div>
					<a class="team-reel-link" href={`https://www.instagram.com/reel/${reelId}/`} target="_blank" rel="noopener">
						<T en="Watch on Instagram ↗" ko="인스타그램에서 보기 ↗" />
					</a>
				</dialog>
			)
		}

		<section class="k-section" aria-labelledby="tp-weeks">
			<div class="k-section-head">
				<h2 class="k-h2" id="tp-weeks"><T en="Week by week" ko="주차별 기록" /></h2>
				<T class="k-meta" en="Six matches every league day." ko="한 주에 6경기를 진행합니다." />
			</div>
			{weeks.length === 0 ? (
				<T as="p" class="k-meta" en="No fixtures yet." ko="아직 경기 일정이 없습니다." />
			) : (
				<div class="tp-weeks">
					{weeks.map((week) => (
						<a class="tp-week k-card" href={`/league/${league.id}/?week=${week.week}#results`}>
							<span class="tp-week-head">
								<span class="tp-week-label"><T en={weekLabel(week.week, "en")} ko={weekLabel(week.week, "ko")} /></span>
								<span class="k-meta"><T en={formatShortDate(week.date, "en")} ko={formatShortDate(week.date, "ko")} /></span>
							</span>
							<span class="tp-week-record">
								{week.played > 0 ? (
									<T en={`${week.record.W}W ${week.record.D}D ${week.record.L}L`} ko={`${week.record.W}승 ${week.record.D}무 ${week.record.L}패`} />
								) : (
									<T en="Upcoming" ko="예정" />
								)}
							</span>
							<span class="tp-cells">
								{week.matches.map((match) => (
									<span class={`tp-cell tp-cell--${match.result ?? "none"}`}>
										<span class="tp-cell-opp" style={`color: ${getTeamColor(match.opponentId, league)}`}>{initialOf(match.opponentId)}</span>
										<span class="tp-cell-result">{match.result ? <T en={RESULT_TEXT[match.result].en} ko={RESULT_TEXT[match.result].ko} /> : "–"}</span>
										<span class="tp-cell-score">{match.ours !== null ? `${match.ours}-${match.theirs}` : ""}</span>
									</span>
								))}
							</span>
						</a>
					))}
				</div>
			)}
		</section>

		{row && row.played > 0 && (
			<section class="k-section" aria-labelledby="tp-style">
				<div class="k-section-head">
					<h2 class="k-h2" id="tp-style"><T en="Team style" ko="팀 스타일" /></h2>
					{styleCells.length > 0 && <T class="k-meta" en={`Compared with the ${season} ${leagueName} average.`} ko={`${season} ${leagueName} 평균과 비교한 수치입니다.`} />}
				</div>
				{styleCells.length > 0 ? (
					<dl class="tp-style">
						{styleCells.map((cell) => (
							<div class="k-card">
								<dt><T en={cell.en} ko={cell.ko} /></dt>
								<dd class="tp-style-value"><T en={cell.raw.en} ko={cell.raw.ko} /></dd>
								<dd class={`tp-style-vs tp-style-vs--${cell.state ?? "none"}`}>
									{cell.state === "above" && <T en="Above average" ko="평균 이상" />}
									{cell.state === "below" && <T en="Below average" ko="평균 이하" />}
									{cell.state === "even" && <T en="League average" ko="평균 수준" />}
									{cell.state === null && <T en="Not enough data" ko="데이터 부족" />}
								</dd>
							</div>
						))}
					</dl>
				) : (
					<T as="p" class="k-meta" en={`Shows after ${MIN_MATCHES} matches (two weeks).`} ko={`${MIN_MATCHES}경기(2주차)가 지나면 나옵니다.`} />
				)}
			</section>
		)}

		<section class="k-section" aria-labelledby="tp-squad">
			<div class="k-section-head">
				<h2 class="k-h2" id="tp-squad"><T en="Squad" ko="선수단" /></h2>
				<span class="k-meta"><T en={`${squad.length} players`} ko={`${squad.length}명`} /></span>
			</div>
			{squadOrdered.length > 0 ? (
				<ul class="tp-squad">
					{squadOrdered.map(({ player, section }) => (
						<li>
							<a class="tp-player" href={`/players/${player.id}/?league=${league.id}`}>
								<span class="tp-player-tag">{section.play_style_tag}</span>
								<span class="tp-player-avatar" style={`background: ${color}; color: ${headerText}`}>{player.avatar_initials}</span>
								<span class="tp-player-name">
									{player.name}
									{player.player_id === captainId && <span class="tp-c">C</span>}
								</span>
								<span class="tp-player-stats">
									<T en={`${section.season_totals.goals} G · ${section.season_totals.assists} A`} ko={`${section.season_totals.goals}골 · ${section.season_totals.assists}도움`} />
								</span>
							</a>
						</li>
					))}
				</ul>
			) : (
				<T as="p" class="k-meta" en="The squad hasn't been announced yet." ko="아직 선수단이 발표되지 않았습니다." />
			)}
			{formerPlayers.length > 0 && (
				<p class="k-meta tp-former">
					<T en="Also played here earlier in this league: " ko="이번 리그 초반에 함께 뛴 선수: " />
					{formerPlayers.map(({ player }, index) => (
						<>
							{index > 0 && ", "}
							<a href={`/players/${player.id}/?league=${league.id}`}>{player.name}</a>
						</>
					))}
				</p>
			)}
		</section>

		{results.length > 0 && (
			<div class="k-section tp-small">
				<section class="tp-small-card k-card" aria-labelledby="tp-duos">
					<h2 class="k-h3" id="tp-duos"><T en="Duos" ko="합작 듀오" /></h2>
					{duos.length > 0 ? (
						<>
							<T as="p" class="k-meta tp-small-note" en="Most goals scored together." ko="가장 많은 골을 합작한 듀오" />
							<TeamDuos duos={duos} leagueId={league.id} color={color} />
						</>
					) : (
						<T as="p" class="k-meta tp-small-note" en={`Shows once the team has ${DUO_MIN_TEAM_GOALS} assisted goals.`} ko={`도움이 있는 골이 ${DUO_MIN_TEAM_GOALS}골 이상이면 나옵니다.`} />
					)}
				</section>

				<section class="tp-small-card k-card" aria-labelledby="tp-h2h">
					<h2 class="k-h3" id="tp-h2h"><T en="Head-to-head" ko="상대 전적" /></h2>
					<ul class="tp-list">
						{h2h.map((entry) => (
							<li>
								<span class="tp-list-name" style={`--team-color: ${getTeamColor(entry.opponentId, league)}`}>
									<span class="k-team-dot" aria-hidden="true" />
									<a href={`/league/${league.id}/team/${entry.opponentId}/`}>{getTeamName(entry.opponentId, league)}</a>
								</span>
								<span><T en={`${entry.W}W ${entry.D}D ${entry.L}L`} ko={`${entry.W}승 ${entry.D}무 ${entry.L}패`} /></span>
								<span class="k-meta">{entry.goalsFor}–{entry.goalsAgainst}</span>
							</li>
						))}
					</ul>
				</section>

				<section class="tp-small-card k-card" aria-labelledby="tp-records">
					<h2 class="k-h3" id="tp-records"><T en="Team records" ko="팀 기록" /></h2>
					<dl class="tp-records">
						{records.biggestWins.length > 0 && (
							<div>
								<dt><T en="Biggest win" ko="최다 점수 차 승리" /></dt>
								<dd>
									{records.biggestWins.map((match, index) => (
										<>
											{index > 0 && <br />}
											{match.ours}–{match.theirs} vs {getTeamName(match.opponentId, league)}{" "}
											<span class="k-meta">(<T en={weekLabel(match.week, "en")} ko={weekLabel(match.week, "ko")} />)</span>
										</>
									))}
								</dd>
							</div>
						)}
						{records.longestWinStreak > 1 && (
							<div>
								<dt><T en="Longest winning run" ko="최다 연승" /></dt>
								<dd><T en={`${records.longestWinStreak} in a row`} ko={`${records.longestWinStreak}연승`} /></dd>
							</div>
						)}
						{records.longestUnbeaten > 1 && (
							<div>
								<dt><T en="Longest unbeaten run" ko="최장 무패" /></dt>
								<dd><T en={`${records.longestUnbeaten} matches`} ko={`${records.longestUnbeaten}경기`} /></dd>
							</div>
						)}
						<div>
							<dt><T en="Clean sheets" ko="무실점 경기" /></dt>
							<dd>{records.cleanSheets}</dd>
						</div>
						{leaders.goals.playerIds.length > 0 && (
							<div>
								<dt><T en="Top scorer" ko="팀 최다 골" /></dt>
								<dd>
									{leaderPlayers(leaders.goals.playerIds).map((player, index) => (
										<>
											{index > 0 && ", "}
											<a href={`/players/${player.id}/?league=${league.id}`}>{player.name}</a>
										</>
									))}{" "}
									<span class="k-meta">· {leaders.goals.value}</span>
								</dd>
							</div>
						)}
					</dl>
				</section>
			</div>
		)}
	</main>
</BaseLayout>

<script>
	// Team intro reel pop-up: load the Instagram embed only when opened, and
	// blank it on close so the video stops playing.
	const dialog = document.querySelector<HTMLDialogElement>("[data-reel-dialog]");
	const frame = dialog?.querySelector("iframe");
	const openReel = () => {
		if (!dialog || !frame) return;
		frame.src = dialog.dataset.reelSrc ?? "";
		dialog.showModal();
	};
	document.querySelector("[data-reel-open]")?.addEventListener("click", openReel);
	dialog?.querySelector("[data-reel-close]")?.addEventListener("click", () => dialog.close());
	// A click on the dark backdrop (outside the video) closes it too.
	dialog?.addEventListener("click", (event) => {
		if (event.target === dialog) dialog.close();
	});
	dialog?.addEventListener("close", () => {
		if (frame) frame.src = "about:blank";
	});
</script>
