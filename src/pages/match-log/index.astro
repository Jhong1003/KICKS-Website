---
// Match-day log for the league manager, on a phone at the field: pick the
// match, press Kick-off, and tap team → scorer → assist when a goal goes in.
// The minute comes from the running 12-minute clock (elapsed time rounded up,
// same rule as the Sheet: 5:30 → 6). At 12:00 the clock turns red (and the
// phone vibrates where the browser allows it); ending a match goes straight
// to the next one. At the end of the day "Send" shares a link through the
// phone's share sheet (KakaoTalk); the week's log rides along as a code and
// /match-log/import/ turns it into a summary plus Sheet-ready copy buttons.
//
// Nothing is sent anywhere: the log lives in this phone's localStorage, so a
// refresh or a dead screen doesn't lose it. One manager, one phone. The code
// lock (src/data/match-log.json) only keeps curious visitors out.
import BaseLayout from "../../layouts/BaseLayout.astro";
import T from "../../components/T.astro";
import profilesData from "../../data/player_profiles.json";
import matchesData from "../../data/matches.json";
import matchLog from "../../data/match-log.json";
import { currentLeague, getTeamColor } from "../../lib/leagues";
import { getContrastingTextColor, type PlayerProfile } from "../../lib/players";

const league = currentLeague;
const collator = new Intl.Collator("ko");
const teams = league.teams.map((team) => {
	const color = getTeamColor(team.team_id, league);
	const roster = (profilesData as PlayerProfile[])
		.filter((player) => player.status !== "inactive")
		.filter((player) => player.leagues.some((section) => section.league === league.id && section.current_team_id === team.team_id))
		.map((player) => player.name)
		.sort((a, b) => collator.compare(a, b));
	return { id: team.team_id, name: team.name, color, text: getContrastingTextColor(color), roster };
});

type Match = { match_id: string; league: string; week: number; round: number; home_team_id: string; away_team_id: string; status: string; date: string | null };
const matches = (matchesData as Match[])
	.filter((match) => match.league === league.id)
	.map(({ match_id, week, round, home_team_id, away_team_id, status, date }) => ({ id: match_id, week, round, home: home_team_id, away: away_team_id, status, date }))
	.sort((a, b) => a.id.localeCompare(b.id));

const data = {
	league: league.id,
	minutes: league.rules?.match_minutes ?? 12,
	codeHash: matchLog.code_sha256,
	teams,
	matches,
};
---

<BaseLayout title="Match Log | KICKS" description="KICKS staff: match-day goal log." noindex>
	<main class="ml">
		<script type="application/json" id="ml-data" set:html={JSON.stringify(data)} />

		<section id="ml-lock" class="ml-card ml-lock">
			<p class="ml-label"><T en="MANAGERS ONLY" ko="매니저 전용" /></p>
			<h1><T en="Match Log" ko="경기 기록" /></h1>
			<form id="ml-unlock">
				<input id="ml-code" type="password" autocomplete="off" placeholder="Code" data-i18n-attrs={JSON.stringify({ placeholder: { en: "Manager code", ko: "매니저 코드" } })} required />
				<button type="submit" class="ml-btn ml-btn--primary"><T en="Open" ko="열기" /></button>
			</form>
			<p id="ml-lock-error" class="ml-error" hidden><T en="Wrong code." ko="코드가 맞지 않아요." /></p>
		</section>

		<!-- Week: the nine matches of one week -->
		<section id="ml-week" hidden>
			<div class="ml-head">
				<div>
					<p class="ml-label">{league.id} · <T en="MATCH LOG" ko="경기 기록" /></p>
					<label class="ml-week-pick">
						<select id="ml-week-select" aria-label="Week"></select>
					</label>
				</div>
			</div>
			<ol id="ml-match-list" class="ml-list"></ol>

			<div class="ml-send">
				<button type="button" id="ml-send" class="ml-btn ml-btn--primary ml-btn--big"><T en="Send this week's log" ko="기록 보내기" /></button>
				<p class="ml-hint"><T en="Opens the share sheet — send it to the board on KakaoTalk." ko="공유창이 열리면 카톡으로 운영진에게 보내주세요." /></p>
				<p id="ml-send-status" class="ml-copied" role="status"></p>
			</div>
		</section>

		<!-- One match -->
		<section id="ml-match" hidden>
			<button type="button" id="ml-back" class="ml-btn ml-btn--ghost ml-back">← <T en="All matches" ko="경기 목록" /></button>
			<p id="ml-match-label" class="ml-label"></p>

			<div class="ml-scoreboard">
				<div class="ml-side" id="ml-side-home"><span class="ml-team-name"></span><strong class="ml-score">0</strong></div>
				<div class="ml-vs">:</div>
				<div class="ml-side" id="ml-side-away"><span class="ml-team-name"></span><strong class="ml-score">0</strong></div>
			</div>

			<div class="ml-clock-wrap">
				<p id="ml-clock" class="ml-clock">00:00</p>
				<p id="ml-clock-note" class="ml-hint"></p>
				<div class="ml-controls">
					<button type="button" id="ml-kickoff" class="ml-btn ml-btn--primary ml-btn--big"><T en="Kick-off" ko="킥오프" /></button>
					<button type="button" id="ml-pause" class="ml-btn ml-btn--ghost"><T en="Pause" ko="일시정지" /></button>
					<button type="button" id="ml-resume" class="ml-btn ml-btn--primary"><T en="Resume" ko="재개" /></button>
					<button type="button" id="ml-end" class="ml-btn ml-btn--ghost"><T en="End match" ko="경기 종료" /></button>
					<button type="button" id="ml-reopen" class="ml-btn ml-btn--ghost"><T en="Reopen" ko="다시 열기" /></button>
				</div>
			</div>

			<div class="ml-goal-buttons">
				<button type="button" class="ml-goal-btn" id="ml-goal-home"></button>
				<button type="button" class="ml-goal-btn" id="ml-goal-away"></button>
			</div>

			<ol id="ml-goals" class="ml-goals"></ol>
		</section>

		<!-- Goal picker -->
		<dialog id="ml-picker" aria-labelledby="ml-picker-title">
			<div class="ml-picker">
				<p id="ml-picker-minute" class="ml-label"></p>
				<h2 id="ml-picker-title"></h2>
				<div id="ml-picker-grid" class="ml-grid"></div>
				<div class="ml-picker-foot">
					<button type="button" id="ml-picker-og" class="ml-btn ml-btn--ghost"></button>
					<button type="button" id="ml-picker-cancel" class="ml-btn ml-btn--ghost"><T en="Cancel" ko="취소" /></button>
				</div>
			</div>
		</dialog>
	</main>
</BaseLayout>

<script>
	type Team = { id: string; name: string; color: string; text: string; roster: string[] };
	type Match = { id: string; week: number; round: number; home: string; away: string; status: string; date: string | null };
	type Goal = { id: string; team: string; scorer: string; assist: string | null; own: boolean; minute: number };
	type MatchLog = { state: "idle" | "live" | "paused" | "done"; startedAt: number | null; pausedAt: number | null; pausedMs: number; goals: Goal[]; buzzed?: boolean };
	type Store = { week: number | null; matches: Record<string, MatchLog> };
	type Data = { league: string; minutes: number; codeHash: string; teams: Team[]; matches: Match[] };

	const data = JSON.parse(document.getElementById("ml-data")!.textContent!) as Data;
	const $ = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T;
	const ko = () => document.documentElement.lang === "ko";
	const L = (en: string, kr: string) => (ko() ? kr : en);
	const teamById = (id: string) => data.teams.find((team) => team.id === id)!;
	const STORE_KEY = `kicks-match-log-v1:${data.league}`;
	const UNLOCK_KEY = "kicks-match-log-unlocked";

	// ---------- storage (localStorage, so a refresh or dead screen loses nothing)
	const load = (): Store => {
		try {
			const saved = JSON.parse(localStorage.getItem(STORE_KEY) ?? "null");
			if (saved && typeof saved === "object" && saved.matches) return saved as Store;
		} catch { /* fall through */ }
		return { week: null, matches: {} };
	};
	let store = load();
	const save = () => { try { localStorage.setItem(STORE_KEY, JSON.stringify(store)); } catch { /* still works for this page load */ } };
	const logOf = (id: string): MatchLog => (store.matches[id] ??= { state: "idle", startedAt: null, pausedAt: null, pausedMs: 0, goals: [] });

	// ---------- clock
	const elapsedMs = (log: MatchLog) => {
		if (!log.startedAt) return 0;
		const end = log.state === "paused" || log.state === "done" ? (log.pausedAt ?? Date.now()) : Date.now();
		return Math.max(0, end - log.startedAt - log.pausedMs);
	};
	/** Elapsed minute, rounded up (5:30 → 6), kept within 1..match length. */
	const minuteOf = (log: MatchLog) => Math.min(data.minutes, Math.max(1, Math.ceil(elapsedMs(log) / 60000)));
	const mmss = (ms: number) => {
		const s = Math.floor(ms / 1000);
		return `${String(Math.floor(s / 60)).padStart(2, "0")}:${String(s % 60).padStart(2, "0")}`;
	};
	const score = (match: Match) => {
		const goals = logOf(match.id).goals;
		return [goals.filter((g) => g.team === match.home).length, goals.filter((g) => g.team === match.away).length] as const;
	};

	// ---------- lock
	const sha256 = async (text: string) =>
		[...new Uint8Array(await crypto.subtle.digest("SHA-256", new TextEncoder().encode(text)))].map((b) => b.toString(16).padStart(2, "0")).join("");
	const unlocked = () => { try { return localStorage.getItem(UNLOCK_KEY) === data.codeHash; } catch { return false; } };
	$("ml-unlock").addEventListener("submit", async (event) => {
		event.preventDefault();
		const hash = await sha256(($("ml-code") as HTMLInputElement).value.trim());
		if (hash !== data.codeHash) { $("ml-lock-error").hidden = false; return; }
		try { localStorage.setItem(UNLOCK_KEY, hash); } catch { /* fine */ }
		start();
	});

	// ---------- week view
	const weeks = [...new Set(data.matches.map((m) => m.week))].sort((a, b) => a - b);
	const defaultWeek = () => weeks.find((w) => data.matches.some((m) => m.week === w && m.status !== "completed")) ?? weeks[weeks.length - 1];
	let currentMatchId: string | null = null;

	const stateLabel = (log: MatchLog) =>
		({ idle: L("Not started", "시작 전"), live: L("Live", "진행 중"), paused: L("Paused", "일시정지"), done: L("Done", "종료") })[log.state];

	function renderWeek() {
		const select = $<HTMLSelectElement>("ml-week-select");
		select.innerHTML = weeks.map((w) => `<option value="${w}">${L(`Week ${w}`, `${w}주차`)}${data.matches.find((m) => m.week === w)?.date ? ` · ${data.matches.find((m) => m.week === w)!.date}` : ""}</option>`).join("");
		select.value = String(store.week);
		const list = $("ml-match-list");
		list.innerHTML = "";
		for (const match of data.matches.filter((m) => m.week === store.week)) {
			const log = logOf(match.id);
			const [h, a] = score(match);
			const home = teamById(match.home), away = teamById(match.away);
			const li = document.createElement("li");
			li.innerHTML = `<button type="button" class="ml-match-row ml-state-${log.state}">
				<span class="ml-match-no">${match.id.slice(-3)}</span>
				<span class="ml-match-teams"><i style="background:${home.color}"></i>${home.name} <b>${log.state === "idle" ? "vs" : `${h} : ${a}`}</b> ${away.name}<i style="background:${away.color}"></i></span>
				<span class="ml-chip">${stateLabel(log)}</span></button>`;
			li.querySelector("button")!.addEventListener("click", () => openMatch(match.id));
			list.append(li);
		}
	}
	$("ml-week-select").addEventListener("change", (event) => {
		store.week = Number((event.target as HTMLSelectElement).value);
		save();
		renderWeek();
	});

	// ---------- send (share sheet → KakaoTalk)
	// The whole week travels inside the link (?d=…). Compact v2 form, decoded by
	// /match-log/import/: [league, week, [[home, away, ended, [[side 0/1, scorer, assist, own 0/1, minute], …]], …]]
	// with matches in M01… order.
	function weekLink() {
		const weekMatches = data.matches.filter((m) => m.week === store.week);
		const payload = [
			2,
			data.league,
			store.week,
			weekMatches.map((match) => {
				const log = logOf(match.id);
				return [
					match.home,
					match.away,
					log.state === "done" ? 1 : 0,
					[...log.goals].sort((x, y) => x.minute - y.minute).map((g) => [g.team === match.home ? 0 : 1, g.scorer, g.assist ?? "", g.own ? 1 : 0, g.minute]),
				];
			}),
		] as const;
		const bytes = new TextEncoder().encode(JSON.stringify(payload));
		const b64 = btoa(String.fromCharCode(...bytes)).replace(/\+/g, "-").replace(/\//g, "_").replace(/=+$/, "");
		const done = payload[3].filter((m) => m[2]).length;
		const goals = payload[3].reduce((n, m) => n + m[3].length, 0);
		return {
			url: `${location.origin}/match-log/import/?d=${b64}`,
			title: `KICKS ${data.league} ${store.week}주차 경기 기록 (종료 ${done}/${payload[3].length}경기 · ${goals}골)`,
		};
	}

	$("ml-send").addEventListener("click", async () => {
		// KakaoTalk only links the first ~80 characters, so on the receiving end
		// open the message in full view, copy the whole URL and paste it into a
		// browser (or paste the message on /match-log/import/).
		const { url, title } = weekLink();
		const text = `${title}\n${url}`;
		const status = $("ml-send-status");
		try {
			if (navigator.share) {
				await navigator.share({ text });
				status.textContent = "";
				return;
			}
		} catch (error) {
			if ((error as Error).name === "AbortError") return;
		}
		try {
			await navigator.clipboard.writeText(text);
			status.textContent = L("Copied — paste it into KakaoTalk.", "복사됐어요. 카톡에 붙여넣기 해서 보내주세요.");
		} catch {
			status.textContent = L("Couldn't share or copy on this phone.", "이 휴대폰에서는 공유·복사가 안 돼요.");
		}
	});

	// ---------- match view
	function openMatch(id: string) {
		currentMatchId = id;
		$("ml-week").hidden = true;
		$("ml-match").hidden = false;
		window.scrollTo({ top: 0 });
		renderMatch();
	}
	$("ml-back").addEventListener("click", () => {
		currentMatchId = null;
		$("ml-match").hidden = true;
		$("ml-week").hidden = false;
		renderWeek();
	});

	const currentMatch = () => data.matches.find((m) => m.id === currentMatchId)!;

	function renderMatch() {
		const match = currentMatch();
		const log = logOf(match.id);
		const home = teamById(match.home), away = teamById(match.away);
		const [h, a] = score(match);
		$("ml-match-label").textContent = `${L(`Week ${match.week}`, `${match.week}주차`)} · ${match.id.slice(-3)} · ${L(`Round ${match.round}`, `${match.round}라운드`)}`;
		for (const [side, team, value] of [["ml-side-home", home, h], ["ml-side-away", away, a]] as const) {
			const el = $(side);
			el.style.setProperty("--team", team.color);
			el.querySelector(".ml-team-name")!.textContent = team.name;
			el.querySelector(".ml-score")!.textContent = String(value);
		}
		for (const [id, team] of [["ml-goal-home", home], ["ml-goal-away", away]] as const) {
			const button = $<HTMLButtonElement>(id);
			button.textContent = `⚽ ${team.name} ${L("goal", "골")}`;
			button.style.background = team.color;
			button.style.color = team.text;
			button.disabled = log.state === "idle" || log.state === "done";
		}
		$("ml-kickoff").hidden = log.state !== "idle";
		$("ml-pause").hidden = log.state !== "live";
		$("ml-resume").hidden = log.state !== "paused";
		$("ml-end").hidden = log.state !== "live" && log.state !== "paused";
		$("ml-reopen").hidden = log.state !== "done";
		$("ml-clock-note").textContent =
			log.state === "idle" ? L("Press Kick-off when the match starts. Goal minutes come from this clock.", "경기가 시작되면 킥오프를 누르세요. 골 시간은 이 시계로 자동 기록돼요.")
			: log.state === "done" ? L("Match ended.", "경기가 끝났어요.")
			: log.state === "paused" ? L("Paused.", "일시정지됨") : "";
		renderClock();

		const list = $("ml-goals");
		list.innerHTML = "";
		for (const g of [...log.goals].sort((x, y) => x.minute - y.minute)) {
			const team = teamById(g.team);
			const li = document.createElement("li");
			li.className = "ml-goal";
			li.style.setProperty("--team", team.color);
			li.innerHTML = `<span class="ml-goal-min">${g.minute}'</span>
				<span class="ml-goal-who"><b>${g.scorer}</b>${g.own ? ` <em>${L("(own goal)", "(자책골)")}</em>` : ""}${g.assist ? `<small>${L("assist", "어시")} ${g.assist}</small>` : ""}</span>
				<span class="ml-goal-tools">
					<button type="button" data-act="minus" aria-label="-1 min">−</button>
					<button type="button" data-act="plus" aria-label="+1 min">+</button>
					<button type="button" data-act="del" class="ml-del">${L("Delete", "삭제")}</button>
				</span>`;
			li.querySelectorAll<HTMLButtonElement>("button").forEach((button) =>
				button.addEventListener("click", () => {
					const act = button.dataset.act;
					if (act === "minus") g.minute = Math.max(1, g.minute - 1);
					if (act === "plus") g.minute = Math.min(data.minutes, g.minute + 1);
					if (act === "del") {
						if (button.dataset.armed !== "1") {
							button.dataset.armed = "1";
							button.textContent = L("Sure?", "정말?");
							setTimeout(() => { button.dataset.armed = ""; button.textContent = L("Delete", "삭제"); }, 2500);
							return;
						}
						log.goals = log.goals.filter((x) => x.id !== g.id);
					}
					save();
					renderMatch();
				}),
			);
			list.append(li);
		}
		if (!log.goals.length) list.innerHTML = `<li class="ml-hint">${L("No goals yet.", "아직 골이 없어요.")}</li>`;
	}

	function renderClock() {
		if (!currentMatchId) return;
		const log = logOf(currentMatchId);
		const ms = elapsedMs(log);
		const clock = $("ml-clock");
		clock.textContent = mmss(ms);
		clock.classList.toggle("ml-clock--over", ms >= data.minutes * 60000);
		clock.classList.toggle("ml-clock--live", log.state === "live");
		// Full time: buzz once (Android; iPhones don't allow vibration from a website).
		if (log.state === "live" && ms >= data.minutes * 60000 && !log.buzzed) {
			log.buzzed = true;
			save();
			try { navigator.vibrate?.([400, 200, 400]); } catch { /* not supported */ }
		}
	}
	setInterval(renderClock, 500);

	const nextMatch = () => {
		const match = currentMatch();
		const same = data.matches.filter((m) => m.week === match.week);
		return same[same.findIndex((m) => m.id === match.id) + 1] ?? null;
	};

	$("ml-kickoff").addEventListener("click", () => {
		const log = logOf(currentMatchId!);
		Object.assign(log, { state: "live", startedAt: Date.now(), pausedAt: null, pausedMs: 0 });
		save();
		renderMatch();
	});
	$("ml-pause").addEventListener("click", () => {
		const log = logOf(currentMatchId!);
		Object.assign(log, { state: "paused", pausedAt: Date.now() });
		save();
		renderMatch();
	});
	$("ml-resume").addEventListener("click", () => {
		const log = logOf(currentMatchId!);
		log.pausedMs += Date.now() - (log.pausedAt ?? Date.now());
		Object.assign(log, { state: "live", pausedAt: null });
		save();
		renderMatch();
	});
	$("ml-end").addEventListener("click", () => {
		const log = logOf(currentMatchId!);
		if (log.state === "live") log.pausedAt = Date.now();
		log.state = "done";
		save();
		// Straight on to the next match (ready for Kick-off); after the last one, back to the list.
		const next = nextMatch();
		if (next) openMatch(next.id);
		else $("ml-back").click();
	});
	$("ml-reopen").addEventListener("click", () => {
		const log = logOf(currentMatchId!);
		log.state = "paused";
		save();
		renderMatch();
	});

	// ---------- goal picker: team → scorer (or own goal by an opponent) → assist
	const picker = $<HTMLDialogElement>("ml-picker");
	let pick: { team: string; minute: number; own: boolean; scorer: string | null } | null = null;

	function openPicker(teamId: string) {
		const log = logOf(currentMatchId!);
		// The minute is fixed the moment the goal button is tapped.
		pick = { team: teamId, minute: minuteOf(log), own: false, scorer: null };
		renderPicker();
		picker.showModal();
	}
	$("ml-goal-home").addEventListener("click", () => openPicker(currentMatch().home));
	$("ml-goal-away").addEventListener("click", () => openPicker(currentMatch().away));

	function renderPicker() {
		if (!pick) return;
		const match = currentMatch();
		const team = teamById(pick.team);
		const opponent = teamById(pick.team === match.home ? match.away : match.home);
		$("ml-picker-minute").textContent = `${team.name} · ${pick.minute}${L("'", "분")}`;
		const grid = $("ml-picker-grid");
		grid.innerHTML = "";
		const og = $("ml-picker-og");
		const add = (label: string, onClick: () => void, cls = "") => {
			const button = document.createElement("button");
			button.type = "button";
			button.className = `ml-pick ${cls}`;
			button.textContent = label;
			button.addEventListener("click", onClick);
			grid.append(button);
		};
		if (!pick.scorer) {
			$("ml-picker-title").textContent = pick.own ? L(`Own goal — which ${opponent.name} player?`, `자책골 — ${opponent.name}의 누가?`) : L("Who scored?", "누가 넣었나요?");
			const roster = pick.own ? opponent.roster : team.roster;
			for (const name of roster) add(name, () => { pick!.scorer = name; if (pick!.own) finish(null); else renderPicker(); });
			og.hidden = false;
			og.textContent = pick.own ? L("← Back to scorers", "← 득점자 목록으로") : L("Own goal", "자책골");
		} else {
			$("ml-picker-title").textContent = L(`Assist for ${pick.scorer}?`, `${pick.scorer} 골, 어시스트는?`);
			add(L("No assist", "어시 없음"), () => finish(null), "ml-pick--none");
			for (const name of team.roster.filter((n) => n !== pick!.scorer)) add(name, () => finish(name));
			og.hidden = false;
			og.textContent = L("← Change scorer", "← 득점자 다시 고르기");
		}
	}
	$("ml-picker-og").addEventListener("click", () => {
		if (!pick) return;
		if (pick.scorer) pick.scorer = null;
		else pick.own = !pick.own;
		renderPicker();
	});
	$("ml-picker-cancel").addEventListener("click", () => { pick = null; picker.close(); });
	picker.addEventListener("cancel", () => { pick = null; });

	function finish(assist: string | null) {
		if (!pick || !pick.scorer) return;
		const log = logOf(currentMatchId!);
		log.goals.push({ id: `${Date.now()}-${Math.random().toString(36).slice(2, 7)}`, team: pick.team, scorer: pick.scorer, assist, own: pick.own, minute: pick.minute });
		save();
		pick = null;
		picker.close();
		renderMatch();
	}

	// ---------- start
	function start() {
		$("ml-lock").hidden = true;
		$("ml-week").hidden = false;
		if (store.week === null || !weeks.includes(store.week)) store.week = defaultWeek();
		save();
		renderWeek();
	}
	if (unlocked()) start();
	// Re-render text when the site's language toggle flips <html lang>.
	new MutationObserver(() => { if (currentMatchId) renderMatch(); else if (!$("ml-week").hidden) renderWeek(); }).observe(document.documentElement, { attributes: true, attributeFilter: ["lang"] });
</script>

