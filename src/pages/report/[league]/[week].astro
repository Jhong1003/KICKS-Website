---
// The weekly league report as Instagram-sized cards (1080x1350), one slide per
// panel, built from the same generated JSON as the site. Staff open the page
// and screenshot each card — nothing is retyped from the Sheet into a design
// tool, so a week's post can't disagree with the league table.
//
// Not in the menu and kept out of the sitemap/robots: it's a tool, not a page
// for visitors.
//
// The look is dark and editorial rather than a white card on a grass photo:
// the three team colours (red / gold / blue) are the only colour on the slide,
// so they carry the identity and nothing has to be art-directed per week. The
// first version put a white panel on a drawn pitch and read as a web table
// screenshotted — the dark field lets the team colours and the numbers be the
// whole design.
import leaguesData from "../../../data/leagues.json";
import matchesData from "../../../data/matches.json";
import leagueTableData from "../../../data/league_table.json";
import leaderboardData from "../../../data/player_leaderboard.json";
import profilesData from "../../../data/player_profiles.json";
import goalEventsData from "../../../data/goal_events.json";
import { minuteCounts, topBy } from "../../../lib/weekly-report";
import { formatShortDate } from "../../../lib/i18n";

export function getStaticPaths() {
	const played = new Set(
		(matchesData as { league: string; week: number; status: string }[])
			.filter((m) => m.status === "completed")
			.map((m) => `${m.league}|${m.week}`),
	);
	return [...played].map((key) => {
		const [league, week] = key.split("|");
		return { params: { league, week } };
	});
}

const { league: leagueId, week: weekParam } = Astro.params;
const week = Number(weekParam);
const league = (leaguesData as any[]).find((l) => l.id === leagueId)!;
const teams = new Map<string, { name: string; color: string }>(
	league.teams.map((t: any) => [t.team_id, { name: t.name, color: t.color }]),
);
const team = (id: string | null) => teams.get(id ?? "") ?? { name: "TBD", color: "#8a8a8a" };
const names = new Map(profilesData.map((p: any) => [p.player_id, p.name]));
const palette = league.teams.map((t: any) => t.color);

const weekMatches = (matchesData as any[])
	.filter((m) => m.league === leagueId && m.week === week && m.status === "completed")
	.sort((a, b) => String(a.match_id).localeCompare(String(b.match_id)));
const date = weekMatches[0]?.date ?? "";
const rounds = [...new Set(weekMatches.map((m) => m.round))].sort((a, b) => a - b);

const events = (goalEventsData as any[]).filter((g) => g.league === leagueId && g.week === week);

// The table is the league's standing *after* this week, which is what
// league_table.json holds for the latest week. Earlier weeks would need
// standings_history, so the slide only claims "as of" the newest week.
const table = (leagueTableData as any[])
	.filter((r) => r.league === leagueId)
	.map((r, index) => ({ ...r, rank: index + 1, ...team(r.team_id) }));

const board = (leaderboardData as any[])
	.filter((r) => r.league === leagueId)
	.map((r) => ({ name: names.get(r.player_id) ?? "", color: team(r.team_id).color, goals: r.goals, assists: r.assists }));
const charts = [
	{ title: "GOALS", rows: topBy(board.map((r) => ({ ...r, value: r.goals }))) },
	{ title: "ASSISTS", rows: topBy(board.map((r) => ({ ...r, value: r.assists }))) },
	{ title: "G + A", rows: topBy(board.map((r) => ({ ...r, value: r.goals + r.assists }))) },
];

const matchMinutes = league.rules.match_minutes ?? 12;
const timed = events
	.filter((g) => g.minute !== null)
	.map((g) => ({ minute: g.minute as number, color: team(g.team_id).color }));
const clock = minuteCounts(timed, matchMinutes);
const peak = Math.max(1, ...clock.map((slot) => slot.goals.length));
const winners = events
	.filter((g) => g.roles?.includes("winner"))
	.sort((a, b) => (a.minute ?? 0) - (b.minute ?? 0))
	.map((g) => ({ name: names.get(g.scorer_id) ?? "", minute: g.minute, color: team(g.team_id).color }));

const dateLabel = date ? formatShortDate(date, "en").toUpperCase() : "";
const weekNo = String(week).padStart(2, "0");
const kicker = `${leagueId} · WEEK ${weekNo}`;
// One block per goal, so a 3-goal minute is three stacked team colours rather
// than a taller anonymous bar. The tallest minute fills the chart.
const BLOCK_GAP = 8;
const blockHeight = (360 - (peak - 1) * BLOCK_GAP) / peak;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="robots" content="noindex, nofollow" />
		<title>{leagueId} Week {weekNo} · Report cards</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700&family=Archivo+Black&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body>
		<p class="hint">
			Screenshot each card at 1080 × 1350. Zoom is display only — the cards are full size underneath.
		</p>

		<div class="cards">
			{/* 1 · Cover */}
			<section class="card cover">
				<img class="logo" src="/kicks-logo-white.jpg" alt="" />
				<p class="eyebrow">KICKS {leagueId}</p>
				<p class="huge">WEEK</p>
				<p class="huge outline">{weekNo}</p>
				<div class="rule big">{palette.map((color: string) => <span style={`background:${color}`} />)}</div>
				<p class="cover-sub">STATS &amp; RESULTS</p>
				<p class="foot"><span>{dateLabel}</span><span>KICKSUIUC.COM</span></p>
			</section>

			{/* 2 · Match results */}
			<section class="card">
				<img class="logo" src="/kicks-logo-white.jpg" alt="" />
				<p class="eyebrow">{kicker}</p>
				<h1>MATCH<br />RESULTS</h1>
				<div class="rule">{palette.map((color: string) => <span style={`background:${color}`} />)}</div>
				<div class="body">
					{rounds.map((round) => (
						<div class="round">
							<p class="round-label"><span>ROUND {round}</span></p>
							{weekMatches
								.filter((m) => m.round === round)
								.map((m) => {
									const home = team(m.home_team_id);
									const away = team(m.away_team_id);
									const homeWon = m.home_score > m.away_score;
									const awayWon = m.away_score > m.home_score;
									return (
										<div class="fixture">
											<span class={`side home${awayWon ? " beaten" : ""}`}>
												<b>{home.name}</b>
												<span class="chip" style={`background:${home.color}`} />
											</span>
											<span class="score">{m.home_score}<i>:</i>{m.away_score}</span>
											<span class={`side away${homeWon ? " beaten" : ""}`}>
												<span class="chip" style={`background:${away.color}`} />
												<b>{away.name}</b>
											</span>
										</div>
									);
								})}
						</div>
					))}
				</div>
				<p class="foot"><span>{dateLabel}</span><span>KICKSUIUC.COM</span></p>
			</section>

			{/* 3 · League table */}
			<section class="card">
				<img class="logo" src="/kicks-logo-white.jpg" alt="" />
				<p class="eyebrow">{kicker}</p>
				<h1>LEAGUE<br />TABLE</h1>
				<div class="rule">{palette.map((color: string) => <span style={`background:${color}`} />)}</div>
				<div class="body">
					{table.map((r) => (
						{/* A faint slab the full width of the row, with the team's colour
						    washed over its left half — so the row reads as one band and
						    the points at the far end still sit inside it. */}
						<div
							class="standing"
							style={`--team:${r.color}; background:linear-gradient(90deg, ${r.color}3d, ${r.color}14 56%, ${r.color}00 100%), rgba(255, 255, 255, 0.05)`}
						>
							<span class="place">{String(r.rank).padStart(2, "0")}</span>
							<span class="who">
								<b>{r.name}</b>
								<i>
									<em>{r.played}</em> PLAYED<span class="dot" />
									<em>{r.wins}</em> W<span class="dot" /><em>{r.draws}</em> D<span class="dot" /><em>{r.losses}</em> L
								</i>
							</span>
							<span class="tally"><b>{r.points}</b><i>PTS</i></span>
						</div>
					))}
				</div>
				<p class="foot"><span>{dateLabel}</span><span>KICKSUIUC.COM</span></p>
			</section>

			{/* 4 · Player stats */}
			<section class="card">
				<img class="logo" src="/kicks-logo-white.jpg" alt="" />
				<p class="eyebrow">{kicker}</p>
				<h1>PLAYER<br />STATS</h1>
				<div class="rule">{palette.map((color: string) => <span style={`background:${color}`} />)}</div>
				<div class="body charts">
					{charts.map((chart) => (
						<div class="chart">
							<p class="chart-title">{chart.title}</p>
							{chart.rows.map((row, index) => (
								<div class={`entry${index === 0 ? " lead" : ""}`} style={`--team:${row.color}`}>
									<span class="pos">{String(row.rank).padStart(2, "0")}</span>
									<b>{row.name}</b>
									<span class="val">{row.value}</span>
								</div>
							))}
						</div>
					))}
				</div>
				<p class="foot"><span>{dateLabel}</span><span>KICKSUIUC.COM</span></p>
			</section>

			{/* 5 · Goal times (needs the minutes recorded from FA26-L2 on) */}
			{timed.length > 0 && (
				<section class="card">
					<img class="logo" src="/kicks-logo-white.jpg" alt="" />
					<p class="eyebrow">{kicker}</p>
					<h1>GOAL<br />TIMES</h1>
					<div class="rule">{palette.map((color: string) => <span style={`background:${color}`} />)}</div>
					<div class="body">
						<p class="chart-title spread">
							<span>WHEN THEY WENT IN</span>
							<span class="muted">{timed.length} GOALS · {matchMinutes}′ MATCHES</span>
						</p>
						<div class="clock">
							{clock.map((slot) => (
								<div class="minute">
									<span class="stack">
										{slot.goals.map((goal) => (
											<span class="block" style={`background:${goal.color}; height:${blockHeight}px`} />
										))}
									</span>
									<span class={`tick${slot.goals.length ? " hit" : ""}`}>{slot.minute}</span>
								</div>
							))}
						</div>
						<p class="chart-title spread wins"><span>WINNING GOALS</span></p>
						<div class="winners">
							{winners.map((w) => (
								<div class="entry" style={`--team:${w.color}`}>
									<b>{w.name}</b>
									<span class="val">{w.minute}′</span>
								</div>
							))}
						</div>
					</div>
					<p class="foot"><span>{dateLabel}</span><span>KICKSUIUC.COM</span></p>
				</section>
			)}
		</div>
	</body>
</html>

<style is:global>
	*, *::before, *::after { box-sizing: border-box; }
	body { margin: 0; background: #141414; font-family: "Archivo", system-ui, sans-serif; }
	.hint { color: #888; font-size: 13px; padding: 16px 20px 0; margin: 0; }
	.cards { display: flex; flex-wrap: wrap; gap: 24px; padding: 20px; }

	/* 1080x1350 exactly, scaled down only for looking at. Screenshot at 100%. */
	.card {
		position: relative;
		width: 1080px;
		height: 1350px;
		flex: 0 0 auto;
		display: flex;
		flex-direction: column;
		padding: 72px 76px 108px;
		color: #fff;
		overflow: hidden;
		transform: scale(0.42);
		transform-origin: top left;
		margin: 0 calc(-1080px * 0.58) calc(-1350px * 0.58) 0;
		/* Near-black with a green cast, lit from the top left. Dark enough that
		   the team colours are the only thing on the slide that reads as colour. */
		background:
			radial-gradient(118% 82% at 16% -6%, #1d3324 0%, #101712 46%, #080b09 100%);
	}
	/* A faint diagonal weave, so the field isn't a flat fill in a screenshot. */
	.card::before {
		content: "";
		position: absolute; inset: 0;
		background: repeating-linear-gradient(104deg, rgba(255, 255, 255, 0.028) 0 2px, transparent 2px 76px);
	}
	.card > * { position: relative; }

	.logo { position: absolute; top: 60px; right: 72px; height: 50px; width: auto; mix-blend-mode: screen; }

	/* Shared heading: a tracked kicker, a heavy two-line title, and the three
	   team colours as a rule. Every slide opens the same way. */
	.eyebrow { font-size: 22px; font-weight: 700; letter-spacing: 0.34em; margin: 0 0 22px; color: rgba(255, 255, 255, 0.5); }
	h1 { font-family: "Archivo Black", sans-serif; font-size: 98px; line-height: 0.94; letter-spacing: -0.035em; margin: 0; }
	.rule { display: flex; gap: 9px; margin: 34px 0 0; }
	.rule span { width: 76px; height: 9px; border-radius: 999px; }
	.rule.big span { width: 112px; height: 13px; }

	.body { flex: 1; display: flex; flex-direction: column; justify-content: center; min-height: 0; margin-top: 40px; }

	.foot {
		position: absolute; left: 76px; right: 76px; bottom: 54px;
		display: flex; justify-content: space-between;
		font-size: 18px; font-weight: 600; letter-spacing: 0.22em;
		color: rgba(255, 255, 255, 0.42); margin: 0;
	}

	/* 1 · Cover */
	.cover { justify-content: center; }
	.cover .eyebrow { margin-bottom: 30px; }
	.huge { font-family: "Archivo Black", sans-serif; font-size: 210px; line-height: 0.86; letter-spacing: -0.045em; margin: 0; }
	/* The week number is drawn as an outline, so the cover has one solid word
	   and one hollow one instead of two slabs of the same weight. */
	.outline { color: transparent; -webkit-text-stroke: 5px #fff; }
	.cover .rule { margin: 54px 0 34px; }
	.cover-sub { font-size: 34px; font-weight: 700; letter-spacing: 0.3em; margin: 0; color: rgba(255, 255, 255, 0.72); }

	/* 2 · Match results. Nine fixtures and three round labels is the most any
	   slide has to hold, so the spacing here is what the card can actually fit
	   — loosening it pushes the last round over the footer. */
	.round + .round { margin-top: 28px; }
	.round-label { display: flex; align-items: center; gap: 22px; margin: 0 0 4px; font-size: 19px; font-weight: 700; letter-spacing: 0.3em; color: rgba(255, 255, 255, 0.45); }
	.round-label::after { content: ""; flex: 1; height: 1px; background: rgba(255, 255, 255, 0.16); }
	.fixture { display: grid; grid-template-columns: 1fr 190px 1fr; align-items: center; padding: 13px 0; border-bottom: 1px solid rgba(255, 255, 255, 0.09); }
	.fixture:last-child { border-bottom: 0; }
	.side { display: flex; align-items: center; gap: 16px; font-size: 29px; font-weight: 600; }
	.side.home { justify-content: flex-end; }
	/* The beaten side drops back, so the week's results can be read at a glance
	   without the scores having to be compared one by one. */
	.side.beaten { color: rgba(255, 255, 255, 0.4); font-weight: 500; }
	.side.beaten .chip { opacity: 0.45; }
	.chip { width: 9px; height: 32px; border-radius: 999px; flex: 0 0 auto; }
	.score { font-family: "Archivo Black", sans-serif; font-size: 38px; text-align: center; letter-spacing: 0.02em; }
	.score i { font-style: normal; padding: 0 10px; color: rgba(255, 255, 255, 0.35); }

	/* 3 · League table */
	.standing {
		display: grid; grid-template-columns: 150px 1fr auto; align-items: center;
		border-left: 12px solid var(--team); border-radius: 0 10px 10px 0;
		padding: 46px 36px 46px 30px;
	}
	.standing + .standing { margin-top: 26px; }
	.place { font-family: "Archivo Black", sans-serif; font-size: 76px; line-height: 1; color: rgba(255, 255, 255, 0.28); }
	.who b { display: block; font-size: 52px; font-weight: 700; letter-spacing: -0.01em; }
	.who i { display: flex; align-items: center; gap: 7px; margin-top: 12px; font-style: normal; font-size: 19px; font-weight: 600; letter-spacing: 0.2em; color: rgba(255, 255, 255, 0.5); }
	.who em { font-style: normal; color: #fff; }
	.dot { width: 4px; height: 4px; border-radius: 50%; background: rgba(255, 255, 255, 0.3); margin: 0 9px; }
	.tally { text-align: right; }
	.tally b { display: block; font-family: "Archivo Black", sans-serif; font-size: 82px; line-height: 0.9; }
	.tally i { font-style: normal; font-size: 17px; font-weight: 700; letter-spacing: 0.28em; color: rgba(255, 255, 255, 0.5); }

	/* 4 · Player stats */
	.charts { display: grid; grid-template-columns: repeat(3, 1fr); gap: 46px; align-content: center; }
	.chart-title { margin: 0 0 20px; font-size: 21px; font-weight: 700; letter-spacing: 0.26em; padding-bottom: 16px; border-bottom: 2px solid rgba(255, 255, 255, 0.22); }
	.chart-title.spread { display: flex; justify-content: space-between; align-items: baseline; gap: 20px; }
	.chart-title .muted { font-size: 17px; letter-spacing: 0.18em; color: rgba(255, 255, 255, 0.45); }
	.entry { display: flex; align-items: center; gap: 14px; padding: 17px 0; border-bottom: 1px solid rgba(255, 255, 255, 0.08); font-size: 27px; }
	.entry:last-child { border-bottom: 0; }
	.entry b { flex: 1; font-weight: 600; min-width: 0; }
	/* The leader of each chart carries their team's colour; the rest stay white
	   so the slide has three accents rather than twenty-one. */
	.entry.lead { font-size: 34px; padding: 20px 0 22px; }
	.entry.lead b { color: var(--team); font-weight: 700; }
	.entry.lead .val { font-family: "Archivo Black", sans-serif; font-size: 44px; color: var(--team); }
	.pos { font-size: 19px; font-weight: 700; color: rgba(255, 255, 255, 0.38); }
	.entry.lead .pos { color: var(--team); }
	.val { font-weight: 700; font-variant-numeric: tabular-nums; }

	/* 5 · Goal times */
	.clock { display: flex; align-items: flex-end; gap: 12px; margin: 8px 0 56px; }
	.minute { flex: 1; display: flex; flex-direction: column; align-items: stretch; gap: 14px; }
	.stack { display: flex; flex-direction: column-reverse; justify-content: flex-start; gap: 8px; min-height: 10px; }
	.block { border-radius: 5px; }
	.tick { text-align: center; font-size: 19px; font-weight: 600; color: rgba(255, 255, 255, 0.3); }
	.tick.hit { color: rgba(255, 255, 255, 0.75); }
	.wins { margin-top: 0; }
	.winners { display: grid; grid-template-columns: repeat(2, 1fr); gap: 0 56px; }
	.winners .entry { font-size: 30px; padding: 20px 0; border-bottom: 0; border-top: 1px solid rgba(255, 255, 255, 0.08); }
	/* The two columns rarely hold the same number of names, so the rules go
	   above each row — an odd count then can't leave one hanging below. */
	.winners .entry:nth-child(-n+2) { border-top: 0; }
	.winners .entry b { padding-left: 20px; border-left: 7px solid var(--team); }
	.winners .val { font-family: "Archivo Black", sans-serif; font-size: 32px; }
</style>
