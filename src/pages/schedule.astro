---
import BaseLayout from "../layouts/BaseLayout.astro";
import ScheduleTimeline from "../components/ScheduleTimeline.astro";
import { buildScheduleView, groupByMonth, type ScheduleEvent } from "../lib/schedule";
import scheduleData from "../data/schedule.json";

const events = scheduleData as ScheduleEvent[];
const groups = groupByMonth(buildScheduleView(events));
---

<BaseLayout title="Schedule | KICKS" description="KICKS FA26 season schedule: league days, events, friendlies, and the awards ceremony.">
	<main>
		<section class="content-section" aria-labelledby="schedule-title">
			<p class="section-label">FA26 SEASON</p>
			<h1 id="schedule-title">Schedule</h1>
			<p class="about-description">Every league day, event, friendly, and ceremony this season.</p>
			<ScheduleTimeline groups={groups} />
		</section>
	</main>
</BaseLayout>
