---
import BaseLayout from "../layouts/BaseLayout.astro";
import { pageOgImage } from "../lib/og";
import ScheduleCalendar from "../components/ScheduleCalendar.astro";
import SeasonSelect from "../components/SeasonSelect.astro";
import T from "../components/T.astro";
import type { ScheduleEvent } from "../lib/schedule";
import scheduleData from "../data/schedule.json";
import { currentSeason } from "../lib/leagues";

const events = scheduleData as ScheduleEvent[];
---

<BaseLayout ogImage={pageOgImage("schedule")} title="Schedule | KICKS" description={`KICKS ${currentSeason} season schedule: league days, events, friendlies, and the awards ceremony.`}>
	<main class="k-page">
		<div class="k-page-head">
			<h1 class="k-h1"><T en="Schedule" ko="일정" /></h1>
			<SeasonSelect />
		</div>
		<ScheduleCalendar events={events} />
	</main>
</BaseLayout>
