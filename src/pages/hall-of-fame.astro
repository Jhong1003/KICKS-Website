---
// Hall of Fame: every finished league's champion and awards (newest first),
// then the club's all-time records. Grows by itself as leagues finish.
import BaseLayout from "../layouts/BaseLayout.astro";
import ClubRecords from "../components/ClubRecords.astro";
import LeagueHonours from "../components/LeagueHonours.astro";
import T from "../components/T.astro";
import { isLeagueFinished } from "../lib/finale";
import { leagues } from "../lib/leagues";
import AwardCard from "../components/AwardCard.astro";
import { AWARDS, manualAwards, seasonsWithAwards } from "../lib/awards";

const finishedLeagues = leagues.filter((league) => isLeagueFinished(league.id)).reverse();
// Season awards (Ballon d'Or, Puskás) from src/data/awards.json, newest season first.
const seasonOrder = [...new Set(leagues.map((league) => league.id.split("-")[0]))];
const seasons = seasonsWithAwards(seasonOrder).map((season) => ({ season, awards: manualAwards(season) }));
---

<BaseLayout title="Hall of Fame | KICKS" description="KICKS league champions, award winners, and club records.">
	<main class="hall-of-fame">
		<section class="content-section hall-of-fame-intro" aria-labelledby="hall-of-fame-title">
			<p class="section-label"><T en="HALL OF FAME" ko="명예의 전당" /></p>
			<h1 id="hall-of-fame-title"><T en="Hall of Fame" ko="명예의 전당" /></h1>
			<T
				as="p"
				class="about-description"
				en="Explore past champions, award winners, and all-time KICKS records."
				ko="역대 우승팀과 수상자, KICKS의 최고 기록을 한곳에서 만나보세요."
			/>
			{
				finishedLeagues.length === 0 && seasons.length === 0 && (
					<T
						as="p"
						class="about-description"
						en="Honours appear here once the first league is finished."
						ko="첫 리그가 끝나면 이곳에 수상 기록이 나타나요."
					/>
				)
			}
		</section>

		{
			seasons.map(({ season, awards }) => (
				<section class="content-section honours" aria-labelledby={`season-honours-${season}`}>
					<p class="section-label"><T en="SEASON AWARDS" ko="시즌 시상" /></p>
					<h2 id={`season-honours-${season}`}>{season}</h2>
					<div class="honours-grid">
						{awards.map((entry) => (
							<AwardCard
								icon={AWARDS[entry.key].icon}
								en={AWARDS[entry.key].en}
								ko={AWARDS[entry.key].ko}
								winners={entry.winners}
								photo={entry.photo}
								detailEn={entry.note}
							/>
						))}
					</div>
				</section>
			))
		}

		{finishedLeagues.map((league) => <LeagueHonours league={league} />)}

		<ClubRecords />
	</main>
</BaseLayout>
