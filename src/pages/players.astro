---
import BaseLayout from "../layouts/BaseLayout.astro";
import PlayerCard from "../components/PlayerCard.astro";
import T from "../components/T.astro";
import profilesData from "../data/player_profiles.json";
import playerPhotosData from "../data/player-photos.json";
import leagueTable from "../data/league_table.json";
import { getSection, sortPlayers, type PlayerInLeague, type PlayerProfile } from "../lib/players";
import { isShownInLeague } from "../lib/finale";
import { currentLeague, leagues, latestLeague, getTeamColor, getTeamName, type League } from "../lib/leagues";

// Everyone in one league, by name: a plain roster, not a second set of team
// pages. Teams have their own pages (/league/<id>/team/<team_id>), linked
// from the "By team" chips at the top, so this page doesn't group by team.
// Never grouped or ordered by any stat (see AGENTS.md's "Player profiles").
// League buttons switch between leagues' rosters; the newest league that has
// any players opens first, even before its first game.
const playerPhotos = playerPhotosData as Record<string, string>;

function buildRoster(league: League) {
	const roster = (profilesData as PlayerProfile[]).flatMap((player): PlayerInLeague[] => {
		const section = getSection(player, league.id);
		return section && isShownInLeague(player, league.id) ? [{ player, section }] : [];
	});
	// Team chips in current standings order (league leader first); a league
	// with no results yet keeps its teams-tab order.
	const standingsOrder = leagueTable.filter((row) => row.league === league.id).map((row) => row.team_id);
	const teams = [...league.teams].sort((a, b) => {
		const rank = (id: string) => (standingsOrder.includes(id) ? standingsOrder.indexOf(id) : standingsOrder.length);
		return rank(a.team_id) - rank(b.team_id);
	});
	return { league, players: sortPlayers(roster, "name", league), teams };
}

const rosters = leagues.map(buildRoster).filter((entry) => entry.players.length > 0);
const defaultLeagueId = rosters.some((entry) => entry.league.id === currentLeague.id) ? currentLeague.id : (rosters[rosters.length - 1]?.league.id ?? latestLeague.id);
---

<BaseLayout
	title="Players | KICKS"
	description="Meet the KICKS roster — season stats, play styles, and achievement badges for every player."
>
	<main>
		<section class="content-section" aria-labelledby="players-title">
			{
				rosters.map(({ league }) => (
					<p class="section-label" data-league-label={league.id} hidden={league.id !== defaultLeagueId}>
						<T en={`${league.id} ROSTER`} ko={`${league.id} 선수단`} />
					</p>
				))
			}
			<div class="players-head">
				<h1 id="players-title"><T en="Players" ko="선수" /></h1>
				{
					rosters.length > 1 && (
						<div class="league-switcher players-league-switcher" role="group" aria-label="Choose a league">
							{rosters.map(({ league }) => (
								<button
									class="league-switcher-link"
									type="button"
									data-league-button={league.id}
									aria-pressed={league.id === defaultLeagueId ? "true" : "false"}
								>
									{league.id}
									{!league.started && (
										<span class="league-switcher-note">
											<T en="upcoming" ko="예정" />
										</span>
									)}
								</button>
							))}
						</div>
					)
				}
			</div>

			{
				rosters.map(({ league, players, teams }) => (
					<div class="player-league-panel" data-league-panel={league.id} hidden={league.id !== defaultLeagueId}>
						<nav class="players-teams" aria-label={`${league.id} teams`}>
							<span class="players-teams-label"><T en="By team →" ko="팀별로 보기 →" /></span>
							{teams.map((team) => (
								<a class="players-team-chip" href={`/league/${league.id}/team/${team.team_id}`}>
									<span class="player-group-dot" style={`background-color: ${getTeamColor(team.team_id, league)}`} aria-hidden="true" />
									{team.name}
								</a>
							))}
							<a class="dream-team-link players-dream-team" href="/dream-team">
								<span aria-hidden="true">⭐</span>
								<T en="Build My Dream Team" ko="나만의 드림팀 만들기" />
								<span aria-hidden="true">→</span>
							</a>
						</nav>

						<div class="player-grid">
							{players.map(({ player, section }) => (
								<PlayerCard
									player={player}
									section={section}
									teamName={getTeamName(section.current_team_id, league)}
									teamColor={getTeamColor(section.current_team_id, league)}
									href={`/players/${player.id}?league=${league.id}`}
									avatarPhoto={playerPhotos[player.id]}
								/>
							))}
						</div>
					</div>
				))
			}

		</section>
	</main>
</BaseLayout>

<script>
	// League switcher: every league's roster is pre-rendered, so switching is
	// just show/hide. ?league=<id> opens a specific league (and is kept in
	// the address bar so the page can be shared or reloaded as-is).
	const leagueButtons = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-league-button]"));
	const leaguePanels = Array.from(document.querySelectorAll<HTMLElement>("[data-league-panel]"));
	const leagueLabels = Array.from(document.querySelectorAll<HTMLElement>("[data-league-label]"));

	function showLeague(id: string, updateUrl: boolean) {
		if (!leaguePanels.some((panel) => panel.dataset.leaguePanel === id)) return;
		leagueButtons.forEach((button) => button.setAttribute("aria-pressed", String(button.dataset.leagueButton === id)));
		leaguePanels.forEach((panel) => {
			panel.hidden = panel.dataset.leaguePanel !== id;
		});
		leagueLabels.forEach((label) => {
			label.hidden = label.dataset.leagueLabel !== id;
		});
		if (updateUrl) {
			const url = new URL(window.location.href);
			url.searchParams.set("league", id);
			history.replaceState(null, "", url);
		}
	}

	leagueButtons.forEach((button) => {
		button.addEventListener("click", () => showLeague(button.dataset.leagueButton ?? "", true));
	});
	const requestedLeague = new URLSearchParams(window.location.search).get("league");
	if (requestedLeague) showLeague(requestedLeague, false);
</script>

<style>
	.players-head {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 12px 24px;
	}

	.players-league-switcher {
		margin: 0;
	}

	.players-teams {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 8px 10px;
		margin-top: 24px;
	}

	.players-teams-label {
		margin-right: 4px;
		font-size: 0.85rem;
		font-weight: 600;
		opacity: 0.7;
	}

	.players-team-chip {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		padding: 8px 16px;
		border: 1px solid var(--color-sage);
		border-radius: 999px;
		background-color: #fff;
		color: var(--color-dark);
		font-size: 0.9rem;
		font-weight: 600;
	}

	.players-team-chip:hover {
		border-color: var(--color-green);
	}

	/* Same row as the team chips, pushed to the right; wraps under them on phones. */
	.players-dream-team {
		margin: 0 0 0 auto;
	}

	@media (max-width: 700px) {
		.players-dream-team {
			margin: 4px 0 0;
		}
	}
</style>
