---
import BaseLayout from "../layouts/BaseLayout.astro";
import PlayerCard from "../components/PlayerCard.astro";
import T from "../components/T.astro";
import profilesData from "../data/player_profiles.json";
import playerPhotosData from "../data/player-photos.json";
import leagueTable from "../data/league_table.json";
import { getSection, sortPlayers, type PlayerInLeague, type PlayerProfile } from "../lib/players";
import { latestLeague, getTeamColor, getTeamName } from "../lib/leagues";

// The grid shows the latest league's roster: players with a section in that
// league. Earlier leagues live on each player's own profile page.
const league = latestLeague;
const roster = (profilesData as PlayerProfile[]).flatMap((player): PlayerInLeague[] => {
	const section = getSection(player, league.id);
	return section && player.status !== "inactive" ? [{ player, section }] : [];
});
const players = sortPlayers(roster, "name", league);
const playerPhotos = playerPhotosData as Record<string, string>;

// Three ways to view the same roster: one alphabetical grid, or grouped
// under a heading per team / per primary position. Each group keeps name
// order. Deliberately never grouped or ordered by any stat (see AGENTS.md's
// "Player profiles" section) - this page celebrates everyone equally.
interface PlayerGroup {
	key: string;
	en?: string;
	ko?: string;
	color?: string;
	players: PlayerInLeague[];
}

// Front to back, like a team sheet.
const POSITION_GROUPS = [
	{ key: "FW", en: "Forwards", ko: "공격수" },
	{ key: "MF", en: "Midfielders", ko: "미드필더" },
	{ key: "DF", en: "Defenders", ko: "수비수" },
	{ key: "GK", en: "Goalkeepers", ko: "골키퍼" },
];

const primaryPosition = (entry: PlayerInLeague) => entry.player.positions[0] ?? null;

// Teams in current standings order (league leader first). The generated
// table is already in official order, ties included; a league with no
// results yet keeps its teams-tab order.
const standingsOrder = leagueTable.filter((row) => row.league === league.id).map((row) => row.team_id);
const teamsByStanding = [...league.teams].sort((a, b) => {
	const rank = (id: string) => (standingsOrder.includes(id) ? standingsOrder.indexOf(id) : standingsOrder.length);
	return rank(a.team_id) - rank(b.team_id);
});

const views: { key: string; groups: PlayerGroup[] }[] = [
	{ key: "name", groups: [{ key: "all", players }] },
	{
		key: "team",
		groups: teamsByStanding
			.map((team) => ({
				key: team.team_id,
				en: team.name,
				ko: team.name,
				color: getTeamColor(team.team_id, league),
				players: players.filter(({ section }) => section.current_team_id === team.team_id),
			}))
			.filter((group) => group.players.length > 0),
	},
	{
		key: "position",
		groups: [
			...POSITION_GROUPS.map((group) => ({
				...group,
				players: players.filter((entry) => primaryPosition(entry) === group.key),
			})),
			{
				key: "none",
				en: "Position TBD",
				ko: "포지션 미정",
				players: players.filter((entry) => !POSITION_GROUPS.some((group) => group.key === primaryPosition(entry))),
			},
		].filter((group) => group.players.length > 0),
	},
];
---

<BaseLayout
	title="Players | KICKS"
	description="Meet the KICKS roster — season stats, play styles, and achievement badges for every player."
>
	<main>
		<section class="content-section" aria-labelledby="players-title">
			<p class="section-label"><T en={`${league.id} ROSTER`} ko={`${league.id} 선수단`} /></p>
			<h1 id="players-title"><T en="Players" ko="선수" /></h1>
			<T
				as="p"
				class="about-description"
				en={`Get to know the ${league.id} roster. Tap a player to see their stats, play style, and badges.`}
				ko={`${league.id} 선수들을 만나보세요. 선수를 누르면 기록, 플레이 스타일, 배지를 볼 수 있어요.`}
			/>

			<div class="player-sort" role="group" aria-label="View players by">
				<span class="player-sort-label"><T en="View by" ko="보기" /></span>
				<button class="player-sort-button" type="button" data-view-button="name" aria-pressed="true">
					<T en="Name" ko="이름" />
				</button>
				<button class="player-sort-button" type="button" data-view-button="team" aria-pressed="false">
					<T en="Team" ko="팀" />
				</button>
				<button class="player-sort-button" type="button" data-view-button="position" aria-pressed="false">
					<T en="Position" ko="포지션" />
				</button>
			</div>

			{
				views.map((view) => (
					<div class="player-view" data-view={view.key} hidden={view.key !== "name"}>
						{view.key === "team" && (
							<div class="player-subfilter" role="group" aria-label="Choose a team">
								{view.groups.map((group, index) => (
									<button
										class="player-sort-button player-team-button"
										type="button"
										data-team-filter={group.key}
										aria-pressed={index === 0 ? "true" : "false"}
									>
										<span class="player-group-dot" style={`background-color: ${group.color}`} />
										{group.en}
									</button>
								))}
							</div>
						)}
						{view.groups.map((group, index) => (
							<div class="player-group" data-group={group.key} hidden={view.key === "team" && index > 0}>
								{group.en && (
									<h3 class="player-group-title">
										{group.color && <span class="player-group-dot" style={`background-color: ${group.color}`} />}
										<T en={group.en} ko={group.ko ?? group.en} />
										<span class="player-group-count">{group.players.length}</span>
									</h3>
								)}
								<div class="player-grid">
									{group.players.map(({ player, section }) => (
										<PlayerCard
											player={player}
											section={section}
											teamName={getTeamName(section.current_team_id, league)}
											teamColor={getTeamColor(section.current_team_id, league)}
											href={`/players/${player.id}`}
											avatarPhoto={playerPhotos[player.id]}
										/>
									))}
								</div>
							</div>
						))}
					</div>
				))
			}
		</section>
	</main>
</BaseLayout>

<script>
	// Switch between the pre-rendered views (by name / team / position).
	// Every view is built at build time, so switching is just show/hide.
	const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-view-button]"));
	const views = Array.from(document.querySelectorAll<HTMLElement>("[data-view]"));

	buttons.forEach((button) => {
		button.addEventListener("click", () => {
			const selected = button.dataset.viewButton;
			buttons.forEach((other) => other.setAttribute("aria-pressed", String(other === button)));
			views.forEach((view) => {
				view.hidden = view.dataset.view !== selected;
			});
		});
	});

	// Team view: one team at a time, starting with the league leader.
	const teamButtons = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-team-filter]"));
	const teamGroups = Array.from(document.querySelectorAll<HTMLElement>('[data-view="team"] [data-group]'));

	teamButtons.forEach((button) => {
		button.addEventListener("click", () => {
			const team = button.dataset.teamFilter;
			teamButtons.forEach((other) => other.setAttribute("aria-pressed", String(other === button)));
			teamGroups.forEach((group) => {
				group.hidden = group.dataset.group !== team;
			});
		});
	});
</script>
