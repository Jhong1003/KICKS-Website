---
// Member benefits (see docs/member-perks.md). Not in the header menu —
// linked from the Partners page and kept out of search results. Members unlock it once per
// phone with the shared club code + their name; after that, opening a
// partner's coupon is one tap. Each open is logged server-side
// (functions/api/perks.js) so staff can see usage in real time.
import BaseLayout from "../../layouts/BaseLayout.astro";
import T from "../../components/T.astro";
import perks from "../../data/perks.json";
import profiles from "../../data/player_profiles.json";
import board from "../../data/board.json";
import partners from "../../data/partners.json";
import { currentSeason } from "../../lib/leagues";

// Players on the roster (not inactive) plus staff who don't play, e.g.
// managers (board members in hand-edited src/data/board.json with a "member_id" like "M001").
const members = [
	...profiles.filter((p) => p.status !== "inactive").map((p) => ({ player_id: p.player_id, name: p.name })),
	...(board as { member_id?: string; name: string }[]).filter((m): m is { member_id: string; name: string } => Boolean(m.member_id)).map((m) => ({ player_id: m.member_id, name: m.name })),
].sort((a, b) => a.name.localeCompare(b.name, "ko"));

// KICKS 2.0: each offer split into the big part ("10% off") and the rest,
// with the partner's logo and short address from partners.json.
const splitOffer = (text: string, lang: "en" | "ko") => {
	const match = lang === "en" ? text.match(/^(\$?\d+%? off)\s*(.*)$/i) : text.match(/^(.*?)\s*(\$?\d+%? 할인)$/);
	if (!match) return { big: text, rest: "" };
	return lang === "en" ? { big: match[1], rest: match[2] } : { big: match[2], rest: match[1] };
};
const MONTHS = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
const untilText = (iso?: string) => {
	if (!iso) return null;
	const [, m, d] = iso.split("-").map(Number);
	return { en: `Until ${MONTHS[m - 1]} ${d}`, ko: `${m}월 ${d}일까지` };
};
const cards = perks.map((perk) => {
	const partner = (partners as { name: string; logo: string | null; address?: string }[]).find((entry) => entry.name === perk.name);
	return {
		...perk,
		logo: partner?.logo ?? null,
		address: partner?.address?.replace(/,\s*[A-Z]{2}\s*\d{5}.*$/, "") ?? "",
		en: splitOffer(perk.offer_en, "en"),
		ko: splitOffer(perk.offer_ko, "ko"),
		until: untilText(perk.valid_until),
	};
});
---

<BaseLayout
	title="Member Benefits | KICKS"
	description="Members-only partner benefits for KICKS."
	noindex
>
	<main class="k-page mb">
		<a class="k-link mb-back" href="/partners/">← <T en="Partners" ko="파트너" /></a>
		<div class="k-page-head">
			<h1 class="k-h1"><T en="Member benefits" ko="멤버 혜택" /></h1>
		</div>

		<div id="perks-unlock" class="mb-lock k-card">
			<svg class="mb-lock-icon" viewBox="0 0 24 24" aria-hidden="true">
				<path
					d="M7 10V7a5 5 0 0 1 10 0v3h1.5A1.5 1.5 0 0 1 20 11.5v9a1.5 1.5 0 0 1-1.5 1.5h-13A1.5 1.5 0 0 1 4 20.5v-9A1.5 1.5 0 0 1 5.5 10H7Zm2 0h6V7a3 3 0 0 0-6 0v3Z"
					fill="currentColor"
				/>
			</svg>
			<h2 class="k-h2"><T en="Members only" ko="멤버 전용" /></h2>
			<T
				as="p"
				class="mb-lock-text"
				en="Pick your name and enter the member code from the group chat."
				ko="이름을 선택하고, 단톡방에 공지된 멤버 코드를 입력해주세요."
			/>
			<form id="perks-unlock-form" class="mb-form">
				<label class="mb-label" for="perks-member"><T en="Your name" ko="이름" /></label>
				<select id="perks-member" class="mb-input" required>
					<option value="" disabled selected>—</option>
					{members.map((m) => <option value={m.player_id}>{m.name}</option>)}
				</select>
				<label class="mb-label" for="perks-code"><T en="Member code" ko="멤버 코드" /></label>
				<input
					type="password"
					id="perks-code"
					class="mb-input"
					autocomplete="off"
					placeholder="Member code"
					data-i18n-attrs={JSON.stringify({ placeholder: { en: "Member code", ko: "멤버 코드" } })}
					required
				/>
				<button class="k-btn mb-unlock" type="submit"><T en="Unlock" ko="잠금 해제" /></button>
			</form>
			<p id="perks-unlock-error" class="mb-error" hidden></p>
		</div>

		<div id="perks-home" class="mb-home" hidden>
			<div class="mb-left">
				<div class="mb-card">
					<svg class="mb-card-court" viewBox="0 0 200 200" preserveAspectRatio="xMaxYMid slice" aria-hidden="true">
						<g fill="none" stroke="rgba(255,255,255,0.16)" stroke-width="2">
							<line x1="40" y1="0" x2="40" y2="200" />
							<circle cx="40" cy="100" r="44" />
							<path d="M200 50 h-34 a50 50 0 0 0 0 100 h34" />
						</g>
					</svg>
					<img class="mb-card-logo" src="/kicks-logo-white.jpg" alt="KICKS" />
					<p class="mb-card-member">MEMBER</p>
					<p class="mb-card-name" id="perks-hello-name"></p>
					<p class="mb-card-season">{currentSeason} season · UIUC</p>
				</div>
				<button type="button" id="perks-switch" class="mb-switch">
					<T en="Not you? Switch member" ko="본인이 아니신가요? 멤버 변경" />
				</button>
				<div class="mb-how">
					<h2 class="k-h3"><T en="How to use" ko="사용 방법" /></h2>
					<ol>
						<li><T en="Pick the partner and tap Use now." ko="파트너를 선택하고 '지금 사용'을 누릅니다." /></li>
						<li><T en="Show the screen to the staff at the counter." ko="계산할 때 직원에게 화면을 보여주세요." /></li>
					</ol>
					<T as="p" class="k-meta" en="Can't be combined with other discounts or promotions." ko="다른 할인·프로모션과 함께 사용할 수 없습니다." />
				</div>
			</div>

			<div class="mb-right">
				<h2 class="k-h2 mb-list-title"><T en="Your benefits" ko="나의 혜택" /></h2>
				<ul class="mb-list">
					{cards.map((perk) => (
						<li class="mb-perk k-card perk-card" data-perk-id={perk.perk_id} data-valid-until={perk.valid_until}>
							<span class="mb-perk-logo">{perk.logo ? <img src={perk.logo} alt="" loading="lazy" /> : perk.name.slice(0, 2)}</span>
							<span class="mb-perk-body">
								<span class="mb-perk-offer"><T en={perk.en.big} ko={perk.ko.big} /></span>
								{(perk.en.rest || perk.ko.rest) && <T class="mb-perk-cond" en={perk.en.rest} ko={perk.ko.rest} />}
								<span class="mb-perk-name">{perk.name}</span>
								{perk.address && <span class="mb-perk-address">{perk.address}</span>}
							</span>
							<span class="mb-perk-action">
								{perk.active ? (
									<>
										<button type="button" class="k-btn perk-use" data-perk-id={perk.perk_id}>
											<T en="Use now" ko="지금 사용" />
										</button>
										<span class="mb-soon perk-expired" hidden><T en="Expired" ko="기간 종료" /></span>
									</>
								) : (
									<span class="mb-soon"><T en="Coming soon" ko="준비 중" /></span>
								)}
								{perk.until && <T class="mb-perk-until" en={perk.until.en} ko={perk.until.ko} />}
							</span>
						</li>
					))}
				</ul>
				<p id="perks-error" class="mb-error" hidden></p>
			</div>
		</div>

		{/* Asked before opening a coupon, since every open is logged as a use. */}
		<dialog id="perks-confirm" class="mb-confirm" aria-labelledby="perk-confirm-title">
			<h2 id="perk-confirm-title" class="k-h3"></h2>
			<T
				as="p"
				class="mb-confirm-text"
				en="Open it at the counter to show the staff. Each open is recorded as a use."
				ko="계산할 때 직원에게 보여줄 화면입니다. 열면 사용 기록이 남습니다."
			/>
			<div class="mb-confirm-actions">
				<button type="button" id="perk-confirm-cancel" class="k-btn k-btn--line"><T en="Not now" ko="취소" /></button>
				<button type="button" id="perk-confirm-ok" class="k-btn"><T en="Use it" ko="사용하기" /></button>
			</div>
		</dialog>

		<div id="perks-coupon" class="mb-store" role="dialog" aria-modal="true" aria-labelledby="perk-coupon-partner" hidden>
			<div class="mb-store-card">
				<p class="mb-store-brand"><img src="/kicks-logo-black.webp" alt="KICKS" /> <span>MEMBER BENEFIT</span></p>
				<img id="perk-coupon-logo" class="mb-store-logo" src="" alt="" hidden />
				<h2 id="perk-coupon-partner" class="mb-store-partner"></h2>
				<p id="perk-coupon-offer" class="mb-store-offer"></p>
				<p id="perk-coupon-member" class="mb-store-member"></p>
				<div class="mb-store-live">
					<span class="mb-store-pulse" aria-hidden="true"></span>
					<span id="perk-coupon-clock" class="mb-store-clock"></span>
				</div>
				<p id="perk-coupon-date" class="mb-store-small"></p>
				<p id="perk-coupon-opened" class="mb-store-small"></p>
				<T
					as="p"
					class="mb-store-note"
					en="Show this screen to the staff. The live clock means it isn't a screenshot."
					ko="이 화면을 직원에게 보여주세요. 화면 속 시계가 실시간으로 움직이기 때문에, 캡처한 화면이 아니라는 걸 바로 알 수 있습니다."
				/>
				<button type="button" id="perk-coupon-close" class="k-btn mb-store-done"><T en="Done" ko="닫기" /></button>
			</div>
		</div>
	</main>
</BaseLayout>

<script type="application/json" id="perks-data" set:html={JSON.stringify({ perks: cards, members })} />

<script>
	import { bilingualHtml } from "../../lib/i18n";

	type Perk = { perk_id: string; name: string; offer_en: string; offer_ko: string; active: boolean; logo: string | null };
	type Member = { player_id: string; name: string };
	type Saved = { code: string; player_id: string };

	const STORAGE_KEY = "kicks-perks-member";
	const COUPON_MS = 10 * 60 * 1000;
	const TZ = "America/Chicago";

	// After valid_until (Chicago date), swap "Use now" for "Expired". The
	// server refuses expired perks anyway (functions/api/perks.js); this just
	// keeps the page from offering a button that can only fail.
	const todayChicago = new Intl.DateTimeFormat("en-CA", { timeZone: TZ }).format(new Date());
	document.querySelectorAll<HTMLElement>(".perk-card[data-valid-until]").forEach((card) => {
		if ((card.dataset.validUntil ?? "") >= todayChicago) return;
		card.querySelector<HTMLElement>(".perk-use")?.setAttribute("hidden", "");
		card.querySelector<HTMLElement>(".perk-expired")?.removeAttribute("hidden");
	});

	const data = JSON.parse(document.getElementById("perks-data")!.textContent || "{}") as {
		perks: Perk[];
		members: Member[];
	};
	const $ = <E extends HTMLElement>(id: string) => document.getElementById(id) as E;
	const unlock = $("perks-unlock");
	const home = $("perks-home");
	const coupon = $("perks-coupon");
	const unlockError = $("perks-unlock-error");
	const homeError = $("perks-error");

	const nameOf = (id: string) => data.members.find((m) => m.player_id === id)?.name ?? "";

	function load(): Saved | null {
		try {
			const saved = JSON.parse(localStorage.getItem(STORAGE_KEY) || "null");
			return saved && saved.code && saved.player_id ? saved : null;
		} catch {
			return null;
		}
	}
	function save(value: Saved | null) {
		try {
			if (value) localStorage.setItem(STORAGE_KEY, JSON.stringify(value));
			else localStorage.removeItem(STORAGE_KEY);
		} catch {
			/* private mode: they'll just unlock again next time */
		}
	}

	const MESSAGES: Record<string, [string, string]> = {
		code: ["That code didn't work. Check the group chat for the current code.", "코드가 맞지 않아요. 단톡방에서 지금 코드를 확인해주세요."],
		member: ["We couldn't find that member. Ask a KICKS staff member.", "멤버 정보를 찾을 수 없어요. 운영진에게 문의해주세요."],
		perk: ["This perk isn't available right now.", "지금은 사용할 수 없는 혜택이에요."],
		unavailable: ["Benefits aren't available right now. Please try again later.", "지금은 혜택을 열 수 없어요. 잠시 후 다시 시도해주세요."],
		network: ["Couldn't connect. Check your internet and try again.", "연결이 안 돼요. 인터넷을 확인하고 다시 시도해주세요."],
	};
	function showError(el: HTMLElement, key: string) {
		const [en, ko] = MESSAGES[key] ?? MESSAGES.unavailable;
		el.innerHTML = bilingualHtml(en, ko);
		el.hidden = false;
	}

	async function call(path: string, body: object): Promise<{ status: number; json: any }> {
		const response = await fetch(path, {
			method: "POST",
			headers: { "Content-Type": "application/json" },
			body: JSON.stringify(body),
		});
		let json: any = null;
		try {
			json = await response.json();
		} catch {}
		return { status: response.status, json };
	}

	function showUnlock(prefill?: string) {
		coupon.hidden = true;
		home.hidden = true;
		unlock.hidden = false;
		if (prefill) ($("perks-member") as HTMLSelectElement).value = prefill;
	}
	function showHome(saved: Saved) {
		unlock.hidden = true;
		home.hidden = false;
		homeError.hidden = true;
		$("perks-hello-name").textContent = nameOf(saved.player_id);
	}

	$("perks-unlock-form").addEventListener("submit", async (event) => {
		event.preventDefault();
		unlockError.hidden = true;
		const player_id = ($("perks-member") as HTMLSelectElement).value;
		const code = ($("perks-code") as HTMLInputElement).value.trim();
		if (!player_id || !code) return;
		try {
			const { status, json } = await call("/api/perks/verify", { code, player_id });
			if (status === 200 && json?.ok) {
				save({ code, player_id });
				($("perks-code") as HTMLInputElement).value = "";
				showHome({ code, player_id });
			} else showError(unlockError, json?.error ?? "unavailable");
		} catch {
			showError(unlockError, "network");
		}
	});

	$("perks-switch").addEventListener("click", () => {
		save(null);
		showUnlock();
	});

	// ---- Coupon screen -------------------------------------------------
	let clockTimer = 0;
	let closeTimer = 0;
	const timeFmt = new Intl.DateTimeFormat("en-US", { timeZone: TZ, hour: "numeric", minute: "2-digit", second: "2-digit" });
	const shortTimeFmt = new Intl.DateTimeFormat("en-US", { timeZone: TZ, hour: "numeric", minute: "2-digit" });
	const dateEn = new Intl.DateTimeFormat("en-US", { timeZone: TZ, weekday: "short", month: "short", day: "numeric", year: "numeric" });
	const dateKo = new Intl.DateTimeFormat("ko-KR", { timeZone: TZ, year: "numeric", month: "long", day: "numeric", weekday: "short" });

	function tick() {
		$("perk-coupon-clock").textContent = timeFmt.format(new Date());
	}
	function closeCoupon() {
		window.clearInterval(clockTimer);
		window.clearTimeout(closeTimer);
		coupon.hidden = true;
		document.body.classList.remove("perk-coupon-open");
	}
	function openCoupon(perk: Perk, saved: Saved, redeemedAt: string) {
		$("perk-coupon-partner").textContent = perk.name;
		const logo = $<HTMLImageElement>("perk-coupon-logo");
		logo.hidden = !perk.logo;
		if (perk.logo) logo.src = perk.logo;
		$("perk-coupon-offer").innerHTML = bilingualHtml(perk.offer_en, perk.offer_ko);
		$("perk-coupon-member").textContent = nameOf(saved.player_id);
		const now = new Date();
		$("perk-coupon-date").innerHTML = bilingualHtml(dateEn.format(now), dateKo.format(now));
		const opened = shortTimeFmt.format(new Date(redeemedAt));
		$("perk-coupon-opened").innerHTML = bilingualHtml(`Opened at ${opened}`, `${opened}에 열림`);
		tick();
		clockTimer = window.setInterval(tick, 1000);
		closeTimer = window.setTimeout(closeCoupon, COUPON_MS);
		coupon.hidden = false;
		document.body.classList.add("perk-coupon-open");
		$("perk-coupon-close").focus();
	}

	// "Use now" asks first; only "Use it" calls /api/perks/redeem (which logs).
	const confirmDialog = $<HTMLDialogElement>("perks-confirm");
	let pending: { perk: Perk; button: HTMLButtonElement } | null = null;

	home.addEventListener("click", (event) => {
		const button = (event.target as HTMLElement).closest<HTMLButtonElement>(".perk-use");
		if (!button) return;
		const perk = data.perks.find((p) => p.perk_id === button.dataset.perkId);
		if (!load()) return showUnlock();
		if (!perk) return;
		homeError.hidden = true;
		pending = { perk, button };
		$("perk-confirm-title").innerHTML = bilingualHtml(`Open the ${perk.name} coupon?`, `${perk.name} 쿠폰을 열까요?`);
		confirmDialog.showModal();
		$("perk-confirm-cancel").focus();
	});

	$("perk-confirm-cancel").addEventListener("click", () => confirmDialog.close());
	// Tapping the dimmed area outside the box also cancels.
	confirmDialog.addEventListener("click", (event) => {
		if (event.target === confirmDialog) confirmDialog.close();
	});
	$("perk-confirm-ok").addEventListener("click", () => {
		const choice = pending;
		confirmDialog.close();
		if (choice) redeem(choice.perk, choice.button);
	});
	confirmDialog.addEventListener("close", () => {
		pending = null;
	});

	async function redeem(perk: Perk, button: HTMLButtonElement) {
		const saved = load();
		if (!saved) return showUnlock();
		button.disabled = true;
		try {
			const { status, json } = await call("/api/perks/redeem", { ...saved, perk_id: perk.perk_id });
			if (status === 200 && json?.ok) openCoupon(perk, saved, json.redeemed_at);
			else if (status === 401) {
				// The club code was changed: unlock again with the new one.
				save(null);
				showUnlock(saved.player_id);
				showError(unlockError, "code");
			} else showError(homeError, json?.error ?? "unavailable");
		} catch {
			showError(homeError, "network");
		} finally {
			button.disabled = false;
		}
	}

	$("perk-coupon-close").addEventListener("click", closeCoupon);
	document.addEventListener("keydown", (event) => {
		if (event.key === "Escape" && !coupon.hidden) closeCoupon();
	});

	const saved = load();
	if (saved && nameOf(saved.player_id)) showHome(saved);
	else showUnlock();
</script>

<style>
	.mb-back {
		display: inline-block;
		margin-bottom: 14px;
	}

	/* Lock */
	.mb-lock {
		display: grid;
		justify-items: center;
		gap: 10px;
		max-width: 440px;
		margin: 8px auto 0;
		padding: 36px 28px;
		text-align: center;
	}
	.mb-lock-icon {
		width: 28px;
		height: 28px;
		color: var(--k-olive);
	}
	:global(.mb-lock-text) {
		margin: 0 0 8px;
		color: #444;
	}
	.mb-form {
		display: grid;
		gap: 6px;
		width: 100%;
		text-align: left;
	}
	.mb-label {
		margin-top: 6px;
		color: var(--k-muted);
		font-size: 0.82rem;
		font-weight: 600;
	}
	.mb-input {
		width: 100%;
		height: 44px;
		padding: 0 12px;
		border: 1px solid var(--k-line);
		border-radius: 0;
		background: #fff;
		font: inherit;
	}
	.mb-input:focus {
		outline: 2px solid var(--k-olive);
		outline-offset: -1px;
	}
	.mb-unlock {
		width: 100%;
		min-height: 46px;
		margin-top: 12px;
	}
	.mb-error {
		margin: 8px 0 0;
		color: #b3261e;
		font-size: 0.88rem;
	}

	/* Unlocked */
	.mb-home:not([hidden]) {
		display: grid;
		grid-template-columns: 380px minmax(0, 1fr);
		gap: 40px;
		align-items: start;
	}
	.mb-card {
		position: relative;
		display: grid;
		align-content: space-between;
		aspect-ratio: 1.586;
		overflow: hidden;
		padding: 22px 24px;
		border-radius: 10px;
		background: var(--k-olive);
		color: #fff;
	}
	.mb-card-court {
		position: absolute;
		top: 0;
		right: 0;
		width: 55%;
		height: 100%;
	}
	.mb-card-logo {
		position: relative;
		width: 120px;
		height: auto;
	}
	.mb-card-member {
		position: relative;
		margin: 18px 0 0;
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.14em;
		opacity: 0.8;
	}
	.mb-card-name {
		position: relative;
		margin: 2px 0 0;
		font-family: var(--k-font-display);
		font-size: 1.9rem;
		font-weight: 800;
	}
	.mb-card-season {
		position: relative;
