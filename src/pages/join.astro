---
import BaseLayout from "../layouts/BaseLayout.astro";

const applications = [
	{
		title: "Player Application",
		description: "Join a team and compete in our weekly Sunday league. Some prior game experience is recommended.",
		href: "https://docs.google.com/forms/d/e/1FAIpQLSeAsTpI1HfyPwalSO6fJGyN9qXU2k6ALMtHRKj8RfnM89bzqQ/viewform",
	},
	{
		title: "Manager Application",
		description: "Help run the club behind the scenes — match operations, stats, media, and events.",
		href: "https://docs.google.com/forms/d/e/1FAIpQLSe41sRKsCnZyOgq9njgD-TwpBY8TLlDSh8JDZ4_Hz_VF-yqaA/viewform",
	},
];
---

<BaseLayout title="Join | KICKS" description="Apply to join KICKS as a player or manager.">
	<main>
		<section class="content-section" aria-labelledby="join-title">
			<p class="section-label">JOIN KICKS</p>
			<h1 id="join-title">Ready to play?</h1>
			<p class="about-description">
				Choose the application that fits you below. Both link out to a short Google Form.
			</p>

			<div class="cta-card-grid">
				{
					applications.map((application) => (
						<div class="cta-card">
							<span class="cta-card-title">{application.title}</span>
							<p class="cta-card-description">{application.description}</p>
							<a class="button-primary" href={application.href} target="_blank" rel="noopener noreferrer">
								Apply
							</a>
						</div>
					))
				}
			</div>
		</section>
	</main>
</BaseLayout>
