---
import BaseLayout from "../layouts/BaseLayout.astro";
import { pageOgImage } from "../lib/og";
import T from "../components/T.astro";
import recruitment from "../data/recruitment.json";

// KICKS 2.0 Join: a wide Player card, a Manager card, and three questions.
// recruitment.json's player_status: "open" | "waitlist" | "closed".
const status = recruitment.player_status as "open" | "waitlist" | "closed";
const season = recruitment.season;

const playerStatus = {
	open: { en: `${season} applications open`, ko: `${season} 지원 시작` },
	waitlist: { en: "Applications closed · Waitlist open", ko: "모집 마감 · 대기명단 접수 중" },
	closed: { en: "Applications closed", ko: "모집 마감" },
}[status];

const playerRows = [
	{
		en: "Who",
		ko: "대상",
		valueEn: "Any UIUC student, including freshmen, transfers and grad students",
		valueKo: "UIUC 학생이라면 누구나 (신입생, 편입생, 대학원생 포함)",
	},
	{ en: "Experience", ko: "경험", valueEn: "Some soccer or futsal experience", valueKo: "축구나 풋살 경험이 있으면 좋습니다" },
	{
		en: "When",
		ko: "시간",
		valueEn: "Saturdays, 3:30–6 PM (warm-up from 3:30, first game at 4)",
		valueKo: "매주 토요일 오후 3:30–6:00 (3:30부터 워밍업, 첫 경기 4시)",
	},
	{ en: "League", ko: "리그", valueEn: "Two leagues a semester, new teams each league", valueKo: "한 학기에 두 번, 리그마다 팀 새로 구성" },
];

const managerFormUrl = "https://docs.google.com/forms/d/e/1FAIpQLSe41sRKsCnZyOgq9njgD-TwpBY8TLlDSh8JDZ4_Hz_VF-yqaA/viewform";

const faqs = [
	{
		question: "When do you play?",
		questionKo: "정기 활동은 언제 하나요?",
		answer: "Saturdays, 3:30–6 PM. Warm-up starts at 3:30 and the first game is at 4.",
		answerKo: "매주 토요일 오후 3:30–6:00에 활동합니다. 3:30부터 워밍업, 첫 경기는 4시입니다.",
	},
	{
		question: "How much are dues?",
		questionKo: "회비는 얼마인가요?",
		answer: "Dues are announced at the first General Meeting of the semester.",
		answerKo: "회비는 학기 첫 전체 모임(GM)에서 안내합니다.",
	},
	{
		question: "Can I join during the semester?",
		questionKo: "학기 중에도 가입할 수 있나요?",
		answer: "Players join before the semester starts. After that, we add people from the waitlist when a spot opens. Managers can join any time.",
		answerKo: "선수는 학기 시작 전에 모집합니다. 학기 중에는 빈자리가 생기면 대기명단에 있는 분께 연락드립니다. 매니저는 언제든 지원할 수 있습니다.",
	},
];
---

<BaseLayout
	ogImage={pageOgImage("join")}
	title="Join | KICKS"
	description={`${season} player ${status === "open" ? "applications open" : status === "waitlist" ? "waitlist open" : "applications closed"}. Manager applications welcome year-round. Learn how to join KICKS.`}
>
	<main class="k-page join">
		<div class="k-page-head">
			<h1 class="k-h1"><T en="Join KICKS" ko="KICKS 신청하기" /></h1>
		</div>

		<div class="join-cards">
			<section class:list={["join-card k-card", { "join-card--open": status !== "closed" }]} aria-labelledby="join-player-title">
				<p class:list={["join-status", { "join-status--off": status === "closed" }]}>
					<span class="join-dot" aria-hidden="true"></span>
					<T en={playerStatus.en} ko={playerStatus.ko} />
				</p>
				<h2 class="k-h2" id="join-player-title"><T en="Player" ko="선수" /></h2>
				<T
					as="p"
					class="join-text"
					en="Our league is competitive, so some soccer or futsal experience helps."
					ko="실제로 경쟁하는 리그인 만큼, 축구나 풋살 경험이 있으면 좋습니다."
				/>
				<dl class="join-facts">
					{
						playerRows.map((row) => (
							<div>
								<dt><T en={row.en} ko={row.ko} /></dt>
								<dd><T en={row.valueEn} ko={row.valueKo} /></dd>
							</div>
						))
					}
				</dl>
				{
					status === "closed" ? (
						<span class="k-btn join-btn join-btn--off" aria-disabled="true">
							<T en="Applications closed" ko="모집 마감" />
						</span>
					) : (
						<a class="k-btn join-btn" href={recruitment.player_form_url} target="_blank" rel="noopener noreferrer">
							{status === "waitlist" ? <T en="Join the waitlist" ko="대기명단 등록하기" /> : <T en="Apply as a player" ko="선수로 지원하기" />}
						</a>
					)
				}
			</section>

			<section class="join-card join-card--open k-card" aria-labelledby="join-manager-title">
				<p class="join-status">
					<span class="join-dot" aria-hidden="true"></span>
					<T en="Always open" ko="상시 모집" />
				</p>
				<h2 class="k-h2" id="join-manager-title"><T en="Manager" ko="매니저" /></h2>
				<T
					as="p"
					class="join-text"
					en="Help run the club: league days, stats, photos and events. No playing required."
					ko="경기 운영, 기록, 사진, 이벤트 등 동아리 운영을 함께합니다. 직접 경기를 뛰지 않아도 지원할 수 있습니다."
				/>
				<a class="k-btn join-btn" href={managerFormUrl} target="_blank" rel="noopener noreferrer">
					<T en="Apply as a manager" ko="매니저로 지원하기" />
				</a>
			</section>
		</div>

		<section class="k-section join-faq" aria-labelledby="join-faq-title">
			<div class="join-faq-side">
				<h2 class="k-h2" id="join-faq-title"><T en="Before you apply" ko="지원 전에" /></h2>
				<a class="k-link" href="https://www.instagram.com/kicks.uiuc" target="_blank" rel="noopener noreferrer">Instagram @kicks.uiuc</a>
			</div>
			<dl class="join-faq-list">
				{
					faqs.map((faq) => (
						<div>
							<dt><T en={faq.question} ko={faq.questionKo} /></dt>
							<dd><T en={faq.answer} ko={faq.answerKo} /></dd>
						</div>
					))
				}
			</dl>
		</section>
	</main>
</BaseLayout>

<style>
	.join-cards {
		display: grid;
		grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
		gap: 20px;
		align-items: stretch;
	}
	.join-card {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 14px;
		padding: 28px;
	}
	/* Olive line on the left of every card that's taking applications. */
	.join-card--open {
		border-left: 4px solid var(--k-olive);
	}
	.join-status {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		margin: 0;
		color: var(--k-olive);
		font-size: 0.85rem;
		font-weight: 700;
	}
	.join-dot {
		width: 8px;
		height: 8px;
		border-radius: 50%;
		background: currentColor;
	}
	.join-status--off {
		color: var(--k-muted);
	}
	:global(.join-text) {
		margin: 0;
		color: #333;
		line-height: 1.6;
	}
	.join-facts {
		width: 100%;
		margin: 4px 0 6px;
		border-top: 1px solid var(--k-line);
	}
	.join-facts div {
		display: grid;
		grid-template-columns: 120px minmax(0, 1fr);
		gap: 16px;
		padding: 12px 0;
		border-bottom: 1px solid var(--k-line);
	}
	.join-facts dt {
		color: var(--k-muted);
		font-size: 0.85rem;
		font-weight: 600;
	}
	.join-facts dd {
		margin: 0;
		font-size: 0.93rem;
	}
	.join-btn {
		margin-top: auto;
	}
	.join-btn--off {
		border-color: var(--k-line);
		background: #f2f2f2;
		color: var(--k-muted);
		cursor: not-allowed;
	}

	.join-faq {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
		gap: 20px 48px;
	}
	.join-faq-side {
		display: grid;
		align-content: start;
		gap: 10px;
	}
	.join-faq-list {
		margin: 0;
	}
	.join-faq-list div {
		padding: 18px 0;
		border-top: 1px solid var(--k-line);
	}
	.join-faq-list div:first-child {
		padding-top: 4px;
		border-top: 0;
	}
	.join-faq-list dt {
		font-weight: 700;
	}
	.join-faq-list dd {
		margin: 6px 0 0;
		color: #444;
		line-height: 1.65;
	}

	@media (max-width: 860px) {
		.join-cards,
		.join-faq {
			grid-template-columns: 1fr;
		}
		.join-card {
			padding: 22px 20px;
		}
		.join-facts div {
			grid-template-columns: 1fr;
			gap: 4px;
		}
	}
</style>
