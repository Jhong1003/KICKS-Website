---
// TODO: replace the href="#" placeholders below with the real Google Form links.
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Join | KICKS" description="Apply to join KICKS as a player or manager.">
	<main>
		<section class="content-section" aria-labelledby="join-title">
			<p class="section-label">JOIN KICKS</p>
			<h1 id="join-title">Ready to play?</h1>
			<p class="about-description">
				Choose the application that fits you below. Both link out to a short Google Form.
			</p>

			<div class="cta-card-grid">
				<a class="cta-card" href="#">
					<!-- TODO: replace with the real Player Application Google Form link -->
					<span class="cta-card-title">Player Application</span>
					<span class="cta-card-description">Join a team and play in the season league.</span>
				</a>
				<a class="cta-card" href="#">
					<!-- TODO: replace with the real Manager Application Google Form link -->
					<span class="cta-card-title">Manager Application</span>
					<span class="cta-card-description">Help run and organize a team for the season.</span>
				</a>
			</div>
		</section>
	</main>
</BaseLayout>
