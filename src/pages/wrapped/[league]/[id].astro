---
// KICKS Wrapped: one player's recap of one finished league, as full-screen
// story slides (tap/click right = next, left = back; arrow keys; swipe).
// The last slide is a summary card that can be saved as a 1080×1920 image
// (drawn on a canvas from the JSON below) or shared as a link.
// All the numbers and highlight rules live in src/lib/wrapped.ts.
import BaseLayout from "../../../layouts/BaseLayout.astro";
import T from "../../../components/T.astro";
import { leagues, getTeamColor, type League } from "../../../lib/leagues";
import { BADGES, sortBadges, type PlayerLeagueSection, type PlayerProfile } from "../../../lib/players";
import { buildWrapped, wrappedPlayers } from "../../../lib/wrapped";

export function getStaticPaths() {
	return leagues.flatMap((league) =>
		wrappedPlayers(league).map(({ player, section }) => ({
			params: { league: league.id, id: player.id },
			props: { league, player, section },
		})),
	);
}

interface Props {
	league: League;
	player: PlayerProfile;
	section: PlayerLeagueSection;
}

const { league, player, section } = Astro.props;
const data = buildWrapped(player, section, league);
const badges = sortBadges(section.badges);
const teamColor = getTeamColor(data.team.teamId, league);
const best = section.personal_best_week;
// The share card shows every badge (except the own-goal one) as a plain emoji.
const cardBadges = badges
	.filter((key) => key !== "own_goal_award")
	.map((key) => ({ icon: BADGES[key].icon, tier: key === "champion" ? "champion" : BADGES[key].tier }));
const plural = (n: number, word: string) => `${n} ${word}${n === 1 ? "" : "s"}`;

// What the canvas needs to draw the summary image in either language.
const cardData = {
	name: player.name,
	league: league.id,
	team: data.team.teamName,
	teamColor,
	champion: data.team.champion,
	rank: data.team.rank,
	goals: data.goals,
	assists: data.assists,
	points: data.attackingPoints,
	games: data.games,
	tag: section.play_style_tag,
	positions: player.positions,
	badges: cardBadges,
	highlights: data.highlights.map(({ icon, title, sub }) => ({ icon, title, sub })),
};
---

<BaseLayout
	title={`${player.name} · ${league.id} Wrapped | KICKS`}
	description={`${player.name}'s ${league.id} season recap on KICKS.`}
	header="custom"
>
	<div class="wrapped" id="wrapped" data-player-url={`/players/${player.id}`}>
		<div class="wrapped-stage" style={`--team-color: ${teamColor}`}>
			<div class="wrapped-progress" aria-hidden="true"></div>

			<div class="wrapped-top">
				<span class="wrapped-brand">KICKS WRAPPED</span>
				<div class="wrapped-top-actions">
					<button class="wrapped-lang" type="button" data-wrapped-lang>EN | 한</button>
					<a
						class="wrapped-close"
						href={`/players/${player.id}`}
						aria-label="Close Wrapped"
						data-i18n-attrs={JSON.stringify({ "aria-label": { en: "Close Wrapped", ko: "Wrapped 닫기" } })}
					>
						✕
					</a>
				</div>
			</div>

			<!-- 1. Intro -->
			<section class="wrapped-slide wrapped-slide--intro">
				<p class="wrapped-eyebrow">{league.id}</p>
				<div class="wrapped-name-row">
					<h1 class="wrapped-hero">{player.name}</h1>
					{
						player.positions.length > 0 && (
							<p class="wrapped-positions">
								{player.positions.map((position) => (
									<span class={`position-chip position-${position}`}>{position}</span>
								))}
							</p>
						)
					}
				</div>
				<T
					as="p"
					class="wrapped-lead"
					en={`${data.league.weeks} weeks. ${data.league.matches} matches. ${data.league.goals} goals across the league.`}
					ko={`${data.league.weeks}주, ${data.league.matches}경기, 리그 전체 ${data.league.goals}골.`}
				/>
				<T
					as="p"
					class="wrapped-lead wrapped-lead--strong"
					en={`And you were out there for ${plural(data.games, "game")}.`}
					ko={`그중 당신은 ${data.games}경기를 함께 뛰었어요.`}
				/>
				<T as="p" class="wrapped-hint" en="Tap to continue →" ko="탭해서 넘기기 →" />
			</section>

			<!-- 2. Numbers -->
			<section class="wrapped-slide">
				<T as="p" class="wrapped-eyebrow" en="Your numbers" ko="당신의 숫자" />
				<div class="wrapped-stats">
					<div><span class="wrapped-stat-value">{data.goals}</span><T class="wrapped-stat-label" en="Goals" ko="골" /></div>
					<div><span class="wrapped-stat-value">{data.assists}</span><T class="wrapped-stat-label" en="Assists" ko="어시스트" /></div>
					<div><span class="wrapped-stat-value">{data.attackingPoints}</span><T class="wrapped-stat-label" en="Attacking pts" ko="공격포인트" /></div>
					<div><span class="wrapped-stat-value">{data.games}</span><T class="wrapped-stat-label" en="Games" ko="경기" /></div>
				</div>
				{
					data.attackingPoints === 0 && (
						<T
							as="p"
							class="wrapped-lead"
							en={`Some seasons aren't about the scoresheet. ${plural(data.games, "game")} with the team is its own story.`}
							ko={`기록지에 다 담기지 않는 시즌도 있어요. 팀과 함께한 ${data.games}경기가 그 자체로 이야기예요.`}
						/>
					)
				}
			</section>

			<!-- 3. Highlights -->
			<section class="wrapped-slide">
				<T as="p" class="wrapped-eyebrow" en="Your highlights" ko="당신의 하이라이트" />
				<ol class="wrapped-highlights">
					{
						data.highlights.map((highlight) => (
							<li>
								<span class="wrapped-highlight-icon" aria-hidden="true">{highlight.icon}</span>
								<div>
									<T as="p" class="wrapped-highlight-title" en={highlight.title.en} ko={highlight.title.ko} />
									<T as="p" class="wrapped-highlight-sub" en={highlight.sub.en} ko={highlight.sub.ko} />
								</div>
							</li>
						))
					}
				</ol>
			</section>

			<!-- 4. Best week -->
			{
				best && (
					<section class="wrapped-slide">
						<T as="p" class="wrapped-eyebrow" en="Your best week" ko="당신의 최고의 주" />
						<T as="p" class="wrapped-hero" en={`Week ${best.week}`} ko={`${best.week}주차`} />
						<T
							as="p"
							class="wrapped-lead wrapped-lead--strong"
							en={`${plural(best.goals, "goal")} · ${plural(best.assists, "assist")}`}
							ko={`${best.goals}골 · ${best.assists}어시스트`}
						/>
						<T
							as="p"
							class="wrapped-lead"
							en={`${plural(best.attacking_points, "attacking point")} in a single week.`}
							ko={`한 주에 공격포인트 ${best.attacking_points}개를 만들었어요.`}
						/>
					</section>
				)
			}

			<!-- 5. Style + badges -->
			<section class="wrapped-slide">
				<T as="p" class="wrapped-eyebrow" en="Your style" ko="당신의 스타일" />
				<p class="wrapped-hero wrapped-hero--tag">{section.play_style_tag}</p>
				<T
					as="p"
					class="wrapped-lead"
					en={`${plural(badges.length, "badge")} earned this league`}
					ko={`이번 리그에서 배지 ${badges.length}개를 모았어요`}
				/>
				<ul class="wrapped-badges">
					{
						badges.map((key) => (
							<li class:list={["wrapped-badge", `wrapped-badge--${BADGES[key].tier}`, { "wrapped-badge--champion": key === "champion" }]}>
								<span aria-hidden="true">{BADGES[key].icon}</span>
								<T en={BADGES[key].label} ko={BADGES[key].labelKo ?? BADGES[key].label} />
							</li>
						))
					}
				</ul>
			</section>

			<!-- 6. Team -->
			<section class:list={["wrapped-slide", { "wrapped-slide--champion": data.team.champion }]}>
				<T as="p" class="wrapped-eyebrow" en="Your team" ko="당신의 팀" />
				{
					data.team.champion ? (
						<>
							<p class="wrapped-trophy" aria-hidden="true">🏆</p>
							<T as="p" class="wrapped-hero" en="Champions" ko="우승" />
							<p class="wrapped-team-name">{data.team.teamName}</p>
						</>
					) : (
						<>
							<p class="wrapped-team-name wrapped-team-name--big">{data.team.teamName}</p>
							<T
								as="p"
								class="wrapped-lead wrapped-lead--strong"
								en={`Finished #${data.team.rank} in ${league.id}`}
								ko={`${league.id} 최종 ${data.team.rank}위`}
							/>
						</>
					)
				}
				{
					data.previousTeams.length > 0 && (
						<T
							as="p"
							class="wrapped-lead"
							en={`Earlier this league: ${data.previousTeams.join(", ")}.`}
							ko={`이번 리그 초반에는 ${data.previousTeams.join(", ")}에서 뛰었어요.`}
						/>
					)
				}
			</section>

			<!-- 7. Own goal (just for fun; never on the share card) -->
			{
				data.ownGoalAward && (
					<section class="wrapped-slide">
						<T as="p" class="wrapped-eyebrow" en="One more thing" ko="그리고 하나 더" />
						<p class="wrapped-trophy" aria-hidden="true">🪃</p>
						<T as="p" class="wrapped-hero wrapped-hero--small" en="Own Goal Award" ko="자책골 어워드" />
						<T
							as="p"
							class="wrapped-lead"
							en="You generously helped the other team too. It happens to the best of us!"
							ko="상대 팀에게도 너그러웠던 당신. 누구에게나 있을 수 있는 일이에요!"
						/>
					</section>
				)
			}

			<!-- 8. Summary card -->
			<section class="wrapped-slide wrapped-slide--summary">
				<div class="wrapped-card">
					<p class="wrapped-card-brand">KICKS · {league.id} WRAPPED</p>
					<p class="wrapped-card-name">
						{player.name}
						{player.positions.map((position) => (
							<span class={`position-chip position-${position}`}>{position}</span>
						))}
					</p>
					<p class="wrapped-card-team">
						{data.team.champion && <span aria-hidden="true">🏆 </span>}{data.team.teamName} · {section.play_style_tag}
					</p>
					<div class="wrapped-card-stats">
						<div><strong>{data.goals}</strong><T en="Goals" ko="골" /></div>
						<div><strong>{data.assists}</strong><T en="Assists" ko="어시" /></div>
						<div><strong>{data.games}</strong><T en="Games" ko="경기" /></div>
					</div>
					<ul class="wrapped-card-highlights">
						{
							data.highlights.map((highlight) => (
								<li>
									<span aria-hidden="true">{highlight.icon}</span>
									<T en={highlight.title.en} ko={highlight.title.ko} />
								</li>
							))
						}
					</ul>
					{
						cardBadges.length > 0 && (
							<div class="wrapped-card-badge-row">
								<T
									class="wrapped-card-badge-count"
									en={plural(cardBadges.length, "badge")}
									ko={`배지 ${cardBadges.length}개`}
								/>
								<ul class="wrapped-card-badges" aria-hidden="true">
									{cardBadges.map((badge) => (
										<li class={`wrapped-card-badge wrapped-card-badge--${badge.tier}`}>{badge.icon}</li>
									))}
								</ul>
							</div>
						)
					}
				</div>
				<div class="wrapped-actions" data-wrapped-actions>
					<button type="button" class="wrapped-button wrapped-button--primary" data-wrapped-save>
						<T en="Save image" ko="이미지 저장" />
					</button>
					<button type="button" class="wrapped-button" data-wrapped-copy>
						<span data-copy-label><T en="Copy link" ko="링크 복사" /></span>
						<span data-copy-done hidden><T en="Copied!" ko="복사됐어요!" /></span>
					</button>
					<a class="wrapped-button wrapped-button--ghost" href={`/players/${player.id}`}>
						<T en="Player page" ko="선수 페이지" />
					</a>
				</div>
			</section>
		</div>
	</div>

	<script type="application/json" id="wrapped-card-data" set:html={JSON.stringify(cardData)} />
</BaseLayout>

<script>
	interface Text { en: string; ko: string }
	interface CardData {
		name: string; league: string; team: string; teamColor: string; champion: boolean; rank: number;
		goals: number; assists: number; points: number; games: number; tag: string; positions: string[];
		badges: { icon: string; tier: string }[];
		highlights: { icon: string; title: Text; sub: Text }[];
	}

	const root = document.getElementById("wrapped");
	if (root) {
		const slides = [...root.querySelectorAll<HTMLElement>(".wrapped-slide")];
		const progress = root.querySelector<HTMLElement>(".wrapped-progress")!;
		progress.innerHTML = slides.map(() => "<span><i></i></span>").join("");
		const bars = [...progress.querySelectorAll("span")];
		let current = 0;

		const show = (index: number) => {
			current = Math.max(0, Math.min(slides.length - 1, index));
			slides.forEach((slide, i) => slide.classList.toggle("is-active", i === current));
			bars.forEach((bar, i) => bar.classList.toggle("is-done", i <= current));
		};
		show(0);
		document.documentElement.classList.add("wrapped-open");

		// Taps on the stage: right two-thirds = next, left third = back.
		// Buttons and links keep their own behavior.
		const stage = root.querySelector<HTMLElement>(".wrapped-stage")!;
		let startX = 0;
		let startY = 0;
		stage.addEventListener("pointerdown", (event) => { startX = event.clientX; startY = event.clientY; });
		stage.addEventListener("pointerup", (event) => {
			if ((event.target as HTMLElement).closest("a, button")) return;
			const dx = event.clientX - startX;
			const dy = event.clientY - startY;
			if (Math.abs(dx) > 40 && Math.abs(dx) > Math.abs(dy)) {
				show(current + (dx < 0 ? 1 : -1));
				return;
			}
			if (Math.abs(dx) > 10 || Math.abs(dy) > 10) return;
			const rect = stage.getBoundingClientRect();
			show(current + (event.clientX - rect.left < rect.width / 3 ? -1 : 1));
		});
		document.addEventListener("keydown", (event) => {
			if (event.key === "ArrowRight" || event.key === " ") { event.preventDefault(); show(current + 1); }
			if (event.key === "ArrowLeft") show(current - 1);
			if (event.key === "Escape") window.location.href = root.dataset.playerUrl ?? "/players";
		});

		root.querySelector("[data-wrapped-lang]")?.addEventListener("click", () => {
			const next = document.documentElement.lang === "ko" ? "en" : "ko";
			(window as unknown as { kicksSetLang: (lang: string, remember: boolean) => void }).kicksSetLang(next, true);
		});

		// Link copy.
		root.querySelector("[data-wrapped-copy]")?.addEventListener("click", async () => {
			try {
				await navigator.clipboard.writeText(window.location.href);
				const label = root.querySelector<HTMLElement>("[data-copy-label]")!;
				const done = root.querySelector<HTMLElement>("[data-copy-done]")!;
				label.hidden = true;
				done.hidden = false;
				setTimeout(() => { label.hidden = false; done.hidden = true; }, 1800);
			} catch {
				window.prompt("Copy this link", window.location.href);
			}
		});

		// Summary image, drawn in the language currently shown.
		const card = JSON.parse(document.getElementById("wrapped-card-data")?.textContent ?? "{}") as CardData;
		root.querySelector("[data-wrapped-save]")?.addEventListener("click", async () => {
			const lang = document.documentElement.lang === "ko" ? "ko" : "en";
			const blob = await drawCard(card, lang);
			if (!blob) return;
			const file = new File([blob], `kicks-${card.league}-wrapped.png`, { type: "image/png" });
			const nav = navigator as Navigator & { canShare?: (data: { files: File[] }) => boolean };
			if (nav.canShare?.({ files: [file] }) && matchMedia("(pointer: coarse)").matches) {
				try { await navigator.share({ files: [file] }); return; } catch (error) {
					if ((error as DOMException).name === "AbortError") return;
				}
			}
			const url = URL.createObjectURL(blob);
			const link = document.createElement("a");
			link.href = url;
			link.download = file.name;
			link.click();
			setTimeout(() => URL.revokeObjectURL(url), 1000);
		});
	}

	const POSITION_COLORS: Record<string, string> = { GK: "#f0a202", DF: "#2f6fed", MF: "#2e9e5b", FW: "#d7263d" };
	const FONT = '-apple-system, BlinkMacSystemFont, "Apple SD Gothic Neo", "Malgun Gothic", "Segoe UI", sans-serif';

	/** Splits `text` into lines no wider than `maxWidth` (with the font currently set). */
	function wrapLines(ctx: CanvasRenderingContext2D, text: string, maxWidth: number): string[] {
		const lines: string[] = [];
		let line = "";
		for (const word of text.split(" ")) {
			const test = line ? `${line} ${word}` : word;
			if (ctx.measureText(test).width > maxWidth && line) {
				lines.push(line);
				line = word;
			} else {
				line = test;
			}
		}
		lines.push(line);
		return lines;
	}

	/** fillText with CSS-style letter-spacing (drawn glyph by glyph, so it works in every browser). */
	function spacedText(ctx: CanvasRenderingContext2D, text: string, x: number, y: number, spacing: number, align: "left" | "center" = "left") {
		const chars = [...text];
		const width = chars.reduce((sum, char) => sum + ctx.measureText(char).width + spacing, -spacing);
		let cursor = align === "center" ? x - width / 2 : x;
		const previous = ctx.textAlign;
		ctx.textAlign = "left";
		for (const char of chars) {
			ctx.fillText(char, cursor, y);
			cursor += ctx.measureText(char).width + spacing;
		}
		ctx.textAlign = previous;
	}

	/**
	 * The share image: a copy of the summary card on the last slide. Every size
	 * below is the card's CSS value multiplied by S (the card is ~336px wide on
	 * a phone and 940px here), so the saved image looks like what's on screen.
	 * The card is centered and kept inside Instagram's safe zone — the story
	 * header covers roughly the top 250px and the reply bar the bottom 250px.
	 */
	async function drawCard(card: CardData, lang: "en" | "ko"): Promise<Blob | null> {
		await document.fonts?.ready;
		const W = 1080;
		const H = 1920;
		const canvas = document.createElement("canvas");
		canvas.width = W;
		canvas.height = H;
		const ctx = canvas.getContext("2d");
		if (!ctx) return null;
		const t = (text: { en: string; ko: string }) => text[lang];
		const gold = "#e9c65a";
		const cream = "#f7f6f2";

		// Background: same 160° gradient as the slides.
		const background = ctx.createLinearGradient(W * 0.33, 0, W * 0.67, H);
		background.addColorStop(0, "#3f5128");
		background.addColorStop(1, "#1b2411");
		ctx.fillStyle = background;
		ctx.fillRect(0, 0, W, H);

		const cardW = 940;
		const S = cardW / 336;
		const px = (css: number) => Math.round(css * S);
		const cardX = (W - cardW) / 2;
		const padX = px(20);
		const padY = px(22);
		const left = cardX + padX;
		const inner = cardW - padX * 2;

		// Font sizes (CSS rem × 16 × S).
		const brandSize = px(10.56);
		const nameSize = px(35.2);
		const chipSize = px(11.5);
		const teamSize = px(14.4);
		const statSize = px(28.8);
		const statLabelSize = px(lang === "ko" ? 12.8 : 10.9);
		const highlightSize = px(14.7);
		const highlightLine = Math.round(highlightSize * 1.35);
		const badgeLabelSize = px(10.9);
		const emojiSize = px(20.8);
		const iconCol = Math.round(highlightSize * 1.3) + px(10);

		// Measure what wraps.
		ctx.font = `600 ${highlightSize}px ${FONT}`;
		const highlightLines = card.highlights.map((highlight) => wrapLines(ctx, t(highlight.title), inner - iconCol));
		ctx.font = `${emojiSize}px ${FONT}`;
		const emojiStep = emojiSize + px(8);
		const perRow = Math.max(1, Math.floor((inner + px(8)) / emojiStep));
		const badgeRows = Math.ceil(card.badges.length / perRow);
		const emojiRow = Math.round(emojiSize * 1.2);

		const blocks = {
			brand: brandSize + px(12),
			name: Math.round(nameSize * 1.1),
			team: px(6) + Math.round(teamSize * 1.4) + px(16),
			stats: px(12) * 2 + Math.round(statSize * 1.1) + px(2) + Math.round(statLabelSize * 1.3),
			highlights:
				px(16) + highlightLines.reduce((sum, lines) => sum + lines.length * highlightLine, 0) + px(8) * (highlightLines.length - 1) + px(12),
			badges: card.badges.length > 0 ? Math.round(badgeLabelSize * 1.3) + px(8) + badgeRows * emojiRow + (badgeRows - 1) * px(4) : 0,
		};
		const cardH = padY * 2 + Object.values(blocks).reduce((a, b) => a + b, 0);
		const footer = px(18) + 30;
		const cardY = Math.max(250, Math.round(250 + (H - 500 - cardH - footer) / 2));

		// Card.
		ctx.beginPath();
		ctx.roundRect(cardX, cardY, cardW, cardH, px(16));
		ctx.fillStyle = "rgba(20, 27, 13, 0.55)";
		ctx.fill();
		ctx.lineWidth = Math.max(2, Math.round(S));
		ctx.strokeStyle = "rgba(233, 198, 90, 0.5)";
		ctx.stroke();

		let y = cardY + padY;
		ctx.textBaseline = "top";

		// Brand line.
		ctx.fillStyle = gold;
		ctx.font = `800 ${brandSize}px ${FONT}`;
		spacedText(ctx, `KICKS · ${card.league} WRAPPED`, left, y, brandSize * 0.14);
		y += blocks.brand;

		// Name + position chips (vertically centered on the name).
		ctx.fillStyle = cream;
		ctx.font = `700 ${nameSize}px ${FONT}`;
		ctx.fillText(card.name, left, y);
		const nameMid = y + blocks.name / 2;
		let chipX = left + ctx.measureText(card.name).width + px(8);
		ctx.font = `700 ${chipSize}px ${FONT}`;
		ctx.textBaseline = "middle";
		const chipH = Math.round(chipSize * 1.25 + px(6.4));
		for (const position of card.positions) {
			const width = ctx.measureText(position).width + px(10.4) * 2;
			if (chipX + width > left + inner) break;
			ctx.fillStyle = POSITION_COLORS[position] ?? "#7f8c8d";
			ctx.beginPath();
			ctx.roundRect(chipX, nameMid - chipH / 2, width, chipH, chipH / 2);
			ctx.fill();
			ctx.fillStyle = "#ffffff";
			ctx.fillText(position, chipX + px(10.4), nameMid + 1);
			chipX += width + px(8);
		}
		ctx.textBaseline = "top";
		y += blocks.name + px(6);

		// Team · style.
		ctx.fillStyle = "rgba(247, 246, 242, 0.85)";
		ctx.font = `400 ${teamSize}px ${FONT}`;
		ctx.fillText(`${card.champion ? "🏆 " : ""}${card.team} · ${card.tag}`, left, y + Math.round(teamSize * 0.2));
		y += blocks.team - px(6);

		// Stats between two rules.
		ctx.strokeStyle = "rgba(247, 246, 242, 0.18)";
		ctx.lineWidth = Math.max(2, Math.round(S));
		ctx.beginPath();
		ctx.moveTo(left, y);
		ctx.lineTo(left + inner, y);
		ctx.moveTo(left, y + blocks.stats);
		ctx.lineTo(left + inner, y + blocks.stats);
		ctx.stroke();
		const stats = [
			[card.goals, lang === "ko" ? "골" : "GOALS"],
			[card.assists, lang === "ko" ? "어시" : "ASSISTS"],
			[card.games, lang === "ko" ? "경기" : "GAMES"],
		] as const;
		const colW = inner / 3;
		stats.forEach(([value, label], i) => {
			const cx = left + colW * i + colW / 2;
			ctx.textAlign = "center";
			ctx.fillStyle = "rgba(247, 246, 242, 0.95)";
			ctx.font = `800 ${statSize}px ${FONT}`;
			ctx.fillText(String(value), cx, y + px(12));
			ctx.fillStyle = "rgba(247, 246, 242, 0.85)";
			ctx.font = `700 ${statLabelSize}px ${FONT}`;
			spacedText(ctx, label, cx, y + px(12) + Math.round(statSize * 1.1) + px(2), lang === "ko" ? statLabelSize * 0.02 : statLabelSize * 0.06, "center");
		});
		ctx.textAlign = "left";
		y += blocks.stats + px(16);

		// Highlights: emoji + title, emoji centered on the text block.
		card.highlights.forEach((highlight, i) => {
			const lines = highlightLines[i];
			const blockH = lines.length * highlightLine;
			ctx.textBaseline = "middle";
			ctx.textAlign = "center";
			ctx.font = `${highlightSize}px ${FONT}`;
			ctx.fillText(highlight.icon, left + (highlightSize * 1.3) / 2, y + blockH / 2);
			ctx.textAlign = "left";
			ctx.textBaseline = "top";
			ctx.fillStyle = cream;
			ctx.font = `600 ${highlightSize}px ${FONT}`;
			lines.forEach((line, n) => ctx.fillText(line, left + iconCol, y + n * highlightLine + (highlightLine - highlightSize) / 2));
			y += blockH + px(8);
		});
		y += px(12) - px(8);

		// Badges.
		if (card.badges.length > 0) {
			ctx.fillStyle = gold;
			ctx.font = `800 ${badgeLabelSize}px ${FONT}`;
			spacedText(ctx, lang === "ko" ? `배지 ${card.badges.length}개` : `${card.badges.length} BADGES`, left, y, badgeLabelSize * 0.1);
			y += Math.round(badgeLabelSize * 1.3) + px(8);
			ctx.font = `${emojiSize}px ${FONT}`;
			ctx.textBaseline = "middle";
			card.badges.forEach((badge, i) => {
				const row = Math.floor(i / perRow);
				const col = i % perRow;
				ctx.fillText(badge.icon, left + col * emojiStep, y + row * (emojiRow + px(4)) + emojiRow / 2);
			});
		}

		// Site address under the card.
		ctx.textBaseline = "alphabetic";
		ctx.textAlign = "center";
		ctx.fillStyle = "rgba(247, 246, 242, 0.55)";
		ctx.font = `700 30px ${FONT}`;
		ctx.fillText("kicksuiuc.com", W / 2, cardY + cardH + footer);
		ctx.textAlign = "left";

		return new Promise((resolve) => canvas.toBlob(resolve, "image/png"));
	}


</script>

