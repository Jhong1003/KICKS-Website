---
// /freekick — KICKS Free Kick, a swipe-to-shoot mini game (prototype: practice
// only, no leaderboard yet).
//
// Swipe up from the ball: the line's end is where the ball goes, its bow is the
// curl, and how fast the finger is moving at the end is the power. The result
// of each kick comes from src/lib/freekick/rules.js alone, so the same swipes
// replay to the same score (for a ranked version later).
import BaseLayout from "../layouts/BaseLayout.astro";
import T from "../components/T.astro";
---

<BaseLayout title="Free Kick Challenge | KICKS" description="Curl free kicks over the wall and past the KICKS keeper.">
	<main class="fk-page">
		<section class="content-section" aria-labelledby="fk-title">
			<p class="section-label">KICKS FREE KICK</p>
			<h1 id="fk-title"><T en="Free Kick Challenge" ko="프리킥 챌린지" /></h1>
			<T
				as="p"
				class="about-description fk-intro"
				en="Ten free kicks. Bend them over the wall and past the keeper."
				ko="프리킥 10개. 벽을 넘기고 키퍼를 피해 골망을 흔들어보세요."
			/>

			<div class="fk-game">
				<div class="fk-hud" aria-live="off">
					<span><span class="fk-hud-label"><T en="Score" ko="점수" /></span> <strong data-hud-score>0</strong></span>
					<span><span class="fk-hud-label"><T en="Streak" ko="연속" /></span> <strong data-hud-combo>0</strong></span>
					<span class="fk-dots" data-hud-dots></span>
				</div>

				<div class="fk-stage" data-stage>
					<canvas width="640" height="560" data-canvas aria-hidden="true"></canvas>
					<p class="fk-toast" data-toast aria-live="assertive"></p>
					<p class="fk-tip" data-tip></p>

					<div class="fk-panel" data-start-panel>
						<T as="h2" en="Step up and take it" ko="프리킥을 차볼까요?" />
						<ul class="fk-howto">
							<T as="li" en="Flick up from the ball toward a corner — a short flick is fine." ko="공에서 골대 구석 쪽으로 휙 쓸어 올리세요. 짧게 쓸어도 돼요." />
							<T as="li" en="Bend the line to curl it." ko="선을 휘게 그리면 공도 휘어요." />
							<T as="li" en="Faster swipe = harder shot. Too hard flies over the bar." ko="빠르게 쓸면 강하게, 살살 쓸면 약하게. 너무 세면 크로스바를 넘어가요." />
						</ul>
						<button type="button" class="button-primary fk-button" data-start><T en="Start" ko="시작" /></button>
					</div>

					<div class="fk-panel" data-result-panel hidden>
						<T as="h2" en="Full time" ko="경기 종료" />
						<p class="fk-final" data-final-score>0</p>
						<p class="fk-final-detail" data-final-detail></p>
						<button type="button" class="button-primary fk-button" data-again><T en="Play again" ko="다시 하기" /></button>
					</div>
				</div>
				<T as="p" class="fk-note" en="Prototype · practice only, scores are not saved yet." ko="시험판 · 연습 모드라 기록은 아직 저장되지 않아요." />
			</div>
		</section>
	</main>
</BaseLayout>

<script>
	import { KICKS, VIEW, BALL_R, WALL_GAP, kicksFor, judgeKick, ballAt, jumpAt, camera, project, validSwipe, replay } from "../lib/freekick/rules.js";
	import { makeDraw, clamp, type Pt } from "../lib/freekick/draw";
	import { bilingualHtml as L } from "../lib/i18n";

	const $ = <E extends Element>(s: string) => document.querySelector<E>(s)!;
	const canvas = $<HTMLCanvasElement>("[data-canvas]");
	const ctx = canvas.getContext("2d")!;
	const stage = $<HTMLElement>("[data-stage]");
	const toast = $<HTMLElement>("[data-toast]");
	const tip = $<HTMLElement>("[data-tip]");
	const startPanel = $<HTMLElement>("[data-start-panel]");
	const resultPanel = $<HTMLElement>("[data-result-panel]");
	const hudScore = $<HTMLElement>("[data-hud-score]");
	const hudCombo = $<HTMLElement>("[data-hud-combo]");
	const hudDots = $<HTMLElement>("[data-hud-dots]");
	const draw = makeDraw(ctx);

	const RUNUP = 520; // ms from the swipe to the foot meeting the ball
	const AFTER = 1500; // ms the result stays on screen before the next kick
	// A big goal gets a slow-motion replay of the last part of its flight.
	const REPLAY_GAP = 0.7, REPLAY_LEN = 1.6, REPLAY_SPAN = 0.6, REPLAY_AFTER = 0.6; // seconds
	const BIG_GOAL = 250; // points (before streak/golden/last) that count as a big goal

	type Swipe = [number, number, number][];
	type Result = ReturnType<typeof judgeKick>;
	type Run = {
		seed: number; kicks: ReturnType<typeof kicksFor>; swipes: Swipe[]; index: number;
		state: "aim" | "kick" | "done"; kickAt: number; result: Result | null; resolved: boolean;
		score: number; combo: number; big: boolean;
	};
	// Effects, all visual only (they never change a result).
	let shake = { until: 0, amp: 0 };
	type Bit = { x: number; y: number; vx: number; vy: number; spin: number; colour: string; born: number };
	let confetti: Bit[] = [];
	let run: Run | null = null;
	let preview = kicksFor(7)[0]; // the scene behind the start panel

	function resize() {
		const ratio = Math.min(window.devicePixelRatio || 1, 2);
		canvas.width = VIEW.w * ratio; canvas.height = VIEW.h * ratio;
		ctx.setTransform(ratio, 0, 0, ratio, 0, 0);
	}
	resize();
	window.addEventListener("resize", resize);

	// ---------- flow ----------
	function start() {
		const seed = (import.meta.env.DEV && (window as any).__fkSeed) || crypto.getRandomValues(new Uint32Array(1))[0];
		run = { seed, kicks: kicksFor(seed), swipes: [], index: 0, state: "aim", kickAt: 0, result: null, resolved: false, score: 0, combo: 0, big: false };
		startPanel.hidden = true; resultPanel.hidden = true;
		hud(); showTip();
	}
	$("[data-start]").addEventListener("click", start);
	$("[data-again]").addEventListener("click", start);

	function showTip() {
		if (!run || run.state !== "aim") { tip.textContent = ""; return; }
		const kick = run.kicks[run.index];
		const wind = kick.wind ? L(` · wind ${kick.wind < 0 ? "←" : "→"}`, ` · 바람 ${kick.wind < 0 ? "←" : "→"}`) : "";
		tip.innerHTML = L(`Kick ${run.index + 1}/${KICKS} · ${kick.D.toFixed(1)} m`, `${run.index + 1}/${KICKS}번째 · ${kick.D.toFixed(1)}m`) + wind +
			(kick.jump ? L(" · the wall may jump", " · 벽이 점프할 수도 있어요") : "");
		if (kick.last) flash(L("Last chance! Points ×2", "라스트 찬스! 점수 ×2"), "special", 1800);
		else if (kick.golden) flash(L("Golden ball! Points ×2", "황금공! 점수 ×2"), "special", 1800);
	}
	function hud() {
		const r = run;
		hudScore.textContent = (r?.score ?? 0).toLocaleString();
		hudCombo.textContent = String(r?.combo ?? 0);
		const outcomes = r ? replay(r.seed, r.swipes).outcomes : [];
		hudDots.replaceChildren(...Array.from({ length: KICKS }, (_, i) => {
			const dot = document.createElement("span");
			const o = outcomes[i];
			if (o) dot.className = o.kind === "goal" ? "goal" : "miss";
			return dot;
		}));
	}
	let toastTimer = 0;
	function flash(html: string, kind: string, ms = 1100) {
		toast.innerHTML = html; toast.dataset.kind = kind; toast.classList.add("show");
		clearTimeout(toastTimer); toastTimer = window.setTimeout(() => toast.classList.remove("show"), ms);
	}
	// What happened, plus a tip for the next one.
	const tipped = (en: string, ko: string, tipEn: string, tipKo: string) => `${L(en, ko)} <small>${L(tipEn, tipKo)}</small>`;
	const TEXT: Record<string, string> = {
		wall: tipped("Off the wall", "벽에 막혔어요", "aim higher or hit it harder", "더 높이, 조금 더 세게"),
		save: tipped("Saved", "키퍼 선방", "tighter to the post, or over the wall", "골대 끝쪽으로, 또는 벽 위로"),
		over: tipped("Over the bar", "크로스바 위로", "a little softer", "조금 살살"),
		wide: tipped("Wide", "옆으로 빗나갔어요", "aim inside the posts", "골대 안쪽을 노려요"),
		post: tipped("Off the post!", "골대 맞고 나왔어요!", "so close", "아까워요"),
	};

	const BONUS_TEXT: Record<string, [string, string]> = {
		top: ["🎯 Top corner", "🎯 탑코너"],
		banana: ["🍌 Banana kick", "🍌 바나나킥"],
		cannon: ["🚀 Cannon", "🚀 캐논슛"],
		under: ["🦶 Under the wall", "🦶 벽 밑으로"],
		long: ["📏 Long range", "📏 장거리"],
		fingertip: ["🧤 Off his fingertips", "🧤 손끝 스침"],
	};
	function resolve(r: Run, now: number) {
		r.resolved = true;
		const res = replay(r.seed, r.swipes);
		const last = res.outcomes.at(-1)!;
		const kick = r.kicks[last.index];
		r.score = res.score; r.combo = res.combo;
		hud();
		if (last.kind !== "goal") { r.big = false; flash(TEXT[last.kind] ?? "", "miss", 1700); return; }
		r.big = last.base >= BIG_GOAL;
		// The toast builds up: the headline, each bonus, the multipliers, the total.
		// The headline climbs with the points scored (after streak, golden and last-kick multipliers).
		const title = last.points >= 500 ? L("WORLD CLASS!", "월드클래스!")
			: last.points >= 300 ? L("WONDER GOAL!", "원더골!")
			: last.points >= 150 ? L("NICE GOAL!", "나이스 골!")
			: L("GOAL!", "골!");
		const parts = [`<strong class="fk-goal-title">${title}</strong>`];
		for (const [key, pts] of last.bonuses) parts.push(`<span class="fk-chip">${L(BONUS_TEXT[key][0], BONUS_TEXT[key][1])} +${pts}</span>`);
		const mult: string[] = [];
		const streak = Math.min(3, 1 + 0.5 * (last.combo - 1));
		if (streak > 1) mult.push(L(`${last.combo} in a row ×${streak}`, `${last.combo}연속 ×${streak}`));
		if (kick.golden) mult.push(L("golden ×2", "황금공 ×2"));
		if (kick.last) mult.push(L("last chance ×2", "라스트 찬스 ×2"));
		if (mult.length) parts.push(`<span class="fk-chip fk-mult">${mult.join(" · ")}</span>`);
		parts.push(`<span class="fk-total">+${last.points}</span>`);
		parts.forEach((part, i) => parts[i] = part.replace(/^<(\w+) class="/, `<$1 style="animation-delay:${i * 110}ms" class="`));
		flash(parts.join(""), last.points >= 300 ? "golazo" : "goal", last.points >= 300 ? 2600 : 1900);
		shake = { until: now + (r.big ? 450 : 280), amp: r.big ? 7 : 4 };
		if (r.big || kick.golden || kick.last) burst(now);
	}
	const CONFETTI = ["#e31b23", "#1d3f9e", "#f1ebdd", "#3f5128", "#f2c94c", "#ffffff"];
	function burst(now: number) {
		confetti = Array.from({ length: 90 }, () => ({
			x: VIEW.w / 2 + (Math.random() - 0.5) * 120, y: 150 + (Math.random() - 0.5) * 40,
			vx: (Math.random() - 0.5) * 520, vy: -180 - Math.random() * 380, spin: Math.random() * 6,
			colour: CONFETTI[Math.floor(Math.random() * CONFETTI.length)], born: now,
		}));
	}
	function next(r: Run) {
		r.index++;
		r.result = null; r.resolved = false;
		if (r.index >= KICKS) {
			r.state = "done";
			tip.textContent = "";
			const res = replay(r.seed, r.swipes);
			$("[data-final-score]").textContent = res.score.toLocaleString();
			$("[data-final-detail]").innerHTML = L(`${res.goals}/${KICKS} goals · best streak ${res.bestCombo} · best kick +${res.bestKick}`, `${KICKS}개 중 ${res.goals}골 · 최고 연속 ${res.bestCombo} · 최고 한 방 +${res.bestKick}`);
			resultPanel.hidden = false;
			return;
		}
		r.state = "aim";
		showTip();
	}

	// ---------- input: record the swipe in canvas units ----------
	let swipe: { id: number; t0: number; pts: Swipe } | null = null;
	let trail: { pts: Swipe; at: number } | null = null;
	const toCanvas = (e: PointerEvent): [number, number] => {
		const box = canvas.getBoundingClientRect();
		return [((e.clientX - box.left) / box.width) * VIEW.w, ((e.clientY - box.top) / box.height) * VIEW.h];
	};
	stage.addEventListener("pointerdown", (e) => {
		if (!run || run.state !== "aim" || (e.target as Element).closest(".fk-panel")) return;
		const [x, y] = toCanvas(e);
		swipe = { id: e.pointerId, t0: e.timeStamp, pts: [[0, Math.round(x), Math.round(y)]] };
		try { stage.setPointerCapture(e.pointerId); } catch {}
		e.preventDefault();
	});
	stage.addEventListener("pointermove", (e) => {
		if (!swipe || e.pointerId !== swipe.id) return;
		const merged: PointerEvent[] = (e as any).getCoalescedEvents?.() ?? [];
		const events = merged.length ? merged : [e];
		for (const ev of events) {
			const [x, y] = toCanvas(ev);
			const t = Math.round(ev.timeStamp - swipe.t0);
			const last = swipe.pts.at(-1)!;
			if (t - last[0] < 8 && Math.hypot(x - last[1], y - last[2]) < 6) continue;
			swipe.pts.push([Math.max(t, last[0]), Math.round(x), Math.round(y)]);
		}
		trail = { pts: swipe.pts, at: performance.now() };
	});
	const release = (e: PointerEvent) => {
		if (!swipe || e.pointerId !== swipe.id || !run) return;
		let pts = swipe.pts;
		swipe = null;
		// keep at most 60 points: thin the middle, keep the last 20 (they set the power)
		if (pts.length > 60) { const head = pts.slice(0, -20), keep = Math.ceil(head.length / 40); pts = [...head.filter((_, i) => i % keep === 0), ...pts.slice(-20)]; }
		if (e.type !== "pointerup" || !validSwipe(pts)) {
			trail = null;
			flash(L("Swipe up from the ball", "공에서 위로 쓸어 올리세요"), "neutral", 1200);
			return;
		}
		const r = run;
		r.swipes[r.index] = pts;
		r.result = judgeKick(r.kicks[r.index], pts);
		r.state = "kick"; r.kickAt = performance.now();
		trail = { pts, at: performance.now() };
		tip.innerHTML = L(`Power ${Math.round(r.result.shot!.power * 100)}%`, `파워 ${Math.round(r.result.shot!.power * 100)}%`);
	};
	stage.addEventListener("pointerup", release);
	stage.addEventListener("pointercancel", release);

	// ---------- frame ----------
	function frame(now: number) {
		requestAnimationFrame(frame);
		const r = run;
		const kick = r && r.state !== "done" ? r.kicks[Math.min(r.index, KICKS - 1)] : r ? r.kicks[KICKS - 1] : preview;
		const cam = camera(kick);
		const phase = r && r.state === "kick" ? now - r.kickAt : -1;
		const res = r?.state === "kick" ? r.result : null;
		const shot = res?.shot ?? null;
		const tReal = shot ? (phase - RUNUP) / 1000 : -1; // seconds since the strike
		const tEnd = res ? res.t : 0;
		// During a replay the picture runs again, slowed, over the end of the flight.
		const replayStart = tEnd + REPLAY_GAP;
		const replaying = !!(r?.big && res?.kind === "goal" && tReal >= replayStart && tReal < replayStart + REPLAY_LEN);
		const t = replaying ? Math.max(0.02, tEnd - REPLAY_SPAN) + (tReal - replayStart) * ((REPLAY_SPAN + 0.15) / REPLAY_LEN) : tReal;
		ctx.save();
		if (now < shake.until) {
			const k = (shake.until - now) / 400 * shake.amp;
			ctx.translate((Math.random() - 0.5) * 2 * k, (Math.random() - 0.5) * 2 * k);
		}

		// ball position
		let bp: [number, number, number] = [kick.x0, BALL_R, kick.D], spin = 0, alpha = 1, netFlash = 0;
		if (shot && t > 0) {
			spin = t * 14;
			if (t < tEnd) bp = ballAt(kick, shot, t) as [number, number, number];
			else {
				const since = t - tEnd, [ax, ay, az] = res!.at as number[];
				if (res!.kind === "goal") {
					const p = clamp(since / 0.25);
					bp = [ax + (ax > 0 ? -0.1 : 0.1) * p, Math.max(BALL_R, ay - 0.3 * p), -0.75 * p];
					netFlash = 1 - clamp(since / 0.6);
				} else if (res!.kind === "wall") {
					bp = [ax + 0.4 * since, Math.max(BALL_R, ay + 1.5 * since - 4.9 * since * since), az + 6 * since];
				} else if (res!.kind === "post") {
					const out = Math.abs(ax) > 1.2 ? Math.sign(ax) : 0;
					bp = [ax + out * 2.5 * since, Math.max(BALL_R, ay + (out ? 0.5 : 2) * since - 4.9 * since * since), az + 5 * since];
				} else if (res!.kind === "save") {
					bp = [ax + Math.sign(ax - kick.keeper.x || 1) * 3 * since, ay + 2 * since - 4.9 * since * since, az + 2 * since];
				} else {
					bp = ballAt(kick, shot, t) as [number, number, number];
					alpha = 1 - clamp(since / 0.5);
				}
				bp[1] = Math.max(BALL_R, bp[1]);
			}
			if (!r!.resolved && tReal >= tEnd) resolve(r!, now);
		}
		const after = res && t >= tEnd ? (res.kind === "goal" ? "cheer" : "sad") : null;
		const afterFor = res ? (t - tEnd) * 1000 : 0;
		const doneAt = r?.big && res?.kind === "goal" ? replayStart + REPLAY_LEN + REPLAY_AFTER : tEnd + AFTER / 1000;
		if (r && r.state === "kick" && res && tReal > doneAt) next(r);

		// keeper: reacts after his reaction time (later if the wall hid the ball) and
		// dives toward where the ball crosses, as far as he can reach in time.
		let kp = draw.keeperPose(kick, null, false, 0, now);
		if (shot && res && res.kind !== "wall" && t > 0) {
			const react = kick.keeper.react + (res.screened ? 0.12 : 0);
			const tg = kick.D / shot.v;
			const [cx, cy] = ballAt(kick, shot, tg);
			// On a goal he dives the right way but falls about 75 cm short.
			const gap = cx - kick.keeper.x;
			const dx = res.kind === "goal" ? Math.sign(gap) * Math.max(0, Math.abs(gap) - 0.75) : gap;
			const tx = kick.keeper.x + dx, ty = Math.min(cy, 2.1);
			const [sx, sy] = project(cam, tx, ty, 0.3);
			const p = clamp((t - react) / Math.max(0.12, tg - react));
			const fall = clamp((t - tg - 0.35) / 0.3);
			kp = draw.keeperPose(kick, [sx, sy], ty > 1.1, p, now, fall);
		}

		// draw back to front
		draw.scene(kick, netFlash);
		// the net ripples out from where the ball hit it
		if (res?.kind === "goal" && t > tEnd) {
			const since = t - tEnd, [ax, ay] = res.at as number[];
			const [nx, ny, nk] = project(cam, ax, ay, -0.75);
			ctx.save();
			for (let i = 0; i < 3; i++) {
				const p = since / 0.7 - i * 0.18;
				if (p <= 0 || p >= 1) continue;
				ctx.strokeStyle = `rgba(20,27,45,${0.35 * (1 - p)})`; ctx.lineWidth = 2;
				ctx.beginPath(); ctx.ellipse(nx, ny, nk * (0.15 + 0.9 * p), nk * (0.12 + 0.7 * p), 0, 0, Math.PI * 2); ctx.stroke();
			}
			const bulge = ctx.createRadialGradient(nx, ny, 0, nx, ny, nk * 0.6);
			bulge.addColorStop(0, `rgba(20,27,45,${0.22 * netFlash})`); bulge.addColorStop(1, "rgba(20,27,45,0)");
			ctx.fillStyle = bulge; ctx.beginPath(); ctx.arc(nx, ny, nk * 0.6, 0, Math.PI * 2); ctx.fill();
			ctx.restore();
		}
		// A trail behind the ball in flight: fire for a cannon or a golden ball.
		const ballTrail = () => {
			if (!shot || t <= 0) return;
			const hot = shot.power >= 0.72 || kick.golden;
			ctx.save();
			for (let i = 10; i >= 1; i--) {
				const tt = Math.min(t, tEnd) - i * 0.018;
				if (tt <= 0 || (t > tEnd + 0.15)) continue;
				const [x, y, z] = ballAt(kick, shot, tt);
				const [sx, sy, k] = project(cam, x, y, z);
				const f = 1 - i / 11, size = BALL_R * k * (0.35 + 0.6 * f);
				ctx.fillStyle = hot ? `hsla(${20 + 30 * f}, 100%, ${55 + 10 * f}%, ${0.55 * f})` : `rgba(255,255,255,${0.28 * f})`;
				ctx.beginPath(); ctx.arc(sx, sy, size, 0, Math.PI * 2); ctx.fill();
			}
			ctx.restore();
		};
		const wallZ = kick.D - WALL_GAP;
		const gold = !!kick.golden;
		if (bp[2] < 0) draw.ball(kick, ...bp, spin, alpha, gold);
		draw.keeper(kp);
		if (bp[2] < wallZ) ballTrail();
		if (bp[2] >= 0 && bp[2] < wallZ) draw.ball(kick, ...bp, spin, alpha, gold);
		const lift = shot && t > 0 ? jumpAt(kick, t) : 0;
		const order = kick.wall.map((x, i) => ({ x, i })).sort((a, b) => Math.abs(b.x - cam.x) - Math.abs(a.x - cam.x));
		for (const { x, i } of order) draw.wallMan(kick, x, lift, i, [4, 7, 8, 5, 11][i]);
		if (bp[2] >= wallZ) { ballTrail(); draw.ball(kick, ...bp, spin, alpha, gold); }
		draw.kicker(kick, phase, RUNUP, after, afterFor);

		// the swipe line, fading after the kick
		if (trail) {
			const age = now - trail.at;
			const a = swipe ? 0.9 : 0.9 * (1 - clamp((age - 600) / 900));
			if (a <= 0) trail = null;
			else {
				ctx.save();
