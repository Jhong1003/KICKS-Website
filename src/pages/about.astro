---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import { pageOgImage } from "../lib/og";
import T from "../components/T.astro";
import BoardSection from "../components/BoardSection.astro";
import aboutImage from "../assets/about.jpg";

// KICKS 2.0 About: who we are + the group photo, what makes KICKS
// different (four cards, facts only, no numbers), and the board. Who-should-join moved
// to the Join page; the Join button is always in the header.
const features = [
	{
		title: "Two leagues",
		titleKo: "리그 두 번",
		description:
			"Each league runs for five Saturdays with 3 or 4 teams. Teams are reshuffled for the next league, so you play with most of the club by the end of the semester.",
		descriptionKo:
			"한 학기에 리그가 두 번 열립니다. 리그마다 3팀이 5주 동안 경기를 하고, 다음 리그에서는 팀을 새로 섞습니다. 그래서 학기가 끝날 때쯤이면 동아리 대부분의 멤버와 함께 뛰어보게 됩니다.",
	},
	{
		title: "Awards night and dinner",
		titleKo: "시상식과 회식",
		description:
			"We end every league with an awards night and a team dinner, and we hold fundraisers and other events during the semester.",
		descriptionKo: "리그가 끝날 때마다 시상식과 팀 회식을 하고, 학기 중에는 펀드레이징 등 다양한 행사도 진행합니다.",
	},
	{
		title: "Friendlies",
		titleKo: "친선전",
		description: "We also play friendly matches against other international student clubs every semester.",
		descriptionKo: "매 학기 다른 유학생 동아리와 친선 경기가 진행됩니다.",
	},
	{
		title: "Every game filmed",
		titleKo: "모든 경기 기록",
		description:
			"We film and photograph every league game. Goals, assists and standings are updated on our website every week.",
		descriptionKo: "모든 리그 경기를 영상과 사진으로 남기고, 골·어시스트·순위는 매주 웹사이트에 업데이트합니다.",
	},
];
---

<BaseLayout ogImage={pageOgImage("about")} title="About | KICKS" description="Learn more about KICKS, UIUC's student-run futsal community. 축구·풋살을 좋아하는 사람들이 모인 UIUC 한인 풋살 동아리.">
	<main class="k-page about">
		<section class="about-intro" aria-labelledby="about-title">
			<div class="about-intro-text">
				<h1 class="k-h1" id="about-title"><T en="About" ko="소개" /></h1>
				<T
					as="p"
					class="about-text"
					en="KICKS (Korean-Inspired Community for Kicking Sports) is a Korean-inspired futsal club at UIUC for students who love soccer and futsal. Every Saturday, we play 7v7 in our own league. Each semester is one season with two leagues, and new teams are formed for each league. We also organize 11v11 matches and friendly games against other international student clubs. Through our weekly games and events, members get to know each other, build friendships, and connect on and off the field."
					ko="KICKS는 축구와 풋살을 좋아하는 UIUC 학생들이 모인 한인 풋살 동아리입니다. 매주 토요일 7대7 리그 경기를 하며, 한 학기에 두 번 리그를 열고 리그마다 팀을 새로 구성합니다. 학기 중에는 11대11 경기와 다른 동아리와의 친선전도 진행합니다. 매주 함께 공을 차고 행사에 참여하면서 서로 가까워질 수 있습니다."
				/>
			</div>
			<div class="about-photo">
				<Image src={aboutImage} alt="KICKS members on the field" width={1400} quality={85} loading="eager" />
			</div>
		</section>

		<section class="k-section" aria-labelledby="different-title">
			<div class="k-section-head">
				<h2 class="k-h2" id="different-title"><T en="What Makes KICKS Different" ko="KICKS만의 특별함" /></h2>
			</div>
			<div class="about-features">
				{
					features.map((feature) => (
						<div class="about-feature k-card">
							<T as="h3" class="k-h3" en={feature.title} ko={feature.titleKo} />
							<T as="p" en={feature.description} ko={feature.descriptionKo} />
						</div>
					))
				}
			</div>
		</section>

		<BoardSection />
	</main>
</BaseLayout>

<style>
	.about-intro {
		display: grid;
		grid-template-columns: minmax(0, 43fr) minmax(0, 57fr);
		align-items: center;
		gap: 48px;
		padding-top: 24px;
	}
	.about-intro-text {
		display: grid;
		gap: 20px;
	}
	:global(.about-text) {
		margin: 0;
		color: #333;
		font-size: 1.02rem;
		line-height: 1.75;
	}
	.about-photo {
		aspect-ratio: 16 / 10;
		overflow: hidden;
		background: #f0f0f0;
	}
	.about-photo :global(img) {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		/* Trim only the grass at the bottom; keep both sides. */
		object-position: center top;
	}

	.about-features {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 20px;
	}
	.about-feature {
		display: grid;
		align-content: start;
		gap: 10px;
		padding: 22px 20px 24px;
		border-top: 3px solid var(--k-olive);
	}
	.about-feature :global(h3) {
		margin: 0;
	}
	.about-feature :global(p) {
		margin: 0;
		color: #444;
		font-size: 0.92rem;
		line-height: 1.6;
	}

	@media (max-width: 980px) {
		.about-features {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}
	@media (max-width: 860px) {
		.about-intro {
			grid-template-columns: 1fr;
			gap: 24px;
			padding-top: 8px;
		}
		.about-photo {
			order: -1;
			margin: 0 calc(var(--k-gutter) * -1);
		}
	}
	@media (max-width: 520px) {
		.about-features {
			grid-template-columns: 1fr;
			gap: 12px;
		}
	}
</style>
