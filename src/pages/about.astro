---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import T from "../components/T.astro";
import aboutImage from "../assets/about.jpg";

const features = [
	{
		title: "Season League with Fixed Teams",
		titleKo: "고정 팀으로 치르는 시즌 리그",
		descriptionKo:
			"멤버들은 3~4개 팀으로 나뉘어 학기 내내 시즌 리그를 치릅니다. 같은 팀원들과 계속 함께 뛰면서 진짜 호흡이 생기고, 학기 중간에 팀을 새로 짜서 더 많은 멤버와 함께 뛸 수 있어요.",
		description:
			"Members are divided into 3–4 teams that compete in a season-long league throughout the semester. Playing with the same teammates builds real chemistry, and teams are reshuffled mid-semester so you get to play with even more members.",
	},
	{
		title: "A Close-Knit Community",
		titleKo: "끈끈한 커뮤니티",
		descriptionKo:
			"단순히 공만 차는 곳이 아니에요. 매주 함께 모여 뛰면서 서로를 알아가고, 오래가는 우정을 만들어갑니다.",
		description:
			"We're more than just a place to play. By showing up and playing together every week, we get to know each other and create lasting friendships.",
	},
	{
		title: "Friendly Matches with Other Teams",
		titleKo: "다른 팀과의 친선경기",
		descriptionKo:
			"UIUC의 여러 유학생 축구·풋살 동아리와 친선경기를 하며, 새로운 사람들을 만나고 축구로 교류할 기회를 만듭니다.",
		description:
			"We play friendly matches against international student soccer and futsal clubs across UIUC, creating chances to meet new people and connect through the game.",
	},
	{
		title: "Every Moment, Captured",
		titleKo: "모든 순간을 기록합니다",
		descriptionKo:
			"풀경기 영상부터 하이라이트까지 모든 경기를 사진과 영상으로 남겨, 필드에서 함께한 순간이 오래 남는 추억이 되도록 합니다.",
		description:
			"We record every match through photos and videos, from full games to highlights, so the moments we share on the field become memories that last.",
	},
];
---

<BaseLayout title="About | KICKS" description="Learn more about KICKS, UIUC's student-run futsal community.">
	<main>
		<section class="content-section" aria-labelledby="about-page-title">
			<div class="about-intro">
				<div class="about-intro-text">
					<p class="section-label">WHO WE ARE</p>
					<h1 id="about-page-title">About KICKS</h1>
					<T
						as="p"
						class="about-description"
						en="KICKS (Korean-Inspired Community for Kicking Sports) is a Korean futsal club at UIUC for people who love the game. Playing together every week, we get to know each other naturally and build a tight-knit team, on and off the field."
						ko="KICKS(Korean-Inspired Community for Kicking Sports)는 풋살을 사랑하는 사람들이 모인 UIUC의 한인 풋살 동아리입니다. 매주 함께 뛰다 보면 자연스럽게 서로를 알게 되고, 필드 안팎에서 끈끈한 팀이 됩니다."
					/>
					<T
						as="p"
						class="about-description"
						en="Because KICKS runs on a competitive season league with fixed teams, we're looking for members with some prior game experience. KICKS is best suited for players who love futsal and want to compete, improve, and grow alongside their teammates."
						ko="KICKS는 고정된 팀으로 치르는 시즌 리그로 운영되기 때문에, 어느 정도 경기 경험이 있는 멤버를 찾고 있어요. 풋살을 좋아하고 팀원들과 함께 경쟁하며 성장하고 싶은 분께 잘 맞는 동아리입니다."
					/>
				</div>
				<div class="split-photo">
					<Image src={aboutImage} alt="KICKS club members playing futsal" width={640} quality={85} />
				</div>
			</div>
		</section>

		<section class="content-section" aria-labelledby="differences-title">
			<h2 id="differences-title">What Makes KICKS Different</h2>
			<div class="feature-grid">
				{
					features.map((feature) => (
						<div class="feature-card">
							<T as="h3" en={feature.title} ko={feature.titleKo} />
							<T as="p" en={feature.description} ko={feature.descriptionKo} />
						</div>
					))
				}
			</div>
		</section>

		<section class="content-section" aria-labelledby="what-we-do-title">
			<h2 id="what-we-do-title">What We Do</h2>
			<ul class="about-list">
				<li><T en="Weekly futsal league" ko="매주 열리는 풋살 리그" /></li>
				<li><T en="Sports events throughout the semester" ko="학기 중 다양한 스포츠 이벤트" /></li>
				<li>
					<T
						en="Social activities: team dinners, BBQs, and watching matches together"
						ko="친목 활동: 팀 회식, 바비큐, 함께 경기 관람"
					/>
				</li>
			</ul>
		</section>

		<section class="content-section" aria-labelledby="who-should-join-title">
			<h2 id="who-should-join-title">Who Should Join</h2>
			<T
				as="p"
				class="about-description"
				en="Freshmen, current students, transfer students, and graduate students are all welcome to apply. If you have game experience, love futsal, and want to compete, stay active, and make great memories in college, we'd love to have you."
				ko="신입생, 재학생, 편입생, 대학원생 모두 지원할 수 있어요. 경기 경험이 있고, 풋살을 좋아하고, 대학 생활 동안 함께 경쟁하며 건강하게 좋은 추억을 만들고 싶다면 언제든 환영합니다."
			/>
			<T as="p" class="about-description">
				<Fragment slot="en">
					Questions? Reach out on Instagram
					<a href="https://www.instagram.com/kicks.uiuc" target="_blank" rel="noopener noreferrer">@kicks.uiuc</a>
				</Fragment>
				<Fragment slot="ko">
					궁금한 점은 인스타그램
					<a href="https://www.instagram.com/kicks.uiuc" target="_blank" rel="noopener noreferrer">@kicks.uiuc</a>로
					연락주세요.
				</Fragment>
			</T>
			<a class="button-primary" href="/join"><T en="Join KICKS" ko="KICKS 가입하기" /></a>
		</section>
	</main>
</BaseLayout>
