---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import StandingsTable from "../components/StandingsTable.astro";
import T from "../components/T.astro";
import TransferBanner from "../components/TransferBanner.astro";
import leagueTable from "../data/league_table.json";
import heroImage from "../assets/hero-wide.jpg";
import scheduleData from "../data/schedule.json";
import transferNews from "../data/transfer-news.json";
import profilesData from "../data/player_profiles.json";
import matchesData from "../data/matches.json";
import { getNextUpEvent, eventTitle, type ScheduleEvent } from "../lib/schedule";
import { formatShortDate } from "../lib/i18n";
import { resolveTransfers, type PlayerProfile } from "../lib/players";
import { latestLeague, getTeamName } from "../lib/leagues";
import { buildGoalCountdown, isCelebratingMilestone, type MatchScore } from "../lib/goals";

const nextUpEvent = getNextUpEvent(scheduleData as ScheduleEvent[]);
// Transfers only make sense within one league (teams are reshuffled between
// leagues), so the banner is tied to the league named in transfer-news.json and
// goes away by itself once a newer league becomes the latest.
const resolvedTransfers = resolveTransfers(transferNews.transfers, profilesData as PlayerProfile[], transferNews.league);
const standings = leagueTable
	.filter((row) => row.league === latestLeague.id)
	.map((row) => ({ ...row, team: getTeamName(row.team_id, latestLeague) }));
const showTransferBanner =
	transferNews.enabled && transferNews.league === latestLeague.id && resolvedTransfers.length > 0;
// Club-wide all-time goals (every league summed). Celebration state is as of
// build time here; the script below re-checks it against the visitor's date.
const goalCountdown = buildGoalCountdown(matchesData as MatchScore[]);
const celebratingMilestone = isCelebratingMilestone(goalCountdown);
---

<BaseLayout
	title="KICKS | UIUC Futsal Community"
	description="UIUC Korean-inspired futsal community · 리그 순위, 선수 기록, 경기 일정"
	header="custom"
>
	<main>
		{
			showTransferBanner && (
				<TransferBanner heading={transferNews.heading} transfers={resolvedTransfers} league={latestLeague} />
			)
		}

		<div class="hero">
			<Header variant="hero" />
			<section class="hero-content" aria-labelledby="hero-title">
				<div class="hero-text">
					<p class="eyebrow">KOREAN FUTSAL CLUB · UIUC</p>
					<h1 id="hero-title">
						Compete together.<br />
						Grow together.
					</h1>
					<T
						as="p"
						class="hero-description"
						en="A competitive season league where fixed teams battle it out every week, and friendships are built on and off the court."
						ko="고정된 팀으로 매주 치열하게 겨루는 시즌 리그, 그리고 코트 안팎에서 쌓여가는 우정."
					/>
					<div class="hero-buttons">
						<a class="hero-button" href="/join">
							<T en="Join KICKS" ko="KICKS 가입하기" />
							<span aria-hidden="true">→</span>
						</a>
						<a class="hero-button hero-button--secondary" href="/league">
							<T en="View Standings" ko="순위 보기" />
							<span aria-hidden="true">→</span>
						</a>
					</div>
					<a
						class="hero-next-up"
						id="hero-next-up"
						href="/schedule"
						data-schedule-events={JSON.stringify(scheduleData)}
						hidden={!nextUpEvent}
					>
						<span class="hero-next-up-dot" aria-hidden="true"></span>
						<span class="hero-next-up-text">
							<strong><T en="Next up" ko="다음 일정" /></strong> ·{" "}
							<span id="hero-next-up-rest">
								{nextUpEvent && (
									<T
										en={`${nextUpEvent.isToday ? "Today" : formatShortDate(nextUpEvent.date!, "en")} · ${eventTitle(nextUpEvent, "en")}`}
										ko={`${nextUpEvent.isToday ? "오늘" : formatShortDate(nextUpEvent.date!, "ko")} · ${eventTitle(nextUpEvent, "ko")}`}
									/>
								)}
							</span>
						</span>
						<span aria-hidden="true">→</span>
					</a>
					{
						goalCountdown.total > 0 && (
							<p
								class:list={["hero-goal-counter", { "hero-goal-counter--celebrate": celebratingMilestone }]}
								id="hero-goal-counter"
								data-countdown={JSON.stringify(goalCountdown)}
							>
								<span class="hero-goal-counter-icon" aria-hidden="true">
									⚽
								</span>
								<span id="hero-goal-counter-default" hidden={celebratingMilestone}>
									<span data-lang="en">
										<strong>{goalCountdown.total} KICKS goals</strong> all-time · {goalCountdown.remaining} to go
										until goal #{goalCountdown.nextMilestone}
									</span>
									<span data-lang="ko" lang="ko">
										KICKS 통산 <strong>{goalCountdown.total}골</strong> · {goalCountdown.nextMilestone}호 골까지{" "}
										{goalCountdown.remaining}골
									</span>
								</span>
								<span id="hero-goal-counter-celebrate" hidden={!celebratingMilestone}>
									<span data-lang="en">
										<strong>KICKS hit {goalCountdown.lastMilestone} all-time goals!</strong> 🎉 ·{" "}
										{goalCountdown.total} so far
									</span>
									<span data-lang="ko" lang="ko">
										<strong>KICKS 통산 {goalCountdown.lastMilestone}골 달성!</strong> 🎉 · 지금까지{" "}
										{goalCountdown.total}골
									</span>
								</span>
							</p>
						)
					}
				</div>
				<div class="split-photo split-photo--hero">
					<Image
						src={heroImage}
						alt="KICKS players in action"
						width={1400}
						quality={85}
					/>
				</div>
			</section>
			<div class="hero-footer">
				<span>Champaign–Urbana, Illinois</span>
				<span>Student-run at UIUC</span>
			</div>
		</div>

		<section class="content-section" aria-labelledby="standings-preview-title">
			<p class="section-label">LEAGUE STANDINGS · {latestLeague.id}</p>
			<h2 id="standings-preview-title">Current League</h2>
			<StandingsTable rows={standings} />
			<a class="section-link" href="/league"><T en="View full league page →" ko="리그 페이지 전체 보기 →" /></a>
		</section>
	</main>
</BaseLayout>

<script>
	import { getNextUpEvent, eventTitle, type ScheduleEvent } from "../lib/schedule";
	import { isCelebratingMilestone, type GoalCountdown } from "../lib/goals";
	import { bilingualHtml, formatShortDate } from "../lib/i18n";

	// The link above reflects "today" as of the last build, which goes stale
	// between deploys. Recompute against the visitor's actual current date
	// and patch the text in place (or hide the link if nothing's upcoming).
	const link = document.getElementById("hero-next-up");
	const raw = link?.dataset.scheduleEvents;
	if (link && raw) {
		const events = JSON.parse(raw) as ScheduleEvent[];
		const next = getNextUpEvent(events);

		link.hidden = !next;
		if (next) {
			const restEl = document.getElementById("hero-next-up-rest");
			if (restEl) {
				restEl.innerHTML = bilingualHtml(
					`${next.isToday ? "Today" : formatShortDate(next.date!, "en")} · ${eventTitle(next, "en")}`,
					`${next.isToday ? "오늘" : formatShortDate(next.date!, "ko")} · ${eventTitle(next, "ko")}`,
				);
			}
		}
	}

	// Same staleness problem for the milestone celebration: whether it was
	// reached "recently" depends on today's date, not the build date.
	const counter = document.getElementById("hero-goal-counter");
	const rawCountdown = counter?.dataset.countdown;
	if (counter && rawCountdown) {
		const celebrate = isCelebratingMilestone(JSON.parse(rawCountdown) as GoalCountdown);
		counter.classList.toggle("hero-goal-counter--celebrate", celebrate);
		const defaultEl = document.getElementById("hero-goal-counter-default");
		const celebrateEl = document.getElementById("hero-goal-counter-celebrate");
		if (defaultEl) defaultEl.hidden = celebrate;
		if (celebrateEl) celebrateEl.hidden = !celebrate;
	}
</script>
