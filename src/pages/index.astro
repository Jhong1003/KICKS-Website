---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import StandingsTable from "../components/StandingsTable.astro";
import T from "../components/T.astro";
import TeamRevealPopup from "../components/TeamRevealPopup.astro";
import TransferBanner from "../components/TransferBanner.astro";
import ChampionPopup from "../components/ChampionPopup.astro";
import EventPopup from "../components/EventPopup.astro";
import leagueTable from "../data/league_table.json";
import scheduleData from "../data/schedule.json";
import transferNews from "../data/transfer-news.json";
import profilesData from "../data/player_profiles.json";
import matchesData from "../data/matches.json";
import reportsData from "../data/reports.json";
import recruitment from "../data/recruitment.json";
import { getNextUpEvent, type ScheduleEvent } from "../lib/schedule";
import { albums } from "../lib/gallery";
import { resolveTransfers, type PlayerProfile } from "../lib/players";
import { latestLeague, currentLeague, getTeamName, getTeamColor, leagueParts } from "../lib/leagues";
import { bannerMode, type BannerMatch } from "../lib/league-banner";
import { getLeagueFinale } from "../lib/finale";
import { buildGoalCountdown, isCelebratingMilestone, type MatchScore } from "../lib/goals";
import { nextUpChipText, monthYear, shortTitle } from "../lib/home-chips";

// KICKS 2.0 homepage, top to bottom: the three newest albums, a row of chips
// (up to three that follow the season + three that are always there), the
// standings, the two mini games. Nothing on it says the same thing twice.

const latestAlbums = albums.slice(0, 3);

// Transfers only make sense within one league (teams are reshuffled between
// leagues), so the banner is tied to the league named in transfer-news.json and
// goes away by itself once a newer league becomes the latest.
const resolvedTransfers = resolveTransfers(transferNews.transfers, profilesData as PlayerProfile[], transferNews.league);
const finale = getLeagueFinale(latestLeague);
const showTransferBanner =
	!finale && transferNews.enabled && transferNews.league === latestLeague.id && resolvedTransfers.length > 0;

const standings = leagueTable
	.filter((row) => row.league === latestLeague.id)
	.map((row) => ({
		...row,
		team: getTeamName(row.team_id, latestLeague),
		color: getTeamColor(row.team_id, latestLeague),
		href: `/league/${latestLeague.id}/team/${row.team_id}/`,
	}));
const latestParts = leagueParts(latestLeague.id);
const playedWeeks = (matchesData as BannerMatch[])
	.filter((match) => match.league === latestLeague.id && match.home_score !== null)
	.reduce((max, match) => Math.max(max, (match as BannerMatch & { week: number }).week), 0);

// ---- Chips that follow the season (at most three, most important first) ----
type Chip = { href: string; en: string; ko: string; id?: string };
const seasonChips: Chip[] = [];

// A club goal milestone in the last few days (src/lib/goals.ts).
const goalCountdown = buildGoalCountdown(matchesData as MatchScore[]);
if (goalCountdown.lastMilestone && isCelebratingMilestone(goalCountdown)) {
	seasonChips.push({
		href: `/league/${latestLeague.id}/`,
		en: `KICKS hit ${goalCountdown.lastMilestone} goals`,
		ko: `KICKS 통산 ${goalCountdown.lastMilestone}골`,
	});
}

// What's next on the calendar. Re-picked in the browser below, since the
// build date goes stale between deploys.
const nextUpEvent = getNextUpEvent(scheduleData as ScheduleEvent[]);
if (nextUpEvent) {
	seasonChips.push({ id: "chip-next-up", href: "/schedule/", en: nextUpChipText(nextUpEvent, "en"), ko: nextUpChipText(nextUpEvent, "ko") });
}

// A finished league: everyone's Wrapped, then the final report slides.
if (finale) {
	seasonChips.push({ href: "/players/", en: `Your ${latestParts.season} Wrapped`, ko: `나의 ${latestParts.season} Wrapped` });
	const reports = (reportsData as Record<string, Record<string, { final: boolean }>>)[latestLeague.id] ?? {};
	const finalWeek = Object.entries(reports).find(([, report]) => report.final)?.[0];
	if (finalWeek) {
		seasonChips.push({
			href: `/league/${latestLeague.id}/report/?week=${finalWeek}`,
			en: `${latestParts.name} final report`,
			ko: `${latestParts.name} 결산 리포트`,
		});
	}
}

// Teams of a new league are in, before its first game.
if (bannerMode(currentLeague.id, matchesData as BannerMatch[]) === "kickoff") {
	const { name } = leagueParts(currentLeague.id);
	seasonChips.push({ href: `/players/?league=${currentLeague.id}`, en: `${name} teams are out`, ko: `${name} 팀 발표` });
}

// Applications open.
if (recruitment.player_status === "open") {
	seasonChips.push({ href: "/join/", en: `${recruitment.season} applications open`, ko: `${recruitment.season} 지원 시작` });
}

// A new album in the last two weeks.
const newestAlbum = albums[0];
if (newestAlbum?.date) {
	const ageDays = (Date.now() - new Date(`${newestAlbum.date}T00:00:00`).getTime()) / 86_400_000;
	if (ageDays >= 0 && ageDays <= 14) {
		seasonChips.push({
			href: `/gallery/${newestAlbum.id}/`,
			en: `New album · ${newestAlbum.title.split(" · ")[0]}`,
			ko: `새 앨범 · ${newestAlbum.titleKo.split(" · ")[0]}`,
		});
	}
}

const alwaysChips: Chip[] = [
	{ href: "/keeper/", en: "Keeper Challenge", ko: "Keeper Challenge" },
	{ href: "/freekick/", en: "Free Kick", ko: "Free Kick" },
	{ href: "/benefits/", en: "Member benefits", ko: "멤버 혜택" },
];
const chips = [...seasonChips.slice(0, 3), ...alwaysChips];
---

<BaseLayout
	title="KICKS | UIUC Korean-Inspired Futsal Community"
	description="KICKS is a student-run, Korean-inspired futsal community at the University of Illinois Urbana-Champaign (UIUC) — weekly league, standings, player stats, and events. 축구를 좋아하는 누구나 함께하는 UIUC 한인 풋살 동아리 — 매주 7대7 풋살 리그와 11대11 이벤트 매치."
>
	<EventPopup />
	<TeamRevealPopup league={currentLeague} />
	<ChampionPopup league={currentLeague} />
	{/* Tells search engines what KICKS is (shown in Google's results/knowledge panel). */}
	<script
		type="application/ld+json"
		set:html={JSON.stringify({
			"@context": "https://schema.org",
			"@type": "SportsOrganization",
			name: "KICKS",
			alternateName: ["Korean-Inspired Community for Kicking Sports", "KICKS UIUC"],
			description: "A student-run, Korean-inspired futsal community at the University of Illinois Urbana-Champaign for anyone who loves soccer: a weekly 7v7 futsal league, plus 11v11 event matches and friendlies with other soccer and futsal clubs.",
			url: "https://kicksuiuc.com/",
			logo: "https://kicksuiuc.com/apple-touch-icon.png",
			sport: "Futsal",
			sameAs: ["https://www.instagram.com/kicks.uiuc", "https://one.illinois.edu/feeds?type=club&type_id=37096&tab=about"],
			location: { "@type": "Place", name: "University of Illinois Urbana-Champaign", address: "Champaign, IL" },
		})}
	/>
	<main class="k-page home">
		{
			showTransferBanner && (
				<TransferBanner
					heading={transferNews.heading}
					headingEn={transferNews.heading_en}
					transfers={resolvedTransfers}
					league={latestLeague}
				/>
			)
		}

		<h1 class="visually-hidden">KICKS · UIUC Korean futsal club</h1>

		{
			latestAlbums.length > 0 && (
				<section class="home-albums" aria-label="Latest photos" data-i18n-attrs={JSON.stringify({ "aria-label": { en: "Latest photos", ko: "최근 사진" } })}>
					{latestAlbums.map((album, index) => (
						<a class="home-album" href={`/gallery/${album.id}/`}>
							<span class="home-album-photo">
								<Image
									src={album.cover.src}
									alt=""
									width={820}
									quality={82}
									loading={index === 0 ? "eager" : "lazy"}
								/>
							</span>
							<span class="home-album-title">
								<T en={album.title} ko={album.titleKo} />
							</span>
							<span class="home-album-meta">
								{album.date && (
									<>
										<T en={monthYear(album.date, "en")} ko={monthYear(album.date, "ko")} />
										<span aria-hidden="true"> · </span>
									</>
								)}
								<T en={`${album.images.length} photos`} ko={`사진 ${album.images.length}장`} />
							</span>
						</a>
					))}
				</section>
			)
		}

		<nav class="home-chips" aria-label="Quick links" data-i18n-attrs={JSON.stringify({ "aria-label": { en: "Quick links", ko: "바로가기" } })}>
			{
				chips.map((chip) => (
					<a class="k-chip" href={chip.href} id={chip.id}>
						<T en={chip.en} ko={chip.ko} />
					</a>
				))
			}
		</nav>
		<script type="application/json" id="chip-schedule" set:html={JSON.stringify(scheduleData)} />

		{
			standings.length > 0 && (
				<section class="home-standings" aria-labelledby="home-standings-title">
					<div class="k-section-head">
						<h2 class="k-h2" id="home-standings-title">
							{finale ? (
								<T en="Final standings" ko="최종 순위" />
							) : (
								<T
									en={`${latestParts.name} · after ${playedWeeks ? `Week ${playedWeeks}` : "kickoff"}`}
									ko={`${latestParts.name} · ${playedWeeks}주차까지`}
								/>
							)}
						</h2>
						<span class="home-standings-side">
							{finale && <span class="k-meta">{latestParts.season} {latestParts.name}</span>}
							<a class="k-link" href={`/league/${latestLeague.id}/`}>
								<T en="League page" ko="리그 페이지" /> →
							</a>
						</span>
					</div>
					<StandingsTable rows={standings} finished={Boolean(finale)} compact />
				</section>
			)
		}

		<section class="k-section home-games" id="mini-games" aria-labelledby="mini-games-title">
			<div class="k-section-head">
				<h2 class="k-h2" id="mini-games-title"><T en="Mini games" ko="미니게임" /></h2>
			</div>
			<div class="home-games-grid">
				<a class="home-game k-card" href="/keeper/">
					<img class="home-game-image" src="/keeper/card.webp" alt="" width="800" height="600" loading="lazy" />
					<span class="home-game-body">
						<span class="k-h3">Keeper Challenge</span>
						<T
							as="span"
							class="home-game-text"
							en="Read the shot, dive at the right moment. Three goals and you're out."
							ko="슈팅 방향을 읽고 타이밍에 맞춰 몸을 날리세요. 세 골을 먹으면 게임이 끝납니다."
						/>
						<span class="home-game-leader k-meta" data-game-leader="/api/keeper" hidden></span>
						<span class="k-btn home-game-button"><T en="Play" ko="플레이" /></span>
					</span>
				</a>
				<a class="home-game k-card" href="/freekick/">
					<img class="home-game-image home-game-image--top" src="/freekick/card.webp" alt="" width="800" height="600" loading="lazy" />
					<span class="home-game-body">
						<span class="k-h3">Free Kick</span>
						<T
							as="span"
							class="home-game-text"
							en="Ten free kicks. Bend them over the wall and past the keeper."
							ko="프리킥 기회는 10번. 수비벽을 넘기고 골키퍼를 피해 감아 차세요."
						/>
						<span class="home-game-leader k-meta" data-game-leader="/api/freekick" hidden></span>
						<span class="k-btn home-game-button"><T en="Play" ko="플레이" /></span>
					</span>
				</a>
			</div>
		</section>
	</main>
</BaseLayout>


<script>
	import { getNextUpEvent, type ScheduleEvent } from "../lib/schedule";
	import { nextUpChipText } from "../lib/home-chips";
	import { bilingualHtml } from "../lib/i18n";

	// Mini game cards: each game's current #1 from its leaderboard.
	// Silent on any failure (no DB locally, offline): the cards work without it.
	for (const leader of document.querySelectorAll<HTMLElement>("[data-game-leader]")) {
		fetch(leader.dataset.gameLeader!, { headers: { Accept: "application/json" } })
			.then((response) => (response.ok ? response.json() : null))
			.then((data: { entries?: { name: string; score: number }[] } | null) => {
				const top = data?.entries?.[0];
				if (!top) return;
				const score = top.score.toLocaleString("en-US");
				leader.innerHTML = bilingualHtml(`#1 ${top.name} · ${score}`, `1위 ${top.name} · ${score}점`);
				leader.hidden = false;
			})
			.catch(() => {});
	}

	// The next-up chip was picked on the build date; pick it again for today.
	const chip = document.getElementById("chip-next-up");
	const raw = document.getElementById("chip-schedule")?.textContent;
	if (chip && raw) {
		const next = getNextUpEvent(JSON.parse(raw) as ScheduleEvent[]);
		if (next) chip.innerHTML = bilingualHtml(nextUpChipText(next, "en"), nextUpChipText(next, "ko"));
		else chip.hidden = true;
	}
</script>

<style>
	.home-albums {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 20px;
	}
	.home-album {
		display: grid;
		gap: 6px;
		min-width: 0;
	}
	.home-album-photo {
		display: block;
		aspect-ratio: 3 / 2;
		overflow: hidden;
		margin-bottom: 6px;
		background: #f0f0f0;
	}
	.home-album-photo :global(img) {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.4s ease;
	}
	.home-album:hover .home-album-photo :global(img) {
		transform: scale(1.03);
	}
	.home-album-title {
		font-family: var(--k-font-display);
		font-size: 1.02rem;
		font-weight: 700;
		letter-spacing: -0.01em;
	}
	.home-album:hover .home-album-title {
		text-decoration: underline;
	}
	.home-album-meta {
		color: var(--k-muted);
		font-size: 0.85rem;
	}

	.home-chips {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		margin: 28px 0 0;
	}

	.home-standings {
		margin-top: 36px;
	}
	.home-standings-side {
		display: inline-flex;
		align-items: baseline;
		gap: 16px;
	}

	.home-games-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 20px;
	}
	.home-game {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
		min-height: 220px;
	}
	.home-game:hover {
		border-color: #cfcfcf;
	}
	.home-game-image {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
	.home-game-image--top {
		object-position: top;
	}
	.home-game-body {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 10px;
		padding: 22px;
	}
	:global(.home-game-text) {
		color: #444;
		font-size: 0.92rem;
		line-height: 1.5;
	}
	.home-game-button {
		margin-top: auto;
	}

	@media (max-width: 860px) {
		.home-albums {
			display: flex;
			gap: 12px;
			margin: 0 calc(var(--k-gutter) * -1);
			padding: 0 var(--k-gutter);
			overflow-x: auto;
			scroll-snap-type: x mandatory;
			scroll-padding: 0 var(--k-gutter);
			scrollbar-width: none;
		}
		.home-albums::-webkit-scrollbar {
			display: none;
		}
		.home-album {
			flex: 0 0 78%;
			scroll-snap-align: start;
		}
		.home-chips {
			flex-wrap: nowrap;
			margin-right: calc(var(--k-gutter) * -1);
			margin-left: calc(var(--k-gutter) * -1);
			padding: 0 var(--k-gutter);
			overflow-x: auto;
			scrollbar-width: none;
		}
		.home-chips::-webkit-scrollbar {
			display: none;
		}
		.home-standings-side .k-meta {
			display: none;
		}
		.home-games-grid {
			grid-template-columns: 1fr;
		}
	}
	@media (max-width: 520px) {
		.home-game {
			grid-template-columns: 1fr;
		}
		.home-game-image {
			aspect-ratio: 16 / 9;
			height: auto;
		}
	}
</style>
