---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import StandingsTable from "../components/StandingsTable.astro";
import leagueTable from "../data/league_table.json";
import heroImage from "../assets/hero.jpg";
import scheduleData from "../data/schedule.json";
import { getNextUpEvent, type ScheduleEvent } from "../lib/schedule";

const nextUpEvent = getNextUpEvent(scheduleData as ScheduleEvent[]);
---

<BaseLayout
	title="KICKS | UIUC Futsal Community"
	description="KICKS is a student-run futsal league and community at UIUC."
	header="custom"
>
	<main>
		<div class="hero">
			<Header variant="hero" />
			<section class="hero-content" aria-labelledby="hero-title">
				<div class="hero-text">
					<p class="eyebrow">KOREAN FUTSAL CLUB · UIUC</p>
					<h1 id="hero-title">
						Compete together.<br />
						Grow together.
					</h1>
					<p class="hero-description">
						A competitive season league where fixed teams battle it out every week,
						and friendships are built on and off the court.
					</p>
					<div class="hero-buttons">
						<a class="hero-button" href="/join">
							Join KICKS
							<span aria-hidden="true">→</span>
						</a>
						<a class="hero-button hero-button--secondary" href="/league">
							View Standings
							<span aria-hidden="true">→</span>
						</a>
					</div>
				</div>
				<div class="split-photo split-photo--hero">
					<Image
						src={heroImage}
						alt="KICKS players in action"
						width={700}
						height={560}
						fit="cover"
						quality={85}
					/>
				</div>
			</section>
			<div class="hero-footer">
				<span>Champaign–Urbana, Illinois</span>
				<span>Student-run at UIUC</span>
			</div>
		</div>

		<section
			class="content-section"
			id="next-up-section"
			aria-labelledby="next-up-title"
			data-schedule-events={JSON.stringify(scheduleData)}
			hidden={!nextUpEvent}
		>
			<p class="section-label">FA26 SEASON</p>
			<h2 id="next-up-title">What's Next</h2>
			<a class="next-up-card" href="/schedule">
				<span class="next-up-label">Next up</span>
				<span class="next-up-body">
					<span class="next-up-date" id="next-up-date">{nextUpEvent?.formattedDate}</span>
					<span class="next-up-title" id="next-up-event-title">{nextUpEvent?.title}</span>
				</span>
				<span class="next-up-link">View full schedule →</span>
			</a>
		</section>

		<section class="content-section" aria-labelledby="standings-preview-title">
			<p class="section-label">LEAGUE STANDINGS</p>
			<h2 id="standings-preview-title">Current Season</h2>
			<StandingsTable rows={leagueTable} />
			<a class="section-link" href="/league">View full league page →</a>
		</section>
	</main>
</BaseLayout>

<script>
	import { getNextUpEvent, type ScheduleEvent } from "../lib/schedule";

	// The card above reflects "today" as of the last build, which goes stale
	// between deploys. Recompute against the visitor's actual current date
	// and patch the text in place (or hide the card if nothing's upcoming).
	const section = document.getElementById("next-up-section");
	const raw = section?.dataset.scheduleEvents;
	if (section && raw) {
		const events = JSON.parse(raw) as ScheduleEvent[];
		const next = getNextUpEvent(events);

		section.hidden = !next;
		if (next) {
			const dateEl = document.getElementById("next-up-date");
			const titleEl = document.getElementById("next-up-event-title");
			if (dateEl) dateEl.textContent = next.formattedDate ?? "";
			if (titleEl) titleEl.textContent = next.title;
		}
	}
</script>
