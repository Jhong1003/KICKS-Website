---
import BaseLayout from "../layouts/BaseLayout.astro";
import PartnerGrid from "../components/PartnerGrid.astro";
import PartnerInquiryForm from "../components/PartnerInquiryForm.astro";
import T from "../components/T.astro";
import partners from "../data/partners.json";
---

<BaseLayout title="Partners | KICKS" description="KICKS partners and sponsorship inquiries.">
	<main>
		<section class="content-section" aria-labelledby="partners-title">
			<p class="section-label"><T en="PARTNERS" ko="파트너" /></p>
			<h1 id="partners-title"><T en="Our Partners" ko="우리의 파트너" /></h1>
			<T
				as="p"
				class="about-description"
				en="Meet the partners who stand with KICKS. Thank you for always supporting us."
				ko="KICKS와 함께하는 파트너들입니다. 언제나 KICKS를 응원해주셔서 진심으로 감사드립니다."
			/>
			<a class="member-benefits-banner" href="/benefits/">
				<span class="member-benefits-text">
					<T class="member-benefits-title" en="KICKS member? Get your benefits here" ko="KICKS 멤버라면 여기서 혜택 받기" />
					<T
						class="member-benefits-sub"
						en="Show your member screen at our partner restaurants. Member code is in the group chat."
						ko="파트너 식당에서 멤버 화면을 보여주세요. 멤버 코드는 단톡방에 있어요."
					/>
				</span>
				<span class="member-benefits-button"><T en="Member Benefits" ko="멤버 혜택" /> →</span>
			</a>
			<PartnerGrid partners={partners} />
		</section>

		<section class="content-section" aria-labelledby="inquiry-title">
			<h2 id="inquiry-title"><T en="Partnership Inquiry" ko="파트너십 문의" /></h2>
			<T
				as="p"
				class="about-description"
				en="Interested in partnering with KICKS? Fill out the form below."
				ko="KICKS와의 파트너십에 관심이 있으신가요? 아래 양식을 작성해주세요."
			/>
			<PartnerInquiryForm />
		</section>
	</main>
</BaseLayout>

<style>
	.member-benefits-banner {
		max-width: 1100px;
		box-sizing: border-box;
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 16px;
		margin: 24px 0 8px;
		padding: 20px 24px;
		border: 1px solid var(--color-sage);
		border-left: 4px solid var(--color-green);
		border-radius: 8px;
		background-color: #fff;
		color: var(--color-dark);
		text-decoration: none;
		transition: border-color 0.15s ease, box-shadow 0.15s ease;
	}

	.member-benefits-banner:hover {
		border-color: var(--color-green);
		box-shadow: 0 6px 16px rgba(41, 41, 41, 0.08);
	}

	.member-benefits-banner:focus-visible {
		outline: 3px solid var(--color-green);
		outline-offset: 2px;
	}

	.member-benefits-text {
		display: flex;
		flex-direction: column;
		gap: 4px;
	}

	.member-benefits-banner :global(.member-benefits-title) {
		font-size: 1.1rem;
		font-weight: 700;
	}

	.member-benefits-banner :global(.member-benefits-sub) {
		font-size: 0.9rem;
		opacity: 0.7;
	}

	.member-benefits-button {
		padding: 10px 20px;
		border-radius: 6px;
		background-color: var(--color-green);
		color: var(--color-background);
		font-weight: 700;
		white-space: nowrap;
	}
</style>
