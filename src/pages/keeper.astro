		font-size: 1rem;
		font-weight: 500;
		color: var(--color-dark);
		text-align: center;
	}
	.keeper-name input:focus { outline: 2px solid var(--color-green); outline-offset: 1px; }
	.keeper-error { min-height: 1.2em; margin: 0; font-size: 0.8rem; color: #b3412e; }
	.keeper-button { border: 0; cursor: pointer; font: inherit; font-weight: 700; }
	.keeper-button:disabled { opacity: 0.6; cursor: progress; }
	.keeper-final {
		margin: 0;
		font-size: clamp(2.6rem, 11vw, 3.6rem);
		font-weight: 800;
		color: var(--color-green);
		font-variant-numeric: tabular-nums;
	}
	.keeper-final-detail, .keeper-final-note { margin: 0; font-size: 0.9rem; }
	.keeper-final-note { min-height: 1.3em; font-weight: 700; }

	.keeper-board { max-width: 640px; margin-top: 44px; }
	.keeper-board h2 { font-size: clamp(1.3rem, 3vw, 1.8rem); }
	.keeper-board-me { margin: 10px 0 0; font-weight: 700; color: var(--color-green); }
	.keeper-board-list { margin: 16px 0 0; padding: 0; list-style: none; }
	/* Rows are built by the script, so they need :global to get these styles. */
	.keeper-board-list :global(li) {
		display: grid;
		grid-template-columns: 2.2em minmax(0, 1fr) auto auto;
		align-items: baseline;
		gap: 12px;
		padding: 10px 0;
		border-bottom: 1px solid rgba(41, 41, 41, 0.08);
	}
	.keeper-board-list :global(.keeper-rank) { font-weight: 800; color: var(--color-green); font-variant-numeric: tabular-nums; }
	.keeper-board-list :global(.keeper-row-name) { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-weight: 600; }
	.keeper-board-list :global(.keeper-row-detail) { font-size: 0.78rem; color: rgba(41, 41, 41, 0.6); }
	.keeper-board-list :global(strong) { font-variant-numeric: tabular-nums; }
	.keeper-board-empty, .keeper-board-note { margin: 14px 0 0; font-size: 0.85rem; color: rgba(41, 41, 41, 0.65); }
	@media (max-width: 420px) { .keeper-board-list :global(.keeper-row-detail) { display: none; } }
</style>
