	.keeper-hud-label {
		color: rgba(41, 41, 41, 0.6);
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}
	.keeper-hud strong { font-variant-numeric: tabular-nums; }
	.keeper-lives { display: inline-flex; gap: 6px; margin-left: auto; }
	.keeper-lives span {
		width: 12px; height: 12px; border-radius: 50%;
		background: var(--color-green);
		transition: background-color 0.2s;
	}
	.keeper-lives span.lost { background: transparent; box-shadow: inset 0 0 0 2px rgba(41, 41, 41, 0.25); }

	/* Canvas and panels share one grid cell, so a tall panel (small phones)
	   grows the stage instead of being clipped by the 4:3 field. */
	.keeper-stage {
		position: relative;
		display: grid;
		overflow: hidden;
		border-radius: 12px;
		background: var(--color-background);
		box-shadow: 0 0 0 1px rgba(41, 41, 41, 0.1);
		touch-action: none;
		user-select: none;
		-webkit-user-select: none;
		-webkit-touch-callout: none;
		outline: none;
	}
	.keeper-stage canvas { grid-area: 1 / 1; align-self: center; display: block; width: 100%; height: auto; aspect-ratio: 4 / 3; }

	.keeper-toast,
	.keeper-countdown {
		position: absolute;
		left: 0; right: 0;
		margin: 0;
		text-align: center;
		pointer-events: none;
		font-weight: 800;
	}
	/* A white pill just under the KICKS board, readable over the net. */
	.keeper-toast {
		top: 14%;
		width: fit-content;
		margin: 0 auto;
		padding: 4px 14px;
		border-radius: 999px;
		background: rgba(255, 255, 255, 0.95);
		box-shadow: 0 2px 8px rgba(20, 27, 45, 0.18);
		font-size: clamp(1rem, 4.2vw, 1.45rem);
		color: #141b2d;
		opacity: 0;
		transform: translateY(-6px);
		transition: opacity 0.15s, transform 0.15s;
	}
	.keeper-toast.show { opacity: 1; transform: none; }
	.keeper-toast[data-kind="perfect"] { color: #ffffff; background: #1d3f9e; }
	.keeper-toast[data-kind="goal"] { color: #ffffff; background: #e31b23; }
	.keeper-toast[data-kind="neutral"] { font-size: 0.95rem; font-weight: 700; }
	/* A navy badge with the logo's red/blue ring, so it never blends into the kit or pitch. */
	.keeper-countdown {
		top: 24%;
		left: 50%;
		right: auto;
		width: clamp(64px, 18vw, 96px);
		aspect-ratio: 1;
		display: grid;
		place-items: center;
		border: clamp(4px, 1.2vw, 6px) solid transparent;
		border-radius: 50%;
		background: linear-gradient(#141b2d, #141b2d) padding-box, linear-gradient(135deg, #e31b23 50%, #1d3f9e 50%) border-box;
		box-shadow: 0 6px 18px rgba(20, 27, 45, 0.35);
		color: #ffffff;
		font-size: clamp(2rem, 9vw, 3.2rem);
		line-height: 1;
		font-variant-numeric: tabular-nums;
		transform: translate(-50%, -50%);
	}
	.keeper-countdown:empty { display: none; }
	.keeper-countdown.pop { animation: keeper-pop 0.6s ease-out; }
	@keyframes keeper-pop {
		0% { transform: translate(-50%, -50%) scale(0.6); opacity: 0; }
		25% { transform: translate(-50%, -50%) scale(1.08); opacity: 1; }
		100% { transform: translate(-50%, -50%) scale(1); opacity: 1; }
	}
	@media (prefers-reduced-motion: reduce) { .keeper-countdown.pop { animation: none; } }

	.keeper-panel {
		grid-area: 1 / 1;
		z-index: 1;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 10px;
		padding: 20px;
		background: rgba(247, 246, 242, 0.94);
		text-align: center;
