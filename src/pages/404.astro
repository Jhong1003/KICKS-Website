---
import BaseLayout from "../layouts/BaseLayout.astro";
import T from "../components/T.astro";

// KICKS 2.0 404: an olive futsal court, a raised flag, "Offside".
// Served for any missing page via wrangler.jsonc assets.not_found_handling.
---

<BaseLayout title="Page not found | KICKS" noindex>
	<main class="k-page nf">
		<section class="nf-pitch" aria-labelledby="nf-title">
			<svg class="nf-lines" viewBox="0 0 1200 520" preserveAspectRatio="none" aria-hidden="true">
				<g fill="none" stroke="rgba(255,255,255,0.22)" stroke-width="2">
					<rect x="20" y="20" width="1160" height="480" />
					<line x1="600" y1="20" x2="600" y2="500" />
					<circle cx="600" cy="260" r="70" />
					<path d="M20 170 h90 a90 90 0 0 1 0 180 h-90" />
					<path d="M1180 170 h-90 a90 90 0 0 0 0 180 h90" />
				</g>
			</svg>
			<div class="nf-content">
				<p class="nf-flag">
					<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 3v18" stroke="#fff" stroke-width="2" /><path d="M6 4h12l-3 4 3 4H6z" fill="#e8c54a" /></svg>
					Offside
				</p>
				<p class="nf-code">404</p>
				<h1 class="nf-title" id="nf-title"><T en="This page doesn't exist." ko="페이지를 찾을 수 없습니다." /></h1>
				<T
					as="p"
					class="nf-text"
					en="The link might be old, or the page moved when the season changed."
					ko="링크가 오래되었거나, 시즌이 바뀌면서 페이지 주소가 바뀌었을 수 있습니다."
				/>
				<div class="nf-buttons">
					<a class="nf-btn nf-btn--main" href="/"><T en="Back to home" ko="홈으로" /></a>
					<a class="nf-btn" href="/schedule/"><T en="Schedule" ko="일정" /></a>
					<a class="nf-btn" href="/league/#table"><T en="League table" ko="리그 순위" /></a>
				</div>
			</div>
		</section>
	</main>
</BaseLayout>

<style>
	.nf-pitch {
		position: relative;
		overflow: hidden;
		min-height: 460px;
		display: grid;
		place-items: center;
		padding: 48px 24px;
		background: var(--k-olive);
		color: #fff;
		text-align: center;
	}
	.nf-lines {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
	}
	.nf-content {
		position: relative;
		display: grid;
		justify-items: center;
		gap: 10px;
	}
	.nf-flag {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		margin: 0;
		padding: 6px 12px;
		border: 1px solid rgba(255, 255, 255, 0.45);
		font-size: 0.85rem;
		font-weight: 700;
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}
	.nf-flag svg {
		width: 18px;
		height: 18px;
	}
	.nf-code {
		margin: 0;
		font-family: var(--k-font-display);
		font-size: 7rem;
		font-weight: 800;
		letter-spacing: -0.04em;
		line-height: 1;
	}
	.nf-title {
		margin: 0;
		font-family: var(--k-font-display);
		font-size: 1.6rem;
		font-weight: 700;
	}
	:global(.nf-text) {
		max-width: 460px;
		margin: 0;
		opacity: 0.85;
	}
	.nf-buttons {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 8px;
		margin-top: 14px;
	}
	.nf-btn {
		padding: 10px 16px;
		border: 1px solid rgba(255, 255, 255, 0.6);
		font-size: 0.9rem;
		font-weight: 700;
	}
	.nf-btn:hover {
		background: rgba(255, 255, 255, 0.12);
	}
	.nf-btn--main {
		border-color: #fff;
		background: #fff;
		color: var(--k-olive);
	}
	.nf-btn--main:hover {
		background: #f0f0f0;
	}
	@media (max-width: 600px) {
		.nf-code {
			font-size: 5rem;
		}
		.nf-title {
			font-size: 1.3rem;
		}
	}
</style>
