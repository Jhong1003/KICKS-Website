---
import BaseLayout from "../layouts/BaseLayout.astro";
import { pageOgImage } from "../lib/og";
import MediaTabs from "../components/MediaTabs.astro";
import T from "../components/T.astro";

// The encrypted data file only exists once someone has run
// scripts/manage_full_matches.mjs at least once. Before that (or right
// after wiping it to start over), there's nothing to decrypt yet — the
// page shows a plain "no videos yet" message instead of a lock screen.
// import.meta.glob (unlike a normal import) doesn't fail the build if the
// file is missing — it just returns an empty object.
const dataFiles = import.meta.glob<{ default: unknown }>("../data/full-matches.enc.json", { eager: true });
const encryptedPayload = Object.values(dataFiles)[0]?.default ?? null;
---

<BaseLayout
	ogImage={pageOgImage("full-matches")}
	title="Full Matches | KICKS"
	description="Members-only full match videos for KICKS."
>
	<main class="k-page">
		<MediaTabs current="videos" />

		<div id="lock-screen" class="fm-lock k-card">
			<svg class="fm-lock-icon" viewBox="0 0 24 24" aria-hidden="true">
				<path
					d="M7 10V7a5 5 0 0 1 10 0v3h1.5A1.5 1.5 0 0 1 20 11.5v9a1.5 1.5 0 0 1-1.5 1.5h-13A1.5 1.5 0 0 1 4 20.5v-9A1.5 1.5 0 0 1 5.5 10H7Zm2 0h6V7a3 3 0 0 0-6 0v3Z"
					fill="currentColor"
				/>
			</svg>
			<h2 class="k-h2 fm-lock-title"><T en="Members only" ko="멤버 전용" /></h2>
			<T
				as="p"
				class="fm-lock-text"
				en="Full match videos are for KICKS members."
				ko="풀경기 영상은 KICKS 멤버만 볼 수 있습니다."
			/>

			<form id="unlock-form" class="fm-form">
				<div class="fm-password">
					<input
						type="password"
						id="password-input"
						class="fm-input"
						placeholder="Password"
						data-i18n-attrs={JSON.stringify({ placeholder: { en: "Password", ko: "비밀번호" } })}
						autocomplete="current-password"
						required
					/>
					<button
						type="button"
						id="toggle-password"
						class="fm-eye"
						aria-label="Show password"
						aria-pressed="false"
					>
						<svg class="eye-icon eye-icon-open" viewBox="0 0 24 24" aria-hidden="true">
							<path
								d="M12 5c-5.5 0-9.5 4.5-10.7 7 1.2 2.5 5.2 7 10.7 7s9.5-4.5 10.7-7c-1.2-2.5-5.2-7-10.7-7Zm0 11.5A4.5 4.5 0 1 1 12 7.5a4.5 4.5 0 0 1 0 9Zm0-7.5a3 3 0 1 0 0 6 3 3 0 0 0 0-6Z"
								fill="currentColor"
							/>
						</svg>
						<svg class="eye-icon eye-icon-closed" viewBox="0 0 24 24" aria-hidden="true">
							<path
								d="m3.3 2.3 18.4 18.4-1.4 1.4-3.1-3.1A11.6 11.6 0 0 1 12 20c-5.5 0-9.5-4.5-10.7-7a15.6 15.6 0 0 1 4.2-5.3L1.9 3.7l1.4-1.4ZM12 7.5c.4 0 .8.05 1.15.14l-1.5 1.5a3 3 0 0 0-3.51 3.51l-1.5 1.5A4.5 4.5 0 0 1 12 7.5Zm0-3.5c5.5 0 9.5 4.5 10.7 7a15.6 15.6 0 0 1-3 3.9l-1.42-1.42A11.9 11.9 0 0 0 20.7 11c-1.2-2.5-5.2-7-8.7-7-1.02 0-2 .16-2.9.44L7.6 3.03A11.6 11.6 0 0 1 12 4Zm-.1 9.86 2.24-2.24a3 3 0 0 1-2.24 2.24Z"
								fill="currentColor"
							/>
						</svg>
					</button>
				</div>
				<button class="k-btn" type="submit"><T en="Unlock" ko="잠금 해제" /></button>
			</form>
			<p id="unlock-error" class="fm-error" hidden>
				<T en="That password didn't work. Please try again." ko="비밀번호가 맞지 않습니다. 다시 입력해주세요." />
			</p>
		</div>

		<div id="video-list" class="fm-list" hidden></div>
		<p id="no-videos-message" class="k-meta" hidden>
			<T en="Videos go up a few days after each league day." ko="영상은 리그 경기 후 며칠 안에 올라옵니다." />
		</p>
	</main>
</BaseLayout>

<script type="application/json" id="full-matches-payload" set:html={JSON.stringify(encryptedPayload)} />

<script>
	import { bilingualHtml, weekLabel } from "../lib/i18n";

	interface FullMatchesPayload {
		kdf: { iterations: number };
		salt: string;
		iv: string;
		ciphertext: string;
	}

	interface VideoEntry {
		// League videos: weeks restart at 1 in every league. Videos saved
		// before leagues existed have no league yet. Event videos
		// (type "event": friendlies, 11v11 event matches) have no league or
		// week — just their own title (see scripts/manage_full_matches.mjs).
		type?: "event";
		league?: string;
		week?: number;
		date: string;
		title: string;
		titleKo?: string;
		driveUrl: string;
	}

	const MONTHS = ["JAN", "FEB", "MAR", "APR", "MAY", "JUN", "JUL", "AUG", "SEP", "OCT", "NOV", "DEC"];

	/** One row: date box (OCT / 31), the match name, Watch. */
	function rowText(video: VideoEntry) {
		if (video.type === "event") return { en: video.title, ko: video.titleKo || video.title };
		const week = video.week ?? 0;
		return { en: weekLabel(week, "en"), ko: weekLabel(week, "ko") };
	}

	// We cache the PASSWORD (not the decrypted videos) so every page load
	// re-decrypts the payload that was just served. Caching the decrypted
	// list instead would keep showing whatever was true at unlock time even
	// after new videos are added and the page is refreshed.
	const STORAGE_KEY = "kicks-full-matches-password";

	const payloadEl = document.getElementById("full-matches-payload");
	const payload: FullMatchesPayload | null = JSON.parse(payloadEl?.textContent ?? "null");

	const lockScreen = document.getElementById("lock-screen") as HTMLDivElement;
	const videoListEl = document.getElementById("video-list") as HTMLDivElement;
	const noVideosEl = document.getElementById("no-videos-message") as HTMLParagraphElement;
	const form = document.getElementById("unlock-form") as HTMLFormElement;
	const passwordInput = document.getElementById("password-input") as HTMLInputElement;
	const errorEl = document.getElementById("unlock-error") as HTMLParagraphElement;
	const togglePasswordButton = document.getElementById("toggle-password") as HTMLButtonElement;

	togglePasswordButton.addEventListener("click", () => {
		const showing = passwordInput.type === "text";
		passwordInput.type = showing ? "password" : "text";
		togglePasswordButton.setAttribute("aria-pressed", String(!showing));
		togglePasswordButton.setAttribute("aria-label", showing ? "Show password" : "Hide password");
	});

	function base64ToBytes(b64: string): Uint8Array<ArrayBuffer> {
		const binary = atob(b64);
		const bytes = new Uint8Array(binary.length);
		for (let i = 0; i < binary.length; i++) bytes[i] = binary.charCodeAt(i);
		return bytes;
	}

	async function deriveKey(password: string, salt: Uint8Array<ArrayBuffer>, iterations: number): Promise<CryptoKey> {
		const keyMaterial = await crypto.subtle.importKey("raw", new TextEncoder().encode(password), "PBKDF2", false, [
			"deriveKey",
		]);
		return crypto.subtle.deriveKey(
			{ name: "PBKDF2", salt, iterations, hash: "SHA-256" },
			keyMaterial,
			{ name: "AES-GCM", length: 256 },
			false,
			["decrypt"]
		);
	}

	async function decryptVideos(password: string, activePayload: FullMatchesPayload): Promise<VideoEntry[]> {
		const key = await deriveKey(password, base64ToBytes(activePayload.salt), activePayload.kdf.iterations);
		const plaintext = await crypto.subtle.decrypt(
			{ name: "AES-GCM", iv: base64ToBytes(activePayload.iv) },
			key,
			base64ToBytes(activePayload.ciphertext)
		);
		return JSON.parse(new TextDecoder().decode(plaintext));
	}

	/**
	 * One heading per league, plus one for the one-off events, rather than a
	 * single run of cards: weeks restart at 1 in every league, so a flat list
	 * sorted by date interleaves two "Week 1"s and the friendlies between them.
	 *
	 * Groups are ordered by their newest video, so the league being played now
	 * is first and finished ones fall behind it by themselves. Events go last
	 * whatever their dates — they are the odd ones out, not a season.
	 */
	const EVENT_GROUP = "__event__";

	function groupVideos(videos: VideoEntry[]) {
		const groups = new Map<string, VideoEntry[]>();
		for (const video of videos) {
			// A video saved before leagues existed has no league; it keeps its
			// own group rather than being filed under one it never belonged to.
			const key = video.type === "event" ? EVENT_GROUP : (video.league ?? "");
			groups.set(key, [...(groups.get(key) ?? []), video]);
		}
		return [...groups.entries()]
			.map(([key, entries]) => ({
				key,
				entries: entries.sort((a, b) => b.date.localeCompare(a.date) || (b.week ?? 0) - (a.week ?? 0)),
			}))
			.sort((a, b) => {
				if ((a.key === EVENT_GROUP) !== (b.key === EVENT_GROUP)) return a.key === EVENT_GROUP ? 1 : -1;
				return b.entries[0].date.localeCompare(a.entries[0].date);
			});
	}

	function groupHeading(key: string) {
		if (key === EVENT_GROUP) return bilingualHtml("Friendlies & events", "친선전·이벤트");
		if (!key) return bilingualHtml("Earlier", "이전 영상");
		// FA26-L2 → "FA26 League 2"
		const [season, part = ""] = key.split("-");
		return /^L\d+$/i.test(part) ? `${season} League ${part.slice(1)}` : key;
	}

	function videoRow(video: VideoEntry) {
		const text = rowText(video);
		const [, month, day] = video.date.split("-").map(Number);
		return `
			<li class="fm-row">
				<span class="fm-date"><span class="fm-month">${MONTHS[month - 1]}</span><span class="fm-day">${day}</span></span>
				<span class="fm-name">${bilingualHtml(text.en, text.ko)}</span>
				<a class="fm-watch" href="${video.driveUrl}" target="_blank" rel="noopener noreferrer">▶ ${bilingualHtml("Watch", "보기")}</a>
			</li>
		`;
	}

	function renderVideos(videos: VideoEntry[]) {
		videoListEl.innerHTML = groupVideos(videos)
			.map(
				(group) => `
					<section class="fm-group">
						<h2 class="fm-group-title">${groupHeading(group.key)}</h2>
						<ol class="fm-rows">${group.entries.map(videoRow).join("")}</ol>
					</section>
				`,
			)
			.join("");
	}

	// No password has ever been set for this page yet (the data file
	// doesn't exist) — nothing to unlock, so skip the lock screen entirely.
	function showNoSetupYet() {
		lockScreen.hidden = true;
		videoListEl.hidden = true;
		noVideosEl.hidden = false;
	}

	function showUnlocked(videos: VideoEntry[]) {
		lockScreen.hidden = true;
		if (videos.length === 0) {
			videoListEl.hidden = true;
			noVideosEl.hidden = false;
			return;
		}
		renderVideos(videos);
		videoListEl.hidden = false;
		noVideosEl.hidden = true;
	}

	async function tryUnlockWith(password: string): Promise<boolean> {
		if (!payload) return false;
		try {
			const videos = await decryptVideos(password, payload);
			showUnlocked(videos);
			return true;
		} catch {
			return false;
		}
	}

	if (!payload) {
		showNoSetupYet();
	} else {
		// If this browser session already unlocked the page, re-decrypt the
		// payload that was just loaded (not a snapshot from last time) using
		// the remembered password, so newly added videos show up right away.
		const cachedPassword = sessionStorage.getItem(STORAGE_KEY);
		if (cachedPassword) {
			tryUnlockWith(cachedPassword).then((ok) => {
				if (!ok) sessionStorage.removeItem(STORAGE_KEY);
			});
		}

		form.addEventListener("submit", async (event) => {
			event.preventDefault();
			errorEl.hidden = true;

			const ok = await tryUnlockWith(passwordInput.value);
			if (ok) {
				sessionStorage.setItem(STORAGE_KEY, passwordInput.value);
			} else {
				errorEl.hidden = false;
				passwordInput.value = "";
				passwordInput.focus();
			}
		});
	}
</script>

<style>
	.fm-lock {
		display: grid;
		justify-items: center;
		gap: 10px;
		max-width: 520px;
		margin: 24px auto 0;
		padding: 40px 32px 36px;
		text-align: center;
	}
	.fm-lock-icon {
		width: 30px;
		height: 30px;
		color: var(--k-olive);
	}
	.fm-lock-title {
		margin-top: 4px;
	}
	:global(.fm-lock-text) {
		margin: 0 0 12px;
		color: #444;
	}
	.fm-form {
		display: flex;
		gap: 8px;
		width: 100%;
	}
	.fm-password {
		position: relative;
		flex: 1;
	}
	.fm-input {
		width: 100%;
		height: 42px;
		padding: 0 44px 0 12px;
		border: 1px solid var(--k-line);
		border-radius: 0;
		font: inherit;
	}
	.fm-input:focus {
		outline: 2px solid var(--k-olive);
		outline-offset: -1px;
	}
	.fm-eye {
		position: absolute;
		top: 50%;
		right: 6px;
		display: grid;
		place-items: center;
		width: 32px;
		height: 32px;
		padding: 0;
		border: 0;
		background: none;
		color: var(--k-muted);
		transform: translateY(-50%);
		cursor: pointer;
	}
	.fm-eye svg {
		width: 18px;
		height: 18px;
	}
	.fm-eye .eye-icon-closed,
	.fm-eye[aria-pressed="true"] .eye-icon-open {
		display: none;
	}
	.fm-eye[aria-pressed="true"] .eye-icon-closed {
		display: block;
	}
	.fm-form .k-btn {
		min-height: 42px;
	}
	.fm-error {
		margin: 4px 0 0;
		color: #b3261e;
		font-size: 0.88rem;
	}

	.fm-list:not([hidden]) {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 32px;
		align-items: start;
	}
	.fm-list :global(.fm-group-title) {
		margin: 0 0 10px;
		font-family: var(--k-font-display);
		font-size: 1.05rem;
		font-weight: 700;
	}
	.fm-list :global(.fm-rows) {
		margin: 0;
		padding: 0;
		list-style: none;
		border-top: 2px solid var(--k-olive);
	}
	.fm-list :global(.fm-row) {
		display: grid;
		grid-template-columns: 46px minmax(0, 1fr) auto;
		gap: 12px;
		align-items: center;
		padding: 10px 0;
		border-bottom: 1px solid var(--k-line);
	}
	.fm-list :global(.fm-date) {
		display: grid;
		justify-items: center;
		padding: 3px 0;
		border: 1px solid var(--k-line);
		line-height: 1.1;
	}
	.fm-list :global(.fm-month) {
		color: var(--k-muted);
		font-size: 0.64rem;
		font-weight: 700;
		letter-spacing: 0.04em;
	}
	.fm-list :global(.fm-day) {
		font-family: var(--k-font-display);
		font-size: 1.05rem;
		font-weight: 700;
	}
	.fm-list :global(.fm-name) {
		font-weight: 600;
		font-size: 0.93rem;
	}
	.fm-list :global(.fm-watch) {
		padding: 6px 10px;
		border: 1px solid var(--k-line);
		font-size: 0.8rem;
		font-weight: 700;
		white-space: nowrap;
	}
	.fm-list :global(.fm-watch:hover) {
		border-color: var(--k-ink);
	}
	@media (max-width: 860px) {
		.fm-list:not([hidden]) {
			grid-template-columns: 1fr;
		}
	}
	@media (max-width: 480px) {
		.fm-lock {
			padding: 32px 20px;
		}
	}
</style>
