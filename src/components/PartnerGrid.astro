---
import T from "./T.astro";

// partners.json's link_label is hand-typed English; the common ones get a
// Korean version here, anything else is shown as written in both languages.
const LINK_LABELS_KO: Record<string, string> = {
	"Visit website": "웹사이트 방문",
	"View on Google Maps": "구글 지도에서 보기",
};

interface Partner {
	partner_id: string;
	name: string;
	logo: string | null;
	logo_scale?: number;
	address?: string;
	url: string | null;
	link_label?: string;
}

interface Props {
	partners: Partner[];
}

const { partners } = Astro.props;
---

<div class="partner-grid">
	{
		partners.map((partner) => (
			<article class="partner-card">
				<div class="partner-logo-area" style={`--logo-scale: ${partner.logo_scale ?? 0.8}`}>
					{
						partner.logo ? (
							<img src={partner.logo} alt={`${partner.name} logo`} loading="lazy" />
						) : (
							<span class="partner-logo-placeholder">{partner.name}</span>
						)
					}
				</div>
				<div class="partner-info">
					<h3 class="partner-name">{partner.name}</h3>
					{partner.address && <p class="partner-address">{partner.address}</p>}
					{
						partner.url && (
							<a class="partner-link" href={partner.url} target="_blank" rel="noopener noreferrer">
								<T
									en={partner.link_label ?? "Visit website"}
									ko={LINK_LABELS_KO[partner.link_label ?? "Visit website"] ?? partner.link_label ?? ""}
								/>{" "}
								→
							</a>
						)
					}
				</div>
			</article>
		))
	}
</div>
