---
import T from "./T.astro";
import { getReadableAccentColor, type ResolvedTransfer } from "../lib/players";
import { getTeamColor, getTeamName, type League } from "../lib/leagues";

interface Props {
	/** Korean label (transfer-news.json "heading"). */
	heading: string;
	/** English label ("heading_en"); falls back to `heading` when missing. */
	headingEn?: string;
	transfers: ResolvedTransfer[];
	league: League;
}

const { heading, headingEn, transfers, league } = Astro.props;

const teamTextColor = (teamId: string) => getReadableAccentColor(getTeamColor(teamId, league));
---

<div class="transfer-banner" id="transfer-banner">
	<div class="transfer-banner-inner">
		<span class="transfer-banner-label"><T en={headingEn ?? heading} ko={heading} /></span>
		<div class="transfer-banner-list">
			{
				transfers.map((transfer) => (
					<div class="transfer-chip">
						<a class="transfer-chip-name" href={`/players/${transfer.playerId}`}>
							{transfer.playerName}
						</a>
						<span class="transfer-chip-team" style={`color: ${teamTextColor(transfer.fromTeamId)}`}>
							{getTeamName(transfer.fromTeamId, league)}
						</span>
						<span class="transfer-chip-arrow" aria-hidden="true">
							→
						</span>
						<span class="transfer-chip-team" style={`color: ${teamTextColor(transfer.toTeamId)}`}>
							{getTeamName(transfer.toTeamId, league)}
						</span>
					</div>
				))
			}
		</div>
		<button class="transfer-banner-close" type="button" aria-label="Dismiss transfer news">
			✕
		</button>
	</div>
</div>

<script>
	// Dismissal only lasts the current browsing session (sessionStorage, not
	// localStorage): closing hides it for the rest of this visit, but a
	// fresh visit later (new tab/browser session) sees it again.
	const DISMISSED_KEY = "kicks-transfer-banner-dismissed";
	const banner = document.getElementById("transfer-banner");

	if (banner) {
		if (sessionStorage.getItem(DISMISSED_KEY) === "1") {
			banner.hidden = true;
		}

		banner.querySelector(".transfer-banner-close")?.addEventListener("click", () => {
			banner.hidden = true;
			sessionStorage.setItem(DISMISSED_KEY, "1");
		});
	}
</script>
