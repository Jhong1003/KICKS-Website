---
import T from "./T.astro";

interface StandingsRow {
	rank: number;
	team: string;
	played: number;
	wins: number;
	draws: number;
	losses: number;
	goals_for: number;
	goals_against: number;
	goal_difference: number;
	points: number;
	participation_rate: number;
	/** The team's page (/league/<league>/team/<team_id>), when the caller knows the league. */
	href?: string;
}

interface Props {
	rows: StandingsRow[];
	/** Every fixture has a score: rank 1 is then the champion (co-champions on a full tie). */
	finished?: boolean;
	/** Before the first result: show every team at zero without ranks or participation. */
	placeholder?: boolean;
}

const { rows, finished = false, placeholder = false } = Astro.props;

const columns = [
	["Rank", "순위"],
	["Team", "팀"],
	["Pts", "승점"],
	["P", "경기"],
	["W", "승"],
	["D", "무"],
	["L", "패"],
	["GF", "득점"],
	["GA", "실점"],
	["GD", "득실"],
	["Participation", "참여율"],
] as const;
---

<div class="table-scroll">
	<table class="standings-table">
		<thead>
			<tr>
				{
					columns.map(([en, ko]) => (
						<th>
							<T en={en} ko={ko} />
						</th>
					))
				}
			</tr>
		</thead>
		<tbody>
			{
				rows.map((row) => (
					<tr class:list={{ "standings-champion": finished && row.rank === 1 }}>
						<td>
							{placeholder ? (
								"–"
							) : rows.filter((other) => other.rank === row.rank).length > 1 ? (
								<T en={`T-${row.rank}`} ko={`공동 ${row.rank}`} />
							) : (
								row.rank
							)}
						</td>
						<td class="team-name">
							{finished && row.rank === 1 ? (
								<span class="standings-champion-name">
									<span aria-hidden="true">🏆</span> {row.href ? <a class="team-link" href={row.href}>{row.team}</a> : row.team}
									<span class="standings-champion-chip">
										<T en="Champion" ko="우승" />
									</span>
								</span>
							) : row.href ? (
								<a class="team-link" href={row.href}>{row.team}</a>
							) : (
								row.team
							)}
						</td>
						<td class="points">{row.points}</td>
						<td>{row.played}</td>
						<td>{row.wins}</td>
						<td>{row.draws}</td>
						<td>{row.losses}</td>
						<td>{row.goals_for}</td>
						<td>{row.goals_against}</td>
						<td>{row.goal_difference}</td>
						<td>{placeholder ? "–" : `${(row.participation_rate * 100).toFixed(1)}%`}</td>
					</tr>
				))
			}
		</tbody>
	</table>
</div>

<style>
	.standings-table th:nth-child(3) { color: var(--color-green); }
	@media (max-width: 767px) {
		.standings-table { border-collapse: separate; border-spacing: 0; }
		.standings-table th, .standings-table td { padding: 12px 8px; }
		.standings-table th:nth-child(1), .standings-table td:nth-child(1) {
			position: sticky;
			left: 0;
			width: 56px;
			min-width: 56px;
			max-width: 56px;
			background: var(--color-background);
			z-index: 2;
		}
		.standings-table th:nth-child(2), .standings-table td:nth-child(2) {
			position: sticky;
			left: 56px;
			min-width: 135px;
			background: var(--color-background);
			z-index: 2;
			box-shadow: 2px 0 0 var(--color-sage);
		}
		.standings-table tr.standings-champion td:nth-child(-n+2) { background: #f6edcd; }
	}
</style>
