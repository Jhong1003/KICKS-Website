---
import T from "./T.astro";

interface StandingsRow {
	rank: number;
	team: string;
	played: number;
	wins: number;
	draws: number;
	losses: number;
	goals_for: number;
	goals_against: number;
	goal_difference: number;
	points: number;
	participation_rate: number;
}

interface Props {
	rows: StandingsRow[];
}

const { rows } = Astro.props;

const columns = [
	["Rank", "순위"],
	["Team", "팀"],
	["P", "경기"],
	["W", "승"],
	["D", "무"],
	["L", "패"],
	["GF", "득점"],
	["GA", "실점"],
	["GD", "득실"],
	["Pts", "승점"],
	["Participation", "참여율"],
] as const;
---

<div class="table-scroll">
	<table class="standings-table">
		<thead>
			<tr>
				{
					columns.map(([en, ko]) => (
						<th>
							<T en={en} ko={ko} />
						</th>
					))
				}
			</tr>
		</thead>
		<tbody>
			{
				rows.map((row) => (
					<tr>
						<td>
							{rows.filter((other) => other.rank === row.rank).length > 1 ? (
								<T en={`T-${row.rank}`} ko={`공동 ${row.rank}`} />
							) : (
								row.rank
							)}
						</td>
						<td class="team-name">{row.team}</td>
						<td>{row.played}</td>
						<td>{row.wins}</td>
						<td>{row.draws}</td>
						<td>{row.losses}</td>
						<td>{row.goals_for}</td>
						<td>{row.goals_against}</td>
						<td>{row.goal_difference}</td>
						<td class="points">{row.points}</td>
						<td>{(row.participation_rate * 100).toFixed(1)}%</td>
					</tr>
				))
			}
		</tbody>
	</table>
</div>
