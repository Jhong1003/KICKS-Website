---
import T from "./T.astro";

interface StandingsRow {
	rank: number;
	team: string;
	played: number;
	wins: number;
	draws: number;
	losses: number;
	goals_for: number;
	goals_against: number;
	goal_difference: number;
	points: number;
	participation_rate: number;
	/** The team's page (/league/<league>/team/<team_id>), when the caller knows the league. */
	href?: string;
	/** Team color (#rrggbb) for the square before the name. */
	color?: string;
	/** Last few results, oldest first, for the Form column. */
	form?: ("W" | "D" | "L")[];
}

interface Props {
	rows: StandingsRow[];
	/** Every fixture has a score: rank 1 is then the champion (co-champions on a full tie). */
	finished?: boolean;
	/** Before the first result: show every team at zero without ranks or participation. */
	placeholder?: boolean;
	/** Fewer columns (the homepage): #, team, P, W, D, L, GD, Pts. */
	compact?: boolean;
}

const { rows, finished = false, placeholder = false, compact = false } = Astro.props;

const showForm = !compact && rows.some((row) => row.form && row.form.length > 0);
const FORM_KO = { W: "승", D: "무", L: "패" };
const signed = (value: number) => (value > 0 ? `+${value}` : String(value));
const isTied = (row: StandingsRow) => rows.filter((other) => other.rank === row.rank).length > 1;
---

<div class="k-table-wrap">
	<table class:list={["k-table", "k-standings", { "k-standings--compact": compact }]}>
		<thead>
			<tr>
				<th class="k-left">#</th>
				<th class="k-left"><T en="Team" ko="팀" /></th>
				<th><T en="P" ko="경기" /></th>
				<th class="k-hide-phone"><T en="W" ko="승" /></th>
				<th class="k-hide-phone"><T en="D" ko="무" /></th>
				<th class="k-hide-phone"><T en="L" ko="패" /></th>
				{!compact && <th class="k-hide-phone"><T en="GF" ko="득점" /></th>}
				{!compact && <th class="k-hide-phone"><T en="GA" ko="실점" /></th>}
				<th><T en="GD" ko="득실" /></th>
				{!compact && <th class="k-hide-phone"><T en="Part." ko="참여율" /></th>}
				<th class="k-standings-pts"><T en="Pts" ko="승점" /></th>
				{showForm && <th class="k-standings-form"><T en="Form" ko="최근 경기" /></th>}
			</tr>
		</thead>
		<tbody>
			{
				rows.map((row) => {
					const champion = finished && row.rank === 1;
					return (
						<tr>
							<td class="k-left k-standings-rank">
								{placeholder ? "–" : isTied(row) ? <T en={`T${row.rank}`} ko={`공동 ${row.rank}`} /> : row.rank}
							</td>
							<td class="k-left">
								<span class="k-standings-team" style={row.color ? `--team-color: ${row.color}` : undefined}>
									<span class="k-team-dot" aria-hidden="true" />
									{row.href ? (
										<a class="k-team-link" href={row.href}>
											{row.team}
										</a>
									) : (
										row.team
									)}
									{champion && (
										<span class="k-standings-champion">
											<T en="Champion" ko="우승" />
										</span>
									)}
								</span>
							</td>
							<td>{row.played}</td>
							<td class="k-hide-phone">{row.wins}</td>
							<td class="k-hide-phone">{row.draws}</td>
							<td class="k-hide-phone">{row.losses}</td>
							{!compact && <td class="k-hide-phone">{row.goals_for}</td>}
							{!compact && <td class="k-hide-phone">{row.goals_against}</td>}
							<td>{signed(row.goal_difference)}</td>
							{!compact && <td class="k-hide-phone">{placeholder ? "–" : `${(row.participation_rate * 100).toFixed(1)}%`}</td>}
							<td class="k-standings-pts k-strong">{row.points}</td>
							{showForm && (
								<td class="k-standings-form">
									<span class="k-form">
										{(row.form ?? []).map((result) => (
											<span class={`k-form-${result}`} title={result}>
												<T en={result} ko={FORM_KO[result]} />
											</span>
										))}
									</span>
								</td>
							)}
						</tr>
					);
				})
			}
		</tbody>
	</table>
</div>

<style>
	.k-standings-rank {
		width: 44px;
		color: var(--k-muted);
		font-weight: 600;
	}
	.k-standings-team {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		font-weight: 600;
	}
	.k-standings-champion {
		padding: 2px 7px;
		border: 1px solid #b8892b;
		color: #8a6418;
		font-size: 0.7rem;
		font-weight: 700;
		letter-spacing: 0.03em;
		text-transform: uppercase;
	}
	.k-standings-pts {
		width: 64px;
	}
	td.k-standings-pts {
		font-size: 1.05rem;
	}
	.k-form {
		display: inline-flex;
		gap: 3px;
	}
	.k-form > span {
		display: grid;
		place-items: center;
		width: 20px;
		height: 20px;
		color: #fff;
		font-size: 0.68rem;
		font-weight: 700;
	}
	.k-form-W {
		background: #2e8b57;
	}
	.k-form-D {
		background: #9a9a9a;
	}
	.k-form-L {
		background: #c8423b;
	}
	/* Phone: # · team · P · GD · Pts · Form, so points never fall off the edge. */
	@media (max-width: 600px) {
		.k-hide-phone {
			display: none;
		}
		.k-standings-champion {
			display: none;
		}
		.k-table th,
		.k-table td {
			padding-right: 7px;
			padding-left: 7px;
		}
	}
</style>
