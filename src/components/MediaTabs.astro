---
// KICKS 2.0 Media header, shared by the photo list and Full matches:
// "Media" + the season picker, then underline tabs Photos | Full matches
// (Full matches is members-only, so it carries a small lock).
import T from "./T.astro";
import SeasonSelect from "./SeasonSelect.astro";

interface Props {
	current: "photos" | "videos";
}

const { current } = Astro.props;
---

<div class="k-page-head media-head">
	<h1 class="k-h1"><T en="Media" ko="미디어" /></h1>
	<SeasonSelect />
</div>
<nav class="k-tabs" aria-label="Photos or full matches" data-i18n-attrs={JSON.stringify({ "aria-label": { en: "Photos or full matches", ko: "사진 또는 풀경기" } })}>
	<a href="/gallery/" aria-current={current === "photos" ? "page" : undefined}><T en="Photos" ko="사진" /></a>
	<a href="/full-matches/" aria-current={current === "videos" ? "page" : undefined}>
		<T en="Full matches" ko="풀경기" />
		<svg class="k-tabs-lock" viewBox="0 0 16 16" aria-hidden="true">
			<path
				d="M4.5 7V5a3.5 3.5 0 0 1 7 0v2h.75c.414 0 .75.336.75.75v5.5a.75.75 0 0 1-.75.75h-8.5a.75.75 0 0 1-.75-.75v-5.5c0-.414.336-.75.75-.75H4.5Zm1.5 0h4V5a2 2 0 0 0-4 0v2Z"
				fill="currentColor"></path>
		</svg>
	</a>
</nav>

<style>
	.media-head {
		margin-bottom: 18px;
	}
	.k-tabs-lock {
		width: 12px;
		height: 12px;
		margin-left: 2px;
		opacity: 0.6;
	}
</style>
