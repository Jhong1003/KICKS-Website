---
// "Match Forecasts": this league's latest published win/draw/loss forecasts
// (src/lib/forecasts.ts). Read-only — the published record is the CSV in the
// repo, committed before each week's Friday-night deadline.
import T from "./T.astro";
import { getTeamColor, getTeamName, type League } from "../lib/leagues";
import { MODEL_LABELS, latestForecastWeek, percent } from "../lib/forecasts";
import { getReadableAccentColor } from "../lib/players";
import { orderLikeFixtures, type Fixture } from "../lib/forecast-order";
import matchesData from "../data/matches.json";

interface Props {
	league: League;
}

const { league } = Astro.props;
const forecastWeek = latestForecastWeek(league.id);
// Same order and home/away as that week's fixtures on the Sheet (display only).
const latest = forecastWeek && {
	...forecastWeek,
	pairings: orderLikeFixtures(forecastWeek.pairings, matchesData as Fixture[], league.id, forecastWeek.week),
};
---

{
	latest && (
		<section class="content-section match-forecasts" id="forecasts" aria-labelledby="forecasts-title">
			<h2 id="forecasts-title"><T en="Match Forecasts" ko="경기 예측" /></h2>
			<T
				as="p"
				class="about-description"
				en={`Win / draw / loss forecasts for week ${latest.week}.`}
				ko={`${latest.week}주차 경기의 승·무·패 예측 확률입니다.`}
			/>
			<div class="forecast-list">
				{latest.pairings.map((pairing) => {
					const colorA = getTeamColor(pairing.teamA, league);
					const colorB = getTeamColor(pairing.teamB, league);
					const nameA = getTeamName(pairing.teamA, league);
					const nameB = getTeamName(pairing.teamB, league);
					return (
						<div class="forecast-pairing">
							<p class="forecast-teams">
								<span style={`color: ${getReadableAccentColor(colorA)}`}>{nameA}</span>
								<span class="forecast-vs">vs</span>
								<span style={`color: ${getReadableAccentColor(colorB)}`}>{nameB}</span>
							</p>
							{pairing.rows.map((row) => (
								<div class="forecast-row">
									{pairing.rows.length > 1 && (
										<p class="forecast-model">
											<T en={MODEL_LABELS[row.model].en} ko={MODEL_LABELS[row.model].ko} />
										</p>
									)}
									<div
										class="forecast-bar"
										role="img"
										aria-label={`${nameA} ${percent(row.pA)}, draw ${percent(row.pDraw)}, ${nameB} ${percent(row.pB)}`}
									>
										<span style={`width: ${row.pA * 100}%; background-color: ${colorA}`} />
										<span class="forecast-bar-draw" style={`width: ${row.pDraw * 100}%`} />
										<span style={`width: ${row.pB * 100}%; background-color: ${colorB}`} />
									</div>
									<div class="forecast-numbers">
										<span>{nameA} <strong>{percent(row.pA)}</strong></span>
										<span><T en="Draw" ko="무승부" /> <strong>{percent(row.pDraw)}</strong></span>
										<span>{nameB} <strong>{percent(row.pB)}</strong></span>
									</div>
								</div>
							))}
						</div>
					);
				})}
			</div>
			{
				latest.pairings.every((pairing) => pairing.rows.every((row) => row.model === "baseline")) && (
					<T
						as="p"
						class="forecast-note"
						en="No results from this league yet, so every pairing has the same forecast. From week 2, this league's results are included."
						ko="아직 이번 리그 경기 결과가 없어서 모든 대진의 예측이 같아요. 2주차부터는 이번 리그 경기 결과를 반영합니다."
					/>
				)
			}
			<details class="forecast-method">
				<summary><T en="Forecast method" ko="예측 방법" /></summary>
				<dl>
					<dt><T en="Baseline (week 1)" ko="기본 예측 (1주차)" /></dt>
					<dd><T en="Last league's draw rate; the rest split evenly" ko="지난 리그 무승부 비율을 쓰고, 나머지는 두 팀이 반씩" /></dd>
					<dt><T en="Poisson model (from week 2)" ko="포아송 모델 (2주차부터)" /></dt>
					<dd><T en="Team strength from this league's goals → win / draw / loss chances" ko="이번 리그 득실점으로 팀 전력 계산 → 승·무·패 확률" /></dd>
				</dl>
			</details>
		</section>
	)
}

<style>
	.forecast-list { max-width: 700px; margin-top: 1.75rem; }
	.forecast-pairing { padding: 1rem 0; border-bottom: 1px solid var(--color-sage); }
	.forecast-teams { display: flex; align-items: baseline; gap: .6rem; margin: 0 0 .6rem; font-weight: 600; }
	.forecast-vs { font-size: .75rem; font-weight: 500; opacity: .55; }
	.forecast-row + .forecast-row { margin-top: .8rem; }
	.forecast-model { margin: 0 0 .35rem; font-size: .75rem; opacity: .65; }
	.forecast-bar { display: flex; height: .6rem; background: var(--color-sage); }
	.forecast-bar span { display: block; height: 100%; }
	.forecast-bar-draw { background-color: #b9b9b2; }
	.forecast-numbers { display: flex; justify-content: space-between; gap: .75rem; margin-top: .4rem; font-size: .85rem; font-variant-numeric: tabular-nums; }
	.forecast-numbers span:nth-child(2) { text-align: center; }
	.forecast-numbers span:last-child { text-align: right; }
	.forecast-note { max-width: 700px; margin: 1rem 0 0; font-size: .8rem; opacity: .75; }
	.forecast-method { max-width: 700px; margin: 1rem 0 0; font-size: .85rem; }
	.forecast-method summary { cursor: pointer; color: var(--color-green); font-weight: 600; }
	.forecast-method dl { margin: .75rem 0 0; padding: .75rem 1rem; border: 1px solid var(--color-sage); border-radius: 8px; background: #fff; }
	.forecast-method dt { margin-top: .75rem; font-weight: 700; }
	.forecast-method dt:first-child { margin-top: 0; }
	.forecast-method dd { margin: .25rem 0 0; line-height: 1.6; }
</style>
