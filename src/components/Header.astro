---
import T from "./T.astro";

// KICKS 2.0 header: EN | 한 on the left, the black logo in the middle,
// Join KICKS on the right, one row of menu links under them, then the olive
// notice strip. On a phone the menu folds into ☰ and Join KICKS stays out.
//
// `also` lists other paths that light up the same menu item. Full Matches
// isn't its own item: Media (/gallery) covers it with Photos | Full matches
// tabs. Dream Team sits under Players, Member benefits under Partners.
const navLinks: { href: string; label: string; labelKo: string; also?: string[] }[] = [
	{ href: "/about", label: "About", labelKo: "소개" },
	{ href: "/league", label: "League", labelKo: "리그" },
	{ href: "/players", label: "Players", labelKo: "선수", also: ["/dream-team"] },
	{ href: "/schedule", label: "Schedule", labelKo: "일정" },
	{ href: "/gallery", label: "Media", labelKo: "미디어", also: ["/full-matches"] },
	{ href: "/hall-of-fame", label: "Hall of Fame", labelKo: "명예의 전당" },
	{ href: "/partners", label: "Partners", labelKo: "파트너", also: ["/benefits"] },
];

// Only in the phone menu, under "More": pages with no menu item of their own.
const moreLinks: { href: string; label: string; labelKo: string }[] = [
	{ href: "/benefits/", label: "Member benefits", labelKo: "멤버 혜택" },
	{ href: "/#mini-games", label: "Mini games", labelKo: "미니게임" },
	{ href: "/dream-team/", label: "Dream Team", labelKo: "드림팀" },
];

const currentPath = Astro.url.pathname;
const isCurrent = (link: (typeof navLinks)[number]) =>
	[link.href, ...(link.also ?? [])].some((path) => currentPath === path || currentPath.startsWith(`${path}/`));
const onJoin = currentPath === "/join" || currentPath.startsWith("/join/");
---

<header class="k-header">
	<div class="k-header-top">
		<button class="k-menu-toggle" type="button" aria-expanded="false" aria-controls="k-menu" aria-label="Menu">
			<span></span><span></span><span></span>
		</button>

		<button class="k-lang" type="button" data-lang-toggle aria-label="Switch language / 언어 변경">
			<span data-lang-option="en">EN</span>
			<span class="k-lang-divider" aria-hidden="true">|</span>
			<span data-lang-option="ko">한</span>
		</button>

		<a class="brand k-brand" href="/" aria-label="KICKS home">
			<img src="/kicks-logo-black.webp" alt="KICKS" width="900" height="328" />
		</a>

		<a class="k-join" href="/join/" aria-current={onJoin ? "page" : undefined}>
			<T en="Join KICKS" ko="KICKS 신청하기" />
		</a>
	</div>

	<nav class="k-nav" id="k-menu" aria-label="Main navigation">
		<ul class="k-nav-list">
			{
				navLinks.map((link) => (
					<li>
						<a href={`${link.href}/`} aria-current={isCurrent(link) ? "page" : undefined}>
							<T en={link.label} ko={link.labelKo} />
						</a>
					</li>
				))
			}
		</ul>
		<div class="k-nav-more">
			<p class="k-nav-more-title"><T en="More" ko="더보기" /></p>
			<ul>
				{
					moreLinks.map((link) => (
						<li>
							<a href={link.href}><T en={link.label} ko={link.labelKo} /></a>
						</li>
					))
				}
			</ul>
			<button class="k-lang k-lang--menu" type="button" data-lang-toggle aria-label="Switch language / 언어 변경">
				<span data-lang-option="en">EN</span>
				<span class="k-lang-divider" aria-hidden="true">|</span>
				<span data-lang-option="ko">한</span>
			</button>
		</div>
	</nav>
</header>

<div class="k-notice">
	<T en="UIUC's Korean futsal club · 7v7 every Saturday" ko="UIUC 한인 풋살 동아리 · 매주 토요일 7대7" />
</div>

<div class="easter-egg-overlay" id="logo-easter-egg" role="status" hidden>
	<div class="easter-egg">
		<span class="season-hide-halloween"><span data-lang="en">Welcome to KICKS, the best futsal club at UIUC&nbsp;</span><span data-lang="ko" lang="ko">UIUC 최고의 풋살 동아리, KICKS에 오신 걸 환영합니다&nbsp;</span><span class="easter-egg-ball" aria-hidden="true">⚽</span></span>
		{/* During the Halloween theme (src/lib/season-theme.ts) the egg says this instead */}
		<span class="season-only season-only--halloween"><span><span data-lang="en">Happy Halloween from KICKS, the spookiest futsal club at UIUC&nbsp;</span><span data-lang="ko" lang="ko">UIUC에서 제일 으스스한 풋살 동아리 KICKS가 해피 할로윈을 외칩니다&nbsp;</span><span class="easter-egg-ball" aria-hidden="true">🎃</span></span></span>
	</div>
</div>

<script>
	// EN | 한 switch. The actual switching lives in BaseLayout.astro's inline
	// script (window.kicksSetLang), which also picked the starting language.
	document.querySelectorAll<HTMLButtonElement>("[data-lang-toggle]").forEach((button) =>
		button.addEventListener("click", () => {
			const next = document.documentElement.lang === "ko" ? "en" : "ko";
			(window as unknown as { kicksSetLang: (lang: string, remember: boolean) => void }).kicksSetLang(next, true);
		}),
	);

	// Phone menu (☰). Above the phone breakpoint the menu is always shown as
	// the one-row nav, so the open state only matters below it.
	const toggle = document.querySelector<HTMLButtonElement>(".k-menu-toggle");
	const menu = document.getElementById("k-menu");
	function closeMenu(restoreFocus = false) {
		if (!menu?.classList.contains("is-open")) return;
		menu.classList.remove("is-open");
		document.documentElement.classList.remove("k-menu-open");
		toggle?.setAttribute("aria-expanded", "false");
		if (restoreFocus) toggle?.focus();
	}

	toggle?.addEventListener("click", () => {
		const isOpen = menu?.classList.toggle("is-open") ?? false;
		document.documentElement.classList.toggle("k-menu-open", isOpen);
		toggle.setAttribute("aria-expanded", isOpen ? "true" : "false");
	});
	menu?.addEventListener("click", (event) => {
		if ((event.target as Element).closest("a")) closeMenu();
	});
	document.addEventListener("keydown", (event) => {
		if (event.key === "Escape" && menu?.classList.contains("is-open")) {
			event.preventDefault();
			closeMenu(true);
		}
	});
	matchMedia("(min-width: 861px)").addEventListener("change", () => closeMenu());
	window.addEventListener("pagehide", () => closeMenu());

	// Logo easter egg: 5 clicks within 3 seconds. Click timestamps live in
	// sessionStorage (not a plain in-memory counter) so the count survives
	// the real page navigation every normal click already does — only the
	// 5th, pattern-completing click gets intercepted (preventDefault) to
	// show the message instead of navigating; clicks 1-4 are completely
	// untouched, real link clicks, exactly like before.
	const brand = document.querySelector<HTMLAnchorElement>(".brand");
	const easterEgg = document.getElementById("logo-easter-egg");

	const CLICK_WINDOW_MS = 3000;
	const CLICKS_NEEDED = 5;
	const AUTO_DISMISS_MS = 3000;
	const FADE_MS = 350; // matches the CSS transition duration below
	const CLICKS_STORAGE_KEY = "kicks-logo-click-times";

	let dismissTimer: ReturnType<typeof setTimeout> | undefined;
	let hideTimer: ReturnType<typeof setTimeout> | undefined;

	function showEasterEgg() {
		if (!easterEgg) return;
		clearTimeout(hideTimer);
		easterEgg.hidden = false;
		easterEgg.classList.remove("easter-egg-overlay--visible");
		// Force a style flush before adding the class so the transition
		// (backdrop fade + card bounce-in) actually plays instead of
		// jumping straight to visible.
		requestAnimationFrame(() => {
			requestAnimationFrame(() => easterEgg.classList.add("easter-egg-overlay--visible"));
		});

		clearTimeout(dismissTimer);
		dismissTimer = setTimeout(hideEasterEgg, AUTO_DISMISS_MS);
	}

	function hideEasterEgg() {
		if (!easterEgg || easterEgg.hidden) return;
		clearTimeout(dismissTimer);
		easterEgg.classList.remove("easter-egg-overlay--visible");
		hideTimer = setTimeout(() => {
			easterEgg.hidden = true;
		}, FADE_MS);
	}

	easterEgg?.addEventListener("click", hideEasterEgg);

	brand?.addEventListener("click", (event) => {
		const now = Date.now();
		let timestamps: number[] = [];
		try {
			timestamps = JSON.parse(sessionStorage.getItem(CLICKS_STORAGE_KEY) ?? "[]");
		} catch {
			timestamps = [];
		}
		timestamps = timestamps.filter((time) => now - time < CLICK_WINDOW_MS);
		timestamps.push(now);

		if (timestamps.length >= CLICKS_NEEDED) {
			sessionStorage.removeItem(CLICKS_STORAGE_KEY);
			event.preventDefault();
			showEasterEgg();
		} else {
			sessionStorage.setItem(CLICKS_STORAGE_KEY, JSON.stringify(timestamps));
		}
	});
</script>
