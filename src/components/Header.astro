---
interface Props {
	variant?: "hero" | "default";
}

const { variant = "default" } = Astro.props;

const navLinks = [
	{ href: "/about", label: "About" },
	{ href: "/league", label: "League" },
	{ href: "/players", label: "Players" },
	{ href: "/schedule", label: "Schedule" },
	{ href: "/gallery", label: "Gallery" },
	{ href: "/full-matches", label: "Full Matches", locked: true },
	{ href: "/partners", label: "Partners" },
	{ href: "/join", label: "Join", cta: true },
];

const currentPath = Astro.url.pathname;
---

<header class={variant === "hero" ? "site-header" : "site-header site-header--bar"}>
	<a class="brand" href="/" aria-label="KICKS home">
		<img class="brand-logo" src="/kicks-logo white.jpg" alt="KICKS" />
	</a>

	<nav class="nav-list" id="site-nav" aria-label="Main navigation">
		{
			navLinks.map((link) => (
				<a
						href={link.href}
						class={link.cta ? "nav-cta" : undefined}
						aria-current={currentPath === link.href ? "page" : undefined}
					>
					{link.label}
					{link.locked && (
						<svg class="nav-lock-icon" viewBox="0 0 16 16" aria-hidden="true">
							<path
								d="M4.5 7V5a3.5 3.5 0 0 1 7 0v2h.75c.414 0 .75.336.75.75v5.5a.75.75 0 0 1-.75.75h-8.5a.75.75 0 0 1-.75-.75v-5.5c0-.414.336-.75.75-.75H4.5Zm1.5 0h4V5a2 2 0 0 0-4 0v2Z"
								fill="currentColor"
							/>
						</svg>
					)}
				</a>
			))
		}
	</nav>

	<span class="season-label">FA26 SEASON</span>

	<button
		class="nav-toggle"
		type="button"
		aria-expanded="false"
		aria-controls="site-nav"
		aria-label="Toggle menu"
	>
		<span class="nav-toggle-bar"></span>
		<span class="nav-toggle-bar"></span>
		<span class="nav-toggle-bar"></span>
	</button>
</header>

<script>
	const toggle = document.querySelector<HTMLButtonElement>(".nav-toggle");
	const nav = document.getElementById("site-nav");

	toggle?.addEventListener("click", () => {
		const isOpen = nav?.classList.toggle("is-open");
		toggle.setAttribute("aria-expanded", isOpen ? "true" : "false");
	});

	nav?.addEventListener("click", (event) => {
		if ((event.target as HTMLElement).tagName === "A") {
			nav.classList.remove("is-open");
			toggle?.setAttribute("aria-expanded", "false");
		}
	});
</script>
