---
import T from "./T.astro";
---

<dialog id="welcome-popup" aria-labelledby="welcome-title" aria-describedby="welcome-description">
	<div class="welcome-panel">
		<button class="welcome-close" type="button" aria-label="Close welcome popup" data-i18n-attrs={JSON.stringify({ "aria-label": { en: "Close welcome popup", ko: "환영 팝업 닫기" } })} data-welcome-close autofocus>
			<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
				<path d="m6 6 12 12M18 6 6 18" />
			</svg>
		</button>
		<div class="welcome-copy">
			<p class="welcome-brand">KICKS · UIUC</p>
			<h2 id="welcome-title" lang="en"><T><Fragment slot="en">WELCOME<br />TO KICKS.</Fragment><Fragment slot="ko">WELCOME<br />TO KICKS</Fragment></T></h2>
			<p class="welcome-subtitle"><T en="The new home of KICKS is here." ko="새로운 KICKS 웹사이트를 만나보세요." /></p>
			<p id="welcome-description"><T><Fragment slot="en">Follow the league. Meet the players.<br />Explore the moments that make KICKS.</Fragment><Fragment slot="ko">경기 결과부터 선수 기록, KICKS의 다양한 순간까지<br />이곳에서 모두 확인할 수 있습니다.</Fragment></T></p>
			<p class="welcome-meta">FA26 · UIUC · FUTSAL</p>
			<div class="welcome-preference">
				<label><input type="checkbox" id="welcome-hide" /> <span><T en="Don't show this again" ko="다시 보지 않기" /></span></label>
			</div>
		</div>
	</div>
</dialog>

<script>
	const dialog = document.querySelector<HTMLDialogElement>("#welcome-popup");
	// The former dismissal key did not represent explicit consent; do not reuse it.
	const storageKey = "kicks-welcome-hidden";
	const sessionKey = "kicks-welcome-session-dismissed";
	let dismissed = false;
	try { dismissed = localStorage.getItem(storageKey) === "1"; } catch { /* Storage may be disabled. */ }

	try { dismissed ||= sessionStorage.getItem(sessionKey) === "1"; } catch { /* Storage may be disabled. */ }

	if (dialog && !dismissed) {
		const body = document.body;
		const scrollX = window.scrollX;
		const scrollY = window.scrollY;
		const previousStyle = body.getAttribute("style");
		const previousFocus = document.activeElement;
		// Fixed positioning also prevents background touch scrolling on mobile.
		const scrollbarWidth = window.innerWidth - document.documentElement.clientWidth;
		const paddingRight = parseFloat(getComputedStyle(body).paddingRight);
		Object.assign(body.style, {
			position: "fixed", top: `-${scrollY}px`, left: `-${scrollX}px`,
			width: "100%", overflow: "hidden", paddingRight: `${paddingRight + scrollbarWidth}px`,
		});

		const dismiss = () => {
			dialog.close();
			if (dialog.querySelector<HTMLInputElement>("#welcome-hide")?.checked) {
				try { localStorage.setItem(storageKey, "1"); } catch { /* Closing still works without storage. */ }
			}
			try { sessionStorage.setItem(sessionKey, "1"); } catch { /* Closing still works without storage. */ }
			if (previousStyle === null) body.removeAttribute("style");
			else body.setAttribute("style", previousStyle);
			window.scrollTo({ left: scrollX, top: scrollY, behavior: "instant" });
			if (previousFocus instanceof HTMLElement) previousFocus.focus({ preventScroll: true });
		};
		dialog.querySelectorAll("[data-welcome-close]").forEach(button => button.addEventListener("click", dismiss));
		dialog.addEventListener("cancel", event => { event.preventDefault(); dismiss(); });
		dialog.addEventListener("keydown", event => {
			if (event.key !== "Tab") return;
			const controls = dialog.querySelectorAll<HTMLElement>("button, input");
			const first = controls[0];
			const last = controls[controls.length - 1];
			if (event.shiftKey && document.activeElement === first) {
				event.preventDefault(); last.focus();
			} else if (!event.shiftKey && document.activeElement === last) {
				event.preventDefault(); first.focus();
			}
		});
		// Require both ends of the click to be outside, so dragging from the card does not close it.
		let startedOutside = false;
		const isOutside = (event: MouseEvent) => {
			const rect = dialog.getBoundingClientRect();
			return event.clientX < rect.left || event.clientX > rect.right || event.clientY < rect.top || event.clientY > rect.bottom;
		};
		dialog.addEventListener("pointerdown", event => { startedOutside = isOutside(event); });
		dialog.addEventListener("click", event => { if (startedOutside && isOutside(event)) dismiss(); });

		dialog.showModal();
	}
</script>

<style>
	dialog {
		width: min(560px, calc(100% - 32px));
		max-width: none;
		max-height: calc(100dvh - 32px);
		margin: auto;
		/* Translation uses the dialog's own height; keep 16px above it on short screens.
		   The separate translate property leaves the entrance scale animation intact. */
		translate: 0 clamp(-36px, calc(50% - 50dvh + 16px), 0px);
		padding: 0;
		border: 1px solid rgba(63, 81, 40, 0.25);
		border-radius: 6px;
		color: var(--color-green);
		background: var(--color-background);
		overscroll-behavior: contain;
	}
	dialog::backdrop { background: rgba(20, 29, 14, 0.4); }
	.welcome-panel { position: relative; }
	.welcome-copy { padding: clamp(28px, 5vw, 40px); }
	.welcome-brand, .welcome-meta {
		font-size: 0.68rem;
		font-weight: 700;
		letter-spacing: 0.16em;
	}
	.welcome-brand { margin: 0 48px 40px 0; }
	h2 {
		margin: 0;
		font-size: clamp(2.6rem, 8.6vw, 4.75rem);
		line-height: 0.95;
		letter-spacing: -0.055em;
	}
	.welcome-subtitle { margin: 28px 0 12px; font-size: clamp(1rem, 3vw, 1.15rem); font-weight: 600; line-height: 1.4; }
	#welcome-description { margin: 0; color: var(--color-dark); font-size: 0.9rem; line-height: 1.7; }
	.welcome-meta { margin: 32px 0 24px; opacity: 0.7; }
	.welcome-preference { border-top: 1px solid rgba(63, 81, 40, 0.2); padding-top: 16px; }
	label { display: inline-flex; align-items: center; gap: 10px; min-height: 32px; font-size: 0.78rem; cursor: pointer; }
	input { width: 16px; height: 16px; margin: 0; accent-color: var(--color-green); cursor: pointer; }
	.welcome-close {
		position: absolute;
		top: 16px;
		right: 16px;
		display: grid;
		place-items: center;
		width: 44px;
		height: 44px;
		border: 1px solid transparent;
		border-radius: 6px;
		color: inherit;
		background: transparent;
		cursor: pointer;
	}
	.welcome-close:hover { background: var(--color-sage); }
	.welcome-close:focus-visible, input:focus-visible { outline: 2px solid var(--color-green); outline-offset: 3px; }
	@media (prefers-reduced-motion: no-preference) {
		dialog[open] { animation: welcome-in 160ms ease-out; }
		@keyframes welcome-in { from { opacity: 0; transform: scale(0.98); } to { opacity: 1; transform: scale(1); } }
	}
</style>
