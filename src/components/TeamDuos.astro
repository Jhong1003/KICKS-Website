---
// "Duos" on a team page: the pairs inside this team who have combined for the
// most goals, one assisting the other. Numbers from src/lib/duos.ts, which
// ignores which way round the pass went and keeps quiet until the team has
// enough assisted goals for a pair to mean anything — so this component simply
// renders nothing early in a league, and never renders at all for a league
// recorded as weekly totals (FA26-L1).
//
// It is on the team page and not on a player page on purpose: /players never
// ranks one player against another.
import T from "./T.astro";

export interface DuoPlayer {
	/** The URL slug, for /players/<id>. */
	id: string;
	name: string;
}

interface Props {
	duos: { players: [DuoPlayer, DuoPlayer]; goals: number }[];
	leagueId: string;
	color: string;
}

const { duos, leagueId, color } = Astro.props;
const href = (player: DuoPlayer) => `/players/${player.id}?league=${leagueId}`;
---

{
	duos.length > 0 && (
		<ol class="duo-list" style={`--team-color: ${color}`}>
			{duos.map((duo) => (
				<li class="duo">
					<span class="duo-pair">
						<a href={href(duo.players[0])}>{duo.players[0].name}</a>
						<span class="duo-join" aria-hidden="true">⇄</span>
						<a href={href(duo.players[1])}>{duo.players[1].name}</a>
					</span>
					<span class="duo-goals">
						<b>{duo.goals}</b>
						<T en={duo.goals === 1 ? "goal" : "goals"} ko="골 합작" />
					</span>
				</li>
			))}
		</ol>
	)
}

<style>
	.duo-list { list-style: none; margin: 0; padding: 0; max-width: 540px; }

	.duo { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: 0.9rem 0; border-bottom: 1px solid var(--color-sage); }

	.duo:last-child { border-bottom: 0; }

	.duo-pair { display: flex; align-items: center; gap: 0.7rem; flex-wrap: wrap; font-weight: 600; }

	.duo-pair a { color: inherit; text-decoration: none; border-bottom: 2px solid transparent; }

	.duo-pair a:hover, .duo-pair a:focus-visible { border-bottom-color: var(--team-color); }

	/* The arrow carries no meaning of its own — the pair is unordered — so it
	   stays quiet and is hidden from screen readers. */
	.duo-join { color: var(--team-color); font-size: 0.9rem; opacity: 0.8; }

	.duo-goals { display: flex; align-items: baseline; gap: 0.35rem; white-space: nowrap; font-size: 0.85rem; opacity: 0.75; }

	.duo-goals b { font-size: 1.25rem; font-variant-numeric: tabular-nums; opacity: 1; }
</style>
