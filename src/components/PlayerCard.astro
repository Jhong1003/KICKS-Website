---
import {
	BADGES,
	getContrastingTextColor,
	getReadableAccentColor,
	type PlayerLeagueSection,
	type PlayerProfile,
} from "../lib/players";

interface Props {
	player: PlayerProfile;
	/** The league section this card shows (stats, tag, badges, team). */
	section: PlayerLeagueSection;
	/** Display name of section.current_team_id (joined from leagues.json by the page). */
	teamName: string;
	teamColor: string;
	size?: "default" | "large";
	href?: string;
	avatarPhoto?: string;
}

const { player, section, teamName, teamColor, size = "default", href, avatarPhoto } = Astro.props;
const Tag = href ? "a" : "div";
const avatarTextColor = getContrastingTextColor(teamColor);
const labelColor = getReadableAccentColor(teamColor);
const cardStyle = `--team-color: ${teamColor}; --team-avatar-text: ${avatarTextColor}; --team-label-color: ${labelColor};`;
---

<Tag
	class={`player-card player-card--${size}`}
	href={href}
	style={cardStyle}
	data-name={player.name}
	data-team={teamName}
>
	<div class="player-card-header">
		<span class="player-card-tag">{section.play_style_tag}</span>
		<span class="player-card-team">{teamName}</span>
	</div>

	<div class="player-card-avatar">
		{avatarPhoto ? <img src={avatarPhoto} alt="" /> : <span aria-hidden="true">{player.avatar_initials}</span>}
	</div>

	<p class="player-card-name">{player.name}</p>

	<div class="player-card-stats">
		<div class="player-card-stat">
			<span class="player-card-stat-value">{section.season_totals.goals}</span>
			<span class="player-card-stat-label">Goals</span>
		</div>
		<div class="player-card-stat">
			<span class="player-card-stat-value">{section.season_totals.assists}</span>
			<span class="player-card-stat-label">Assists</span>
		</div>
		<div class="player-card-stat">
			<span class="player-card-stat-value">{section.season_totals.weeks_attended}</span>
			<span class="player-card-stat-label">Weeks</span>
		</div>
	</div>

	<div class="player-card-badges">
		{
			section.badges.map((key) => (
				<span class="player-card-badge" title={BADGES[key].label} aria-label={BADGES[key].label}>
					{BADGES[key].icon}
				</span>
			))
		}
	</div>
</Tag>
