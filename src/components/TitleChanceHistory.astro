---
// "Title Chances by Week": the title chances KICKS published before each
// league week (forecasts/title_forecasts.csv, protocol v2 §4.3), one line per
// team. These are the frozen, committed numbers — unlike the live percentages
// above them in the same section, which are recalculated on every page load.
// No scores or interpretation here — that lives on GitHub.
// Shown once a league has at least two published weeks.
//
// Rendered *inside* ChampionshipSimulator's "Title Chances" section (a div
// with an h3, not a section of its own), so the page has one Title Chances
// block: where things stand now, then how that number has moved week by week.
//
// Identity is never color alone: each team also gets a marker shape and a
// direct label, like the points-race chart.
import T from "./T.astro";
import { getTeamColor, getTeamName, type League } from "../lib/leagues";
import { titleHistory } from "../lib/forecasts";

interface Props {
	league: League;
}

const { league } = Astro.props;
const history = titleHistory(league.id);
const SHAPES = ["circle", "square", "diamond"] as const;
const teams = league.teams.map((team, index) => ({
	id: team.team_id,
	name: getTeamName(team.team_id, league),
	color: getTeamColor(team.team_id, league),
	shape: SHAPES[index % SHAPES.length],
}));

const W = 440;
// Tall enough that two teams a few points apart don't draw on top of each
// other. The block is pulled up by the same amount it grows (CHART_LIFT below),
// so the 50% line stays level with the middle team's row in the column beside
// it and the heading rises instead.
const H = 210;
const plot = { left: 38, right: 72, top: 12, bottom: 28 };
const innerW = W - plot.left - plot.right;
const innerH = H - plot.top - plot.bottom;
const weeks = Array.from({ length: league.rules.weeks }, (_, i) => i + 1);
const x = (week: number) => plot.left + (weeks.length === 1 ? innerW / 2 : ((week - 1) / (weeks.length - 1)) * innerW);
const y = (p: number) => plot.top + (1 - p) * innerH;
const series = teams.map((team) => {
	const points = history.filter((entry) => team.id in entry.chances).map((entry) => ({ week: entry.week, p: entry.chances[team.id], cx: x(entry.week), cy: y(entry.chances[team.id]) }));
	return { ...team, points, path: points.map((pt, i) => `${i ? "L" : "M"}${pt.cx.toFixed(1)},${pt.cy.toFixed(1)}`).join(" ") };
});
// End-of-line labels, nudged apart so they never overlap.
const labels = series
	.filter((team) => team.points.length)
	.map((team) => ({ name: team.name, color: team.color, x: team.points[team.points.length - 1].cx + 10, y: team.points[team.points.length - 1].cy }))
	.sort((a, b) => a.y - b.y);
// Minimum gap between two labels, a little over the font size below, so the
// nudge only moves a label as far as it has to and each one stays near its line.
const LABEL_GAP = 12;
for (let i = 1; i < labels.length; i++)
	if (labels[i].y - labels[i - 1].y < LABEL_GAP) labels[i].y = labels[i - 1].y + LABEL_GAP;
const diamond = (cx: number, cy: number, s: number) => `${cx},${cy - s} ${cx + s},${cy} ${cx},${cy + s} ${cx - s},${cy}`;
const pct = (p: number) => `${Math.round(p * 100)}%`;
---

{
	history.length >= 2 && (
		<div class="title-history" aria-labelledby="title-history-title">
			<h4 id="title-history-title"><T en="By week" ko="주차별 변화" /></h4>
			<div class="title-history-chart">
				<svg viewBox={`0 0 ${W} ${H}`} role="img" aria-labelledby="title-history-title">
					<g class="title-history-grid" aria-hidden="true">
						{[0, 0.25, 0.5, 0.75, 1].map((tick) => (
							<>
								<line x1={plot.left} x2={W - plot.right} y1={y(tick)} y2={y(tick)} />
								<text x={plot.left - 6} y={y(tick)} text-anchor="end" dominant-baseline="middle">{pct(tick)}</text>
							</>
						))}
						{weeks.map((week) => (
							<text x={x(week)} y={H - 10} text-anchor="middle">
								<tspan data-lang="en">{`W${week}`}</tspan>
								<tspan data-lang="ko">{`${week}주`}</tspan>
							</text>
						))}
					</g>
					{series.map((team) => (
						<g aria-hidden="true">
							<path class="title-history-line" d={team.path} stroke={team.color} />
							{team.points.map((pt) =>
								team.shape === "square" ? (
									<rect class="title-history-marker" x={pt.cx - 4.5} y={pt.cy - 4.5} width="9" height="9" rx="1" fill={team.color} />
								) : team.shape === "diamond" ? (
									<polygon class="title-history-marker" points={diamond(pt.cx, pt.cy, 5.8)} fill={team.color} />
								) : (
									<circle class="title-history-marker" cx={pt.cx} cy={pt.cy} r="4.5" fill={team.color} />
								),
							)}
						</g>
					))}
					{labels.map((label) => (
						<text class="title-history-label" x={label.x} y={label.y} dominant-baseline="middle">{label.name}</text>
					))}
				</svg>
			</div>
			<table class="title-history-table">
				<caption><T en="Published title chances before each week" ko="매주 경기 전에 공개한 우승 확률" /></caption>
				<thead>
					<tr>
						<th scope="col"><T en="Team" ko="팀" /></th>
						{history.map((entry) => <th scope="col"><T en={`Week ${entry.week}`} ko={`${entry.week}주차`} /></th>)}
					</tr>
				</thead>
				<tbody>
					{series.map((team) => (
						<tr>
							<th scope="row">{team.name}</th>
							{history.map((entry) => <td>{team.id in entry.chances ? pct(entry.chances[team.id]) : "—"}</td>)}
						</tr>
					))}
				</tbody>
			</table>
		</div>
	)
}

<style>
	/* Sits beside Title Chances in that block's grid, so no top margin of its
	   own; it drops below on a narrow screen, where the grid's row gap spaces it. */
	.title-history { min-width: 0; }

	/* CHART_LIFT: side by side, the block starts above the heading next to it by
	   half of what the plot grew, which keeps the 50% gridline on the middle
	   team's row. Stacked, it sits where it falls. */
	@media (min-width: 760px) {
		.title-history { margin-top: -30px; }
	}
	/* Same line box as the Title Chances heading it sits beside (global.css). */
	.title-history h4 { margin: 0 0 .9rem; font-size: .85rem; line-height: 1.5rem; font-weight: 700; opacity: .7; }
	.title-history-chart { max-width: 560px; }
	.title-history-chart svg { display: block; width: 100%; height: auto; overflow: visible; }
	.title-history-grid line { stroke: rgba(41, 41, 41, 0.1); stroke-width: 1; }
	.title-history-grid text { fill: rgba(41, 41, 41, 0.55); font-size: 10px; }
	.title-history-line { fill: none; stroke-width: 2; stroke-linejoin: round; stroke-linecap: round; }
	.title-history-marker { stroke: var(--color-background); stroke-width: 2; }
	.title-history-label { font-size: 10px; font-weight: 600; fill: var(--color-dark); }
	/* The chart already shows these numbers; the table is the same data a second
	   time, so it is kept for screen readers and taken off the page. */
	.title-history-table { position: absolute; width: 1px; height: 1px; margin: -1px; padding: 0; overflow: hidden; clip: rect(0 0 0 0); clip-path: inset(50%); white-space: nowrap; border: 0; }
	.title-history-table caption { text-align: left; }
	.title-history-table th, .title-history-table td { padding: .35rem .5rem; border-bottom: 1px solid var(--color-sage); text-align: right; }
	.title-history-table th:first-child { text-align: left; }
</style>
