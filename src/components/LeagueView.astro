---
import ChampionshipSimulator from "./ChampionshipSimulator.astro";
import StandingsTable from "./StandingsTable.astro";
import WeeklyResults from "./WeeklyResults.astro";
import PlayerStatsTable from "./PlayerStatsTable.astro";
import leagueTableData from "../data/league_table.json";
import matchesData from "../data/matches.json";
import weekSummariesData from "../data/week_summaries.json";
import leaderboardData from "../data/player_leaderboard.json";
import profilesData from "../data/player_profiles.json";
import { leagues, getTeamName, type League } from "../lib/leagues";

interface Props {
	league: League;
}

interface MatchRecord {
	league: string;
	match_id: string;
	week: number;
	round: number;
	date: string;
	home_team_id: string | null;
	away_team_id: string | null;
	home_score: number | null;
	away_score: number | null;
	status: "completed" | "scheduled";
}

const { league } = Astro.props;

// Everything on this page is one league's data — weeks restart at 1 in each
// league and nothing is combined across leagues. The points/W-D-L rule lives
// only in scripts/update_data.py; this is just grouping already-computed data.
function inLeague<T extends { league: string }>(rows: T[]): T[] {
	return rows.filter((row) => row.league === league.id);
}

// The generated JSON only carries ids (team_id, player_id); names are joined
// back in here, once, so the table/result components just render them.
const teamName = (teamId: string | null) => getTeamName(teamId, league);
const playerNames = new Map(profilesData.map((profile) => [profile.player_id, profile.name]));

const standings = inLeague(leagueTableData).map((row) => ({ ...row, team: teamName(row.team_id) }));
const matches = inLeague(matchesData as MatchRecord[]).map((match) => ({
	...match,
	home_team: teamName(match.home_team_id),
	away_team: teamName(match.away_team_id),
}));
const weekSummaries = inLeague(weekSummariesData).map((row) => ({ ...row, team: teamName(row.team_id) }));
const leaderboard = inLeague(leaderboardData)
	.filter((player) => player.status !== "inactive")
	.map((row, index) => ({
		...row,
		// Rank only visible players, preserving the pipeline's ranking order.
		rank: index + 1,
		player: playerNames.get(row.player_id) ?? row.player_id,
		team: teamName(row.team_id),
	}));

// Most recent week first, so the results section can show one tab per week,
// each broken down by round.
const weekNumbers = [...new Set(matches.map((match) => match.week))].sort((a, b) => b - a);

const weeks = weekNumbers.map((week) => {
	const weekMatches = matches.filter((match) => match.week === week);
	return {
		week,
		date: weekMatches[0].date,
		hasResults: weekMatches.some((match) => match.status === "completed"),
		rounds: [...new Set(weekMatches.map((match) => match.round))].sort((a, b) => a - b),
		matches: weekMatches,
		summary: weekSummaries.filter((row) => row.week === week).sort((a, b) => b.points - a.points),
	};
});

// Only used when weeks is non-empty (the results section is skipped otherwise).
const defaultWeek = weeks.find((week) => week.hasResults)?.week ?? weeks[0]?.week ?? 0;
---

<main data-league-view>
	<section class="content-section" aria-labelledby="league-title">
		<p class="section-label">{league.id}</p>
		<h1 id="league-title">Standings & Results</h1>

		{
			leagues.length > 1 && (
				<nav class="league-switcher" aria-label="Leagues">
					{leagues.map((entry) => (
						<a
							class="league-switcher-link"
							href={`/league/${entry.id}`}
							aria-current={entry.id === league.id ? "page" : undefined}
						>
							{entry.id}
							{!entry.started && <span class="league-switcher-note">upcoming</span>}
						</a>
					))}
				</nav>
			)
		}
		<nav class="league-subnav" aria-label="League sections">
			<a id="overview-tab" href="#overview" data-league-tab="overview">OVERVIEW</a>
			<a id="player-stats-tab" href="#player-stats" data-league-tab="player-stats">PLAYER STATS</a>
		</nav>
	</section>

	<div id="overview" data-league-panel>
	<section class="content-section" aria-labelledby="standings-title">
		<h2 id="standings-title">League Table</h2>
		{
			standings.length > 0 ? (
				<StandingsTable rows={standings} />
			) : (
				<p class="about-description">The table appears once the first match has been played.</p>
			)
		}
	</section>

	<section class="content-section" id="results" aria-labelledby="results-title">
		<h2 id="results-title">Match Results</h2>
		{
			weeks.length > 0 ? (
				<WeeklyResults weeks={weeks} defaultWeek={defaultWeek} />
			) : (
				<p class="about-description">Fixtures will appear here once this league's matches are added.</p>
			)
		}
	</section>

	<ChampionshipSimulator league={league} matches={matchesData} standings={leagueTableData} />

	</div>
	<div id="player-stats" data-league-panel>
	<section class="content-section" aria-labelledby="player-stats-title">
		<h2 id="player-stats-title">Player Stats</h2>
		{
			leaderboard.length > 0 ? (
				<>
					<p class="about-description">Click a column header to sort.</p>
					<PlayerStatsTable players={leaderboard} />
				</>
			) : (
				<p class="about-description">Player stats appear once the first week has been recorded.</p>
			)
		}
	</section>
	</div>
</main>

<script>
	const root = document.querySelector<HTMLElement>("[data-league-view]");
	if (root) {
		const nav = root.querySelector<HTMLElement>(".league-subnav")!;
		const tabs = Array.from(nav.querySelectorAll<HTMLAnchorElement>("[data-league-tab]"));
		const panels = Array.from(root.querySelectorAll<HTMLElement>("[data-league-panel]"));
		nav.setAttribute("role", "tablist");
		for (const tab of tabs) {
			tab.setAttribute("role", "tab");
			tab.setAttribute("aria-controls", tab.dataset.leagueTab!);
		}
		for (const panel of panels) {
			panel.setAttribute("role", "tabpanel");
			panel.setAttribute("aria-labelledby", `${panel.id}-tab`);
			panel.tabIndex = 0;
		}
		function syncFromUrl(scrollToAnchor = false) {
			const hash = location.hash.slice(1);
			const selected = hash === "player-stats" || hash === "player-stats-title" ? "player-stats" : "overview";
			for (const panel of panels) panel.hidden = panel.id !== selected;
			for (const tab of tabs) {
				const active = tab.dataset.leagueTab === selected;
				tab.setAttribute("aria-selected", String(active));
				tab.tabIndex = active ? 0 : -1;
			}
			if (scrollToAnchor && hash && hash !== "overview" && hash !== "player-stats") {
				requestAnimationFrame(() => document.getElementById(hash)?.scrollIntoView());
			}
		}
		for (const [index, tab] of tabs.entries()) {
			tab.addEventListener("click", (event) => {
				if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
				event.preventDefault();
				const url = new URL(location.href);
				url.hash = tab.dataset.leagueTab!;
				if (url.href !== location.href) history.pushState(null, "", url);
				syncFromUrl();
			});
			tab.addEventListener("keydown", (event) => {
				let target: number;
				if (event.key === "ArrowRight") target = (index + 1) % tabs.length;
				else if (event.key === "ArrowLeft") target = (index + tabs.length - 1) % tabs.length;
				else if (event.key === "Home") target = 0;
				else if (event.key === "End") target = tabs.length - 1;
				else if (event.key === " ") { event.preventDefault(); tab.click(); return; }
				else return;
				event.preventDefault(); tabs[target].focus(); tabs[target].click();
			});
		}
		window.addEventListener("hashchange", () => syncFromUrl(true));
		window.addEventListener("popstate", () => syncFromUrl(true));
		syncFromUrl(true);
	}
</script>
