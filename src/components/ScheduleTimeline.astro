---
import T from "./T.astro";
import { TYPE_LABELS, TYPE_LABELS_KO, buildScheduleView, eventTitle, groupByMonth, type ScheduleEvent } from "../lib/schedule";
import { formatShortDate } from "../lib/i18n";

interface Props {
	events: ScheduleEvent[];
}

const { events } = Astro.props;
const groups = groupByMonth(buildScheduleView(events));
---

<div class="schedule-timeline" data-schedule-events={JSON.stringify(events)}>
	{
		groups.map((group) => (
			<div class="schedule-month">
				<h3 class="schedule-month-label"><T en={group.label} ko={group.labelKo} /></h3>
				<ol class="schedule-list">
					{group.events.map((event) => {
						const itemClass = [
							"schedule-item",
							event.isPast && "schedule-item--past",
							event.isNextUp && "schedule-item--next",
						]
							.filter(Boolean)
							.join(" ");
						const inner = (
							<>
								<div class="schedule-item-date">
									{event.date ? (
										<T en={formatShortDate(event.date, "en")} ko={formatShortDate(event.date, "ko")} />
									) : (
										<T en="TBD" ko="미정" />
									)}
									{event.tbd && event.date && (
										<span class="schedule-tbd-badge">
											<T en="TBD" ko="미정" />
										</span>
									)}
								</div>
								<div class="schedule-item-body">
									{event.isNextUp && (
										<span class="schedule-next-label">
											<T en="Next up" ko="다음 일정" />
										</span>
									)}
									<span class={`schedule-type-badge schedule-type-badge--${event.type}`}>
										<T en={TYPE_LABELS[event.type]} ko={TYPE_LABELS_KO[event.type]} />
									</span>
									<p class="schedule-item-title">
										<T en={eventTitle(event, "en")} ko={eventTitle(event, "ko")} />
									</p>
								</div>
							</>
						);
						return (
							<li class={itemClass} data-event-index={event.index}>
								{event.href ? (
									<a class="schedule-item-link" href={event.href}>
										{inner}
									</a>
								) : (
									<div class="schedule-item-link">{inner}</div>
								)}
							</li>
						);
					})}
				</ol>
			</div>
		))
	}
</div>

<script>
	import { buildScheduleView, type ScheduleEvent } from "../lib/schedule";
	import { bilingualHtml } from "../lib/i18n";

	// The timeline above is rendered with "today" as of the last build, which
	// goes stale between deploys. Recompute past/next-up against the
	// visitor's actual current date and patch the DOM to match — the item
	// order and month grouping don't change (those depend only on each
	// event's own date), so this only needs to touch classes and the
	// "Next up" label.
	const root = document.querySelector<HTMLDivElement>(".schedule-timeline");
	const raw = root?.dataset.scheduleEvents;
	if (root && raw) {
		const events = JSON.parse(raw) as ScheduleEvent[];
		const view = buildScheduleView(events);

		root.querySelectorAll<HTMLLIElement>(".schedule-item[data-event-index]").forEach((item) => {
			const info = view[Number(item.dataset.eventIndex)];
			if (!info) return;

			item.classList.toggle("schedule-item--past", info.isPast);
			item.classList.toggle("schedule-item--next", info.isNextUp);

			const body = item.querySelector(".schedule-item-body");
			const existingLabel = body?.querySelector(".schedule-next-label");
			if (info.isNextUp && !existingLabel) {
				const label = document.createElement("span");
				label.className = "schedule-next-label";
				label.innerHTML = bilingualHtml("Next up", "다음 일정");
				body?.prepend(label);
			} else if (!info.isNextUp && existingLabel) {
				existingLabel.remove();
			}
		});
	}
</script>
