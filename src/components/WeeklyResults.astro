---
import T from "./T.astro";
import { formatShortDate, weekLabel } from "../lib/i18n";
import type { TimelineEntry } from "../lib/match-timeline";

interface Match {
	week: number;
	round: number;
	match_id?: string;
	home_team: string;
	away_team: string;
	home_score: number | null;
	away_score: number | null;
	status: "completed" | "scheduled";
	date: string;
}

interface WeekSummaryRow {
	week: number;
	team: string;
	wins: number;
	draws: number;
	losses: number;
	points: number;
}

interface Week {
	week: number;
	date: string;
	hasResults: boolean;
	rounds: number[];
	matches: Match[];
	summary: WeekSummaryRow[];
}

interface Props {
	weeks: Week[];
	defaultWeek: number;
	/** When set, each week's table gets a link that opens this points-chart popup. */
	raceDialogId?: string;
	/**
	 * match_id -> that match's goals in minute order (src/lib/match-timeline.ts).
	 * A match that isn't in here just shows its score, which is every match in a
	 * league recorded without goal minutes.
	 */
	timelines?: Map<string, TimelineEntry[]>;
	/** team_id -> color, for the dot and the marker beside each scorer. */
	teamColor?: (teamId: string | null) => string;
	/** Match length, so a goal's minute places the dot along the bar. */
	matchMinutes?: number;
}

const { weeks, defaultWeek, raceDialogId, timelines, teamColor, matchMinutes = 12 } = Astro.props;
const goalsOf = (match: Match) => (match.match_id && timelines?.get(match.match_id)) || [];
const ROLE_MARK: Record<string, { en: string; ko: string }> = {
	winner: { en: "winner", ko: "결승골" },
	equaliser: { en: "equaliser", ko: "동점골" },
	comeback: { en: "comeback", ko: "역전골" },
};

const matchesForRound = (week: Week, round: number) => week.matches.filter((match) => match.round === round);
---

<div class="week-tabs">
	<div class="week-tab-list" role="tablist">
		{
			weeks.map((week) => (
				<button
					class="week-tab"
					type="button"
					role="tab"
					data-week={week.week}
					aria-selected={week.week === defaultWeek ? "true" : "false"}
				>
					{week.hasResults ? (
						<T en={weekLabel(week.week, "en")} ko={weekLabel(week.week, "ko")} />
					) : (
						<T en="Upcoming" ko="예정" />
					)}
				</button>
			))
		}
	</div>

	{
		weeks.map((week) => (
			<div
				class={`week-panel${week.week === defaultWeek ? " week-panel--visible" : ""}`}
				data-week-panel={week.week}
				hidden={week.week !== defaultWeek}
			>
				<p class="week-date">
					<T en={formatShortDate(week.date, "en")} ko={formatShortDate(week.date, "ko")} />
				</p>

				{week.summary.length > 0 && (
					<table class="week-summary-table">
						<thead>
							<tr>
								<th><T en="Team" ko="팀" /></th>
								<th><T en="W" ko="승" /></th>
								<th><T en="D" ko="무" /></th>
								<th><T en="L" ko="패" /></th>
								<th><T en="Pts" ko="승점" /></th>
							</tr>
						</thead>
						<tbody>
							{week.summary.map((row) => (
								<tr>
									<td class="week-summary-team">{row.team}</td>
									<td>{row.wins}</td>
									<td>{row.draws}</td>
									<td>{row.losses}</td>
									<td class="week-summary-points">{row.points}</td>
								</tr>
							))}
						</tbody>
					</table>
				)}
				{raceDialogId && week.summary.length > 0 && (
					<button class="week-race-link" type="button" aria-haspopup="dialog" data-race-open={raceDialogId}>
						<span aria-hidden="true">📈</span> <T en="Points by week chart" ko="주차별 승점 그래프 보기" /> →
					</button>
				)}

				<div class="week-rounds">
					{week.rounds.map((round) => (
						<div class="round-group">
							<h3 class="round-label">
								<T en={`Round ${round}`} ko={`${round}라운드`} />
							</h3>
							<div class="match-cards">
								{matchesForRound(week, round).map((match) => {
									const homeWins = match.status === "completed" && match.home_score! > match.away_score!;
									const awayWins = match.status === "completed" && match.away_score! > match.home_score!;
									const teamClass = (isWinner: boolean, isLoser: boolean) =>
										["match-card-team", isWinner && "match-card-team--winner", isLoser && "match-card-team--loser"]
											.filter(Boolean)
											.join(" ");
									return (
										<div class="match-card">
											<div class="match-card-line">
												<span class={teamClass(homeWins, awayWins)}>{match.home_team}</span>
												{match.status === "completed" ? (
													<span class="match-score">
														{match.home_score} – {match.away_score}
													</span>
												) : (
													<span class="match-score match-score--vs">vs</span>
												)}
												<span class={teamClass(awayWins, homeWins)}>{match.away_team}</span>
											</div>
											{goalsOf(match).length > 0 && (
												<div class="match-timeline">
													<div
														class="match-timeline-bar"
														role="img"
														aria-label={goalsOf(match)
															.map((goal) => `${goal.minute}min ${goal.scorer}`)
															.join(", ")}
													>
														{goalsOf(match).map((goal) => (
															<span
																class="match-timeline-dot"
																style={`left: ${goal.at * 100}%; background-color: ${teamColor?.(goal.teamId) ?? "var(--color-green)"}`}
															/>
														))}
													</div>
													<ul class="match-timeline-goals">
														{goalsOf(match).map((goal) => (
															<li>
																<span class="match-timeline-minute">{goal.minute}'</span>
																<span
																	class="match-timeline-swatch"
																	style={`background-color: ${teamColor?.(goal.teamId) ?? "var(--color-green)"}`}
																	aria-hidden="true"
																/>
																<span class="match-timeline-scorer">{goal.scorer}</span>
																{goal.ownGoal && <T class="match-timeline-tag" en="own goal" ko="자책골" />}
																{!goal.ownGoal && goal.assist && (
																	<T
																		class="match-timeline-assist"
																		en={`assist ${goal.assist}`}
																		ko={`어시 ${goal.assist}`}
																	/>
																)}
																{goal.role && (
																	<T
																		class="match-timeline-tag"
																		en={ROLE_MARK[goal.role].en}
																		ko={ROLE_MARK[goal.role].ko}
																	/>
																)}
															</li>
														))}
													</ul>
												</div>
											)}
										</div>
									);
								})}
							</div>
						</div>
					))}
				</div>
			</div>
		))
	}
</div>

<script>
	const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>(".week-tab"));
	const panels = Array.from(document.querySelectorAll<HTMLDivElement>(".week-panel"));

	tabs.forEach((tab) => {
		tab.addEventListener("click", () => {
			const week = tab.dataset.week;
			if (tab.getAttribute("aria-selected") === "true") return;

			tabs.forEach((otherTab) => otherTab.setAttribute("aria-selected", String(otherTab === tab)));

			panels.forEach((panel) => {
				const isTarget = panel.dataset.weekPanel === week;
				if (!isTarget) {
					panel.classList.remove("week-panel--visible");
					panel.hidden = true;
					return;
				}
				panel.hidden = false;
				// Force a style flush before adding the class so the opacity
				// transition actually plays instead of jumping straight to visible.
				panel.classList.remove("week-panel--visible");
				requestAnimationFrame(() => {
					requestAnimationFrame(() => panel.classList.add("week-panel--visible"));
				});
			});
		});
	});

	// Deep link from the Schedule page (e.g. /league/FA26-L1?week=3): select that
	// week's tab on load if it exists. No-op if the week isn't in the sheet
	// yet (future weeks are only added once the Google Sheet has rows for
	// them).
	const requestedWeek = new URLSearchParams(location.search).get("week");
	const requestedTab = requestedWeek && tabs.find((tab) => tab.dataset.week === requestedWeek);
	if (requestedTab && requestedTab.getAttribute("aria-selected") !== "true") {
		requestedTab.click();
	}
</script>
