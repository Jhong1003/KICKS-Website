---
import T from "./T.astro";

interface Player {
	rank: number;
	player: string;
	team: string;
	goals: number;
	assists: number;
	attacking_points: number;
	weeks_attended: number;
	weeks_played: number;
	id: string;
}

interface Props {
	players: Player[];
}

const { players } = Astro.props;

const columns = [
	{ key: "rank", label: "Rank", labelKo: "순위", type: "number" },
	{ key: "player", label: "Player", labelKo: "선수", type: "string" },
	{ key: "team", label: "Team", labelKo: "팀", type: "string" },
	{ key: "attendance", label: "Attendance", labelKo: "출석", type: "number" },
	{ key: "goals", label: "Goals", labelKo: "골", type: "number" },
	{ key: "assists", label: "Assists", labelKo: "어시스트", type: "number" },
	{ key: "attacking_points", label: "Attacking Pts", labelKo: "공격포인트", type: "number" },
] as const;
---

<div class="table-scroll">
	<table class="player-stats-table">
		<thead>
			<tr>
				{
					columns.map((column) => (
						<th data-sortable data-type={column.type}>
							<T en={column.label} ko={column.labelKo} />
						</th>
					))
				}
			</tr>
		</thead>
		<tbody>
			{
				players.map((player) => (
					<tr class={player.rank <= 3 ? "player-row-top" : undefined}>
						<td data-sort-value={player.rank}>{player.rank}</td>
						<td class="player-stats-name" data-sort-value={player.player.toLowerCase()}>
							<a href={`/players/${player.id}`}>{player.player}</a>
						</td>
						<td data-sort-value={player.team.toLowerCase()}>{player.team}</td>
						<td data-sort-value={player.weeks_attended}>
							{player.weeks_attended} / {player.weeks_played}
						</td>
						<td data-sort-value={player.goals}>{player.goals}</td>
						<td data-sort-value={player.assists}>{player.assists}</td>
						<td data-sort-value={player.attacking_points}>{player.attacking_points}</td>
					</tr>
				))
			}
		</tbody>
	</table>
</div>

<script>
	const table = document.querySelector<HTMLTableElement>(".player-stats-table");
	const headers = table ? Array.from(table.querySelectorAll<HTMLTableCellElement>("th[data-sortable]")) : [];

	headers.forEach((header, columnIndex) => {
		header.addEventListener("click", () => {
			const currentDirection = header.dataset.direction === "asc" ? "asc" : "desc";
			const nextDirection = currentDirection === "asc" ? "desc" : "asc";

			headers.forEach((otherHeader) => {
				otherHeader.removeAttribute("aria-sort");
				delete otherHeader.dataset.direction;
			});
			header.dataset.direction = nextDirection;
			header.setAttribute("aria-sort", nextDirection === "asc" ? "ascending" : "descending");

			const isNumeric = header.dataset.type === "number";
			const rows = Array.from(table!.tBodies[0].rows);

			rows.sort((rowA, rowB) => {
				const valueA = rowA.cells[columnIndex].dataset.sortValue ?? "";
				const valueB = rowB.cells[columnIndex].dataset.sortValue ?? "";
				const comparison = isNumeric ? Number(valueA) - Number(valueB) : valueA.localeCompare(valueB);
				return nextDirection === "asc" ? comparison : -comparison;
			});

			rows.forEach((row) => table!.tBodies[0].appendChild(row));
		});
	});
</script>
