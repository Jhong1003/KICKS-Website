---
import T from "./T.astro";
---

<form class="inquiry-form" id="partner-inquiry" action="https://formspree.io/f/xvkkyerv" method="POST">
	<input type="hidden" name="subject" value="KICKS · Partnership inquiry / 파트너십 문의" />
	<div class="inquiry-row">
	<div class="form-field">
		<label for="brand-name"><T en="Brand Name" ko="브랜드명" /></label>
		<input type="text" id="brand-name" name="brand-name" autocomplete="organization" maxlength="200" required />
	</div>

	<div class="form-field">
		<label for="contact-name"><T en="Contact Person" ko="담당자 이름" /></label>
		<input type="text" id="contact-name" name="name" autocomplete="name" maxlength="100" required />
	</div>
	</div>

	<div class="form-field">
		<label for="email"><T en="Email" ko="이메일" /></label>
		<input type="email" id="email" name="email" autocomplete="email" maxlength="254" required />
	</div>

	<div class="form-field">
		<label for="proposal"><T en="Proposal Details" ko="제안 내용" /></label>
		<textarea id="proposal" name="message" rows="5" maxlength="10000" required></textarea>
	</div>

	<button class="k-btn inquiry-submit" type="submit"><span data-inquiry-idle><T en="Send" ko="보내기" /></span><span data-inquiry-sending hidden><T en="Sending…" ko="보내는 중…" /></span></button>
	<div class="inquiry-note" role="status" aria-live="polite">
		<p data-inquiry-success hidden><T en="Your inquiry has been submitted. We’ll reply to the email address you provided." ko="문의가 접수됐어요. 남겨주신 이메일로 답변드리겠습니다." /></p>
		<p data-inquiry-error hidden><T en="We couldn’t confirm your submission. Your message is still here. Please try again later or email kicks.uiuc@gmail.com." ko="문의 접수를 확인하지 못했습니다. 입력한 내용은 그대로 남아 있습니다. 잠시 후 다시 시도하거나 kicks.uiuc@gmail.com으로 메일을 보내주세요." /></p>
	</div>
</form>

<style>
	.inquiry-form { display: grid; gap: 16px; max-width: none; margin: 0; }
	.inquiry-row { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }
	.inquiry-form :global(.form-field) { display: grid; gap: 6px; margin: 0; }
	.inquiry-form label { color: var(--k-muted); font-size: 0.82rem; font-weight: 600; }
	.inquiry-form input,
	.inquiry-form textarea {
		width: 100%;
		padding: 11px 12px;
		border: 1px solid var(--k-line);
		border-radius: 0;
		background: #fff;
		font: inherit;
		font-size: 0.95rem;
	}
	.inquiry-form input:focus,
	.inquiry-form textarea:focus { outline: 2px solid var(--k-olive); outline-offset: -1px; border-color: var(--k-olive); }
	.inquiry-submit { justify-self: start; min-width: 120px; }
	:global(.inquiry-note) { margin: 0; color: var(--k-muted); line-height: 1.6; font-size: 0.82rem; }
	@media (max-width: 600px) { .inquiry-row { grid-template-columns: 1fr; } }
</style>

<script>
 const form = document.querySelector<HTMLFormElement>("#partner-inquiry");
 if (form) {
  const submit = form.querySelector<HTMLButtonElement>("button[type=submit]")!;
  const idle = form.querySelector<HTMLElement>("[data-inquiry-idle]")!;
  const sending = form.querySelector<HTMLElement>("[data-inquiry-sending]")!;
  const success = form.querySelector<HTMLElement>("[data-inquiry-success]")!;
  const error = form.querySelector<HTMLElement>("[data-inquiry-error]")!;
  form.addEventListener("submit", async (event) => {
   event.preventDefault();
   if (submit.disabled || !form.reportValidity()) return;
   success.hidden = true;
   error.hidden = true;
   const data = new FormData(form);
   submit.disabled = true;
   idle.hidden = true;
   sending.hidden = false;
   form.setAttribute("aria-busy", "true");
   const controller = new AbortController();
   const timer = setTimeout(() => controller.abort(), 15000);
   try {
    const response = await fetch(form.action, {
     method: "POST", body: data, headers: { Accept: "application/json" }, signal: controller.signal,
    });
    if (!response.ok) throw new Error("Submission not accepted");
    form.reset();
    success.hidden = false;
   } catch {
    error.hidden = false;
   } finally {
    clearTimeout(timer);
    submit.disabled = false;
    idle.hidden = false;
    sending.hidden = true;
    form.removeAttribute("aria-busy");
   }
  });
 }
</script>
