---
// Decorative grill illustration for the dinner popup (EventPopup.astro):
// sausages, a skewer and a corn cob on a charcoal grill, with flames and
// smoke, in the site's green and sage. Pure SVG, no image file.
const flames = [100, 176, 296, 358, 398];
const cubes = [
	{ x: 186, fill: "#8c3b25" },
	{ x: 204, fill: "#5f8f3a" },
	{ x: 222, fill: "#f3e6cf" },
	{ x: 240, fill: "#8c3b25" },
	{ x: 258, fill: "#5f8f3a" },
	{ x: 276, fill: "#8c3b25" },
];
const kernels = Array.from({ length: 8 }, (_, i) => ({ x: 372 + (i % 4) * 7, y: 104 + Math.floor(i / 4) * 7 }));
---

<svg class="bbq-art" viewBox="0 0 480 180" preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false">
	<defs>
		<linearGradient id="bbq-sky" x1="0" y1="0" x2="0" y2="1">
			<stop offset="0" stop-color="#e7ebdf" />
			<stop offset="1" stop-color="#dce2d3" />
		</linearGradient>
		<radialGradient id="bbq-glow" cx="0.5" cy="0.72" r="0.45">
			<stop offset="0" stop-color="#f7b955" stop-opacity="0.55" />
			<stop offset="1" stop-color="#f7b955" stop-opacity="0" />
		</radialGradient>
	</defs>

	<rect width="480" height="180" fill="url(#bbq-sky)" />
	<rect width="480" height="180" fill="url(#bbq-glow)" />

	<!-- smoke -->
	<g fill="none" stroke="#ffffff" stroke-width="5" stroke-linecap="round" opacity="0.75">
		<path class="bbq-smoke" d="M150 86 C140 70 162 60 150 44 C140 30 158 22 150 10" />
		<path class="bbq-smoke bbq-smoke--2" d="M240 84 C230 66 252 56 240 38 C230 24 248 16 240 4" />
		<path class="bbq-smoke bbq-smoke--3" d="M332 86 C322 70 344 60 332 44 C322 30 340 22 332 12" />
	</g>

	<!-- legs -->
	<g stroke="#2e3b1d" stroke-width="7" stroke-linecap="round">
		<line x1="150" y1="160" x2="128" y2="190" />
		<line x1="330" y1="160" x2="352" y2="190" />
	</g>

	<!-- flames, behind the food -->
	{flames.map((x) => (
		<g class="bbq-flame">
			<path d={`M${x} 120 C${x - 11} 108 ${x - 4} 98 ${x} 86 C${x + 5} 98 ${x + 11} 108 ${x} 120 Z`} fill="#ef7d2d" />
			<path d={`M${x} 120 C${x - 6} 112 ${x - 2} 106 ${x} 99 C${x + 3} 106 ${x + 6} 112 ${x} 120 Z`} fill="#f9cf4a" />
		</g>
	))}

	<!-- bowl -->
	<path d="M76 124 H404 Q398 166 314 170 H166 Q82 166 76 124 Z" fill="#3f5128" />
	<path d="M104 136 Q240 146 376 136" fill="none" stroke="#56693b" stroke-width="3" stroke-linecap="round" />

	<!-- sausage -->
	<rect x="104" y="100" width="64" height="19" rx="9.5" fill="#b4472b" />
	<rect x="110" y="103" width="48" height="4" rx="2" fill="#d36a45" opacity="0.7" />
	<g stroke="#6e2615" stroke-width="2.5" stroke-linecap="round">
		<line x1="122" y1="104" x2="118" y2="116" />
		<line x1="136" y1="104" x2="132" y2="116" />
		<line x1="150" y1="104" x2="146" y2="116" />
	</g>

	<!-- skewer -->
	<line x1="178" y1="110" x2="296" y2="110" stroke="#c99a5b" stroke-width="3" stroke-linecap="round" />
	{cubes.map((cube) => <rect x={cube.x} y="101" width="16" height="17" rx="4" fill={cube.fill} />)}

	<!-- sausage -->
	<rect x="300" y="100" width="56" height="19" rx="9.5" fill="#a63f25" />
	<rect x="306" y="103" width="40" height="4" rx="2" fill="#c95e3b" opacity="0.7" />
	<g stroke="#6e2615" stroke-width="2.5" stroke-linecap="round">
		<line x1="318" y1="104" x2="314" y2="116" />
		<line x1="332" y1="104" x2="328" y2="116" />
	</g>

	<!-- corn -->
	<rect x="364" y="99" width="34" height="20" rx="10" fill="#f2c14e" />
	{kernels.map((k) => <circle cx={k.x} cy={k.y} r="2" fill="#d9a22c" />)}
	<path d="M364 109 C356 100 350 98 344 100 C350 106 354 114 366 117 Z" fill="#7fa64a" />

	<!-- grate -->
	<rect x="70" y="118" width="340" height="6" rx="3" fill="#2e3b1d" />
</svg>

<style>
	.bbq-art { display: block; width: 100%; height: auto; aspect-ratio: 480 / 180; }
	@media (prefers-reduced-motion: no-preference) {
		.bbq-flame { transform-box: fill-box; transform-origin: 50% 100%; animation: bbq-flicker 1.4s ease-in-out infinite alternate; }
		.bbq-flame:nth-of-type(2n) { animation-duration: 1.1s; animation-delay: -0.4s; }
		.bbq-smoke { animation: bbq-rise 3.2s ease-in-out infinite; }
		.bbq-smoke--2 { animation-delay: -1.1s; }
		.bbq-smoke--3 { animation-delay: -2.2s; }
		@keyframes bbq-flicker { from { transform: scaleY(0.88); } to { transform: scaleY(1.08); } }
		@keyframes bbq-rise { 0% { opacity: 0; transform: translateY(8px); } 40% { opacity: 0.8; } 100% { opacity: 0; transform: translateY(-10px); } }
	}
</style>
