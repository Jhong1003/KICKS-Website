---
import T from "./T.astro";

// The managers' match log (/match-log) is linked only from the league pages'
// footer: small, out of the members' way, and still one tap from the site.
// (It moves into the admin page later.)
const onLeaguePage = /^\/league(\/|$)/.test(Astro.url.pathname);
---

<footer class="k-footer">
	<div class="k-footer-inner">
		<div class="k-footer-top">
			<div class="k-footer-brand">
				<span class="k-footer-name">KICKS</span>
				<span class="k-footer-tagline">Korean-Inspired Community for Kicking Sports · UIUC</span>
			</div>
			<a class="k-footer-link" href="https://www.instagram.com/kicks.uiuc" target="_blank" rel="noopener noreferrer">
				Instagram @kicks.uiuc
			</a>
		</div>

		<div class="k-footer-bottom">
			<span>
				© {new Date().getFullYear()} KICKS
				<span class="k-footer-sep" aria-hidden="true">·</span>
				<a class="k-footer-link k-footer-link--quiet" href="/app/"><T en="Get the app" ko="앱 설치" /></a>
				{onLeaguePage && (
					<>
						<span class="k-footer-sep" aria-hidden="true">·</span>
						<a class="k-footer-link k-footer-link--quiet" href="/match-log/" rel="nofollow"><T en="Manager" ko="매니저" /></a>
					</>
				)}
			</span>
			<span id="daily-visits" hidden>
				<T>
					<Fragment slot="en">Today · <span data-visit-count></span> visitors</Fragment>
					<Fragment slot="ko">오늘 방문자 · <span data-visit-count></span></Fragment>
				</T>
			</span>
		</div>
	</div>
</footer>

<script>
	import { startVisitCounter } from "../lib/visit-counter";
	const counter = document.getElementById("daily-visits");
	if (counter) startVisitCounter(counter);
</script>
