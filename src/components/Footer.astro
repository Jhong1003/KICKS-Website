---
import T from "./T.astro";
---

<footer class="site-footer">
	<div class="site-footer-brand">
		<span class="site-footer-name">KICKS</span>
		<span class="site-footer-tagline">Korean-Inspired Community for Kicking Sports · UIUC</span>
	</div>

	<div class="site-footer-contact">
		<a href="https://www.instagram.com/kicks.uiuc" target="_blank" rel="noopener noreferrer">
			Instagram @kicks.uiuc
		</a>
		{/* The club's official UIUC registered student organization page; linking both ways
		    (and in the homepage JSON-LD sameAs) tells search engines they're the same KICKS. */}
		<a href="https://one.illinois.edu/feeds?type=club&type_id=37096&tab=about" target="_blank" rel="noopener noreferrer">
			<T en="UIUC student organization page" ko="UIUC 공식 동아리 페이지" />
		</a>
		<span><T en="KakaoTalk" ko="카카오톡" />: ghd991003</span>
	</div>

	<div class="site-footer-copyright">
		<span>© {new Date().getFullYear()} KICKS. All rights reserved.</span>
		<span id="daily-visits" hidden>
			<T>
				<Fragment slot="en"><span class="visits-heading">TODAY</span><br />👀 <span data-visit-count></span> visitors</Fragment>
				<Fragment slot="ko">👀 오늘 방문자 · <span data-visit-count></span></Fragment>
			</T>
		</span>
	</div>
</footer>

<script>
	import { startVisitCounter } from "../lib/visit-counter";
	const counter = document.getElementById("daily-visits");
	if (counter) startVisitCounter(counter);
</script>

<style>
	.site-footer-copyright { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 12px 24px; }
	#daily-visits { white-space: nowrap; }
	.visits-heading { font-size: 0.65rem; letter-spacing: 0.08em; }
</style>
