---
// The points-race chart in a popup, opened by the "points chart" link under
// each week's table in Match Results (WeeklyResults, data-race-open="<this
// id>"), so the chart is one tap away without crowding the results. The
// dialog itself is ChartDialog, shared with the title-chance history.
import ChartDialog from "./ChartDialog.astro";
import PointsRaceChart from "./PointsRaceChart.astro";
import historyData from "../data/standings_history.json";
import type { League } from "../lib/leagues";
import { pointsRaceDialogId } from "../lib/points-race";

interface Props {
	league: League;
	finished: boolean;
}

const { league, finished } = Astro.props;
const hasHistory = (historyData as { league: string }[]).some((row) => row.league === league.id);
---

{
	hasHistory && (
		<ChartDialog id={pointsRaceDialogId(league.id)} label="Points by week" labelKo="주차별 승점">
			<PointsRaceChart league={league} finished={finished} compact />
		</ChartDialog>
	)
}
