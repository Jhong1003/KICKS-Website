---
// One album's photos: a grid of thumbnails and a lightbox. The page passes
// the album's images (see src/lib/gallery.ts for where they come from).
// Thumbnails are 480px wide; the lightbox opens a 1600px version instead of
// stretching the thumbnail.
import { Image, getImage } from "astro:assets";
import T from "./T.astro";
import type { GalleryImage } from "../lib/gallery";

interface Props {
	images: GalleryImage[];
}

const { images } = Astro.props;
const fullSize = await Promise.all(images.map((image) => getImage({ src: image.src, width: 1600 })));
---

{
	images.length === 0 ? (
		<T
			as="p"
			class="gallery-empty"
			en="No photos yet."
			ko="아직 사진이 없어요."
		/>
	) : (
		<div class="gallery-grid">
			{images.map((image, index) => (
				<button class="gallery-item" type="button" data-index={index} data-full={fullSize[index].src} aria-label={`View photo: ${image.alt}`}>
					<Image src={image.src} alt={image.alt} width={480} loading="lazy" />
				</button>
			))}
		</div>
	)
}

<div class="lightbox" id="lightbox" hidden>
	<button class="lightbox-close" type="button" aria-label="Close">✕</button>
	<button class="lightbox-prev" type="button" aria-label="Previous photo">‹</button>
	<img class="lightbox-image" id="lightbox-image" src="" alt="" />
	<button class="lightbox-next" type="button" aria-label="Next photo">›</button>
</div>

<script>
	const items = Array.from(document.querySelectorAll<HTMLButtonElement>(".gallery-item"));
	const lightbox = document.getElementById("lightbox");
	const lightboxImage = document.getElementById("lightbox-image") as HTMLImageElement | null;
	let currentIndex = 0;

	function openLightbox(index: number) {
		currentIndex = index;
		const item = items[currentIndex];
		const img = item?.querySelector("img");
		if (!img || !lightboxImage || !lightbox) return;
		lightboxImage.src = item.dataset.full ?? img.src;
		lightboxImage.alt = img.alt;
		lightbox.hidden = false;
	}

	function closeLightbox() {
		if (lightbox) lightbox.hidden = true;
	}

	function showRelative(delta: number) {
		if (items.length === 0) return;
		currentIndex = (currentIndex + delta + items.length) % items.length;
		openLightbox(currentIndex);
	}

	items.forEach((item, index) => {
		item.addEventListener("click", () => openLightbox(index));
	});

	document.querySelector(".lightbox-close")?.addEventListener("click", closeLightbox);
	document.querySelector(".lightbox-prev")?.addEventListener("click", () => showRelative(-1));
	document.querySelector(".lightbox-next")?.addEventListener("click", () => showRelative(1));

	lightbox?.addEventListener("click", (event) => {
		if (event.target === lightbox) closeLightbox();
	});

	document.addEventListener("keydown", (event) => {
		if (lightbox?.hidden) return;
		if (event.key === "Escape") closeLightbox();
		if (event.key === "ArrowLeft") showRelative(-1);
		if (event.key === "ArrowRight") showRelative(1);
	});
</script>
