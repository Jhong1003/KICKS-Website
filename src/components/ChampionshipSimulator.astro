---
import T from "./T.astro";
import type { League } from "../lib/leagues";
import { buildSimulationModel, type MatchRecord, type SimulationModel } from "../lib/championship-simulator";
import type { TeamStanding } from "../lib/standings";
import TitleChanceHistory from "./TitleChanceHistory.astro";
interface Props {
	league: League;
	matches: MatchRecord[];
	standings: (TeamStanding & { league: string })[];
}
const { league, matches, standings } = Astro.props;
let model: SimulationModel | undefined;
let error = "";
try { model = buildSimulationModel(league, matches, standings); }
catch (reason) { error = reason instanceof Error ? reason.message : "경기 데이터를 확인해주세요."; }
// Keep the generated official standings order, including the presentation order of tied teams.
// Teams without a standings row are appended in league roster order. Never sort by simulated credit.
const orderedIds = [...new Set([
	...standings.filter((row) => row.league === league.id).map((row) => row.team_id),
	...league.teams.map((team) => team.team_id),
])];
const orderedTeams = orderedIds.flatMap((id) => league.teams.filter((team) => team.team_id === id));
---
<div id="title-race" class="forecast-block championship-simulator" aria-labelledby="simulator-title" data-model={model ? JSON.stringify(model) : undefined}>
	<h3 id="simulator-title"><T en="Title Chances" ko="우승 확률" /></h3>
	<div class="title-race-grid">
	{error ? <p role="alert"><T en="Couldn't calculate: " ko="계산하지 못했어요: " />{error}</p> : model && <div class="title-race-now">
		<div class="title-race-results" data-simulator-results>
			{orderedTeams.map((team) => <div class="simulator-team" data-team-id={team.team_id}>
				<strong>{team.name}</strong><span data-credit>—</span>
				<meter hidden min="0" max="100" value="0" aria-label={`${team.name} championship credit`} />
			</div>)}
		</div>
		<p class="title-race-meta" data-simulator-meta>
			<T en={`${model.remaining.length} matches remaining`} ko={`남은 경기 ${model.remaining.length}경기`} />
		</p>
		<p class="title-race-status" data-simulator-status role="status" aria-live="polite"><T en="Calculating…" ko="계산하는 중…" /></p>
		<noscript><p><T en="Turn on JavaScript to see the results." ko="결과를 보려면 JavaScript를 켜 주세요." /></p></noscript>

	</div>}
	{/* Beside the live percentages, not under them: same block on purpose, so
	    the number now and how it got there read as one thing. Shows itself
	    from two published weeks, and the grid is one column until then. */}
	<TitleChanceHistory league={league} />
	</div>
</div>

<script>
	import { formatTitleChance, simulate, titleStatus, type SimulationModel } from "../lib/championship-simulator";
	import { bilingualHtml } from "../lib/i18n";
	for (const root of document.querySelectorAll<HTMLElement>(".championship-simulator[data-model]")) {
		const model = JSON.parse(root.dataset.model!) as SimulationModel;
		const status = root.querySelector<HTMLElement>("[data-simulator-status]")!;
		const meta = root.querySelector<HTMLElement>("[data-simulator-meta]")!;
		async function run() {
			root.setAttribute("aria-busy", "true");
			try {
				const result = await simulate(model, {}, 10000);
				const statuses = titleStatus(model);
				for (const row of root.querySelectorAll<HTMLElement>("[data-team-id]")) {
					const teamId = row.dataset.teamId!;
					const status = statuses[teamId];
					// A settled team's bar is exactly full/empty; otherwise the simulated share.
					const percentage = status === "clinched" ? 100 : status === "eliminated" ? 0 : result.credits[teamId] * 100;
					const label = formatTitleChance(result.credits[teamId] * 100, status);
					row.querySelector<HTMLElement>("[data-credit]")!.innerHTML = bilingualHtml(label.en, label.ko);
					row.dataset.status = status;
					const meter = row.querySelector<HTMLMeterElement>("meter")!;
					meter.value = percentage;
					meter.hidden = false;
				}
				const trials = result.trials.toLocaleString("en-US");
				const remaining = model.remaining.length;
				meta.innerHTML = bilingualHtml(
					`${result.exact ? "Exact result" : `${trials} simulations`} · ${remaining} matches remaining`,
					`${result.exact ? "정확한 계산" : `시뮬레이션 ${trials}회`} · 남은 경기 ${remaining}경기`,
				);
				status.textContent = "";
			} catch (error) {
				if (error instanceof Error) status.textContent = error.message;
				else status.innerHTML = bilingualHtml("Calculation failed.", "계산에 실패했습니다.");
			} finally {
				root.removeAttribute("aria-busy");
			}
		}
		// Run once per page load; changing League tabs keeps the same result.
		if (model.lambda === null && model.remaining.length > 0) {
			status.innerHTML = bilingualHtml(
				"No completed matches yet, so the calculation is on hold.",
				"완료 경기 데이터가 없어 자동 계산을 보류합니다.",
			);
		} else void run();
	}
</script>

<style>
	/* Two columns where there's room: the percentages now on the left, how they
	   have moved week by week on the right. auto-fit means a block on its own
	   (no published history yet) simply fills the row. */
	.title-race-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 1rem 2.5rem; align-items: start; }
	.title-race-results { max-width: 700px; }
	.simulator-team { display: grid; grid-template-columns: minmax(0, 1.2fr) 6rem minmax(60px, 1fr); align-items: center; gap: 1rem; padding: .8rem 0; border-bottom: 1px solid var(--color-sage); }
	.simulator-team strong { font-weight: 600; white-space: nowrap; }
	[data-credit] { text-align: right; font-variant-numeric: tabular-nums; white-space: nowrap; }
	.simulator-team[data-status="eliminated"] { opacity: .55; }
	meter { display: block; width: 100%; height: .6rem; border: 0; background: var(--color-sage); border-radius: 0; }
	meter[hidden] { visibility: hidden; display: block; }
	meter::-webkit-meter-bar { background: var(--color-sage); border: 0; border-radius: 0; }
	meter::-webkit-meter-optimum-value { background: var(--color-green); }
	meter::-moz-meter-bar { background: var(--color-green); }
	.title-race-meta { font-size: .8rem; margin: 1rem 0; opacity: .75; font-variant-numeric: tabular-nums; }
	.title-race-status { font-size: .85rem; }
	.title-race-status:empty { display: none; }
	@media (max-width: 480px) { .simulator-team { gap: .6rem; grid-template-columns: minmax(0, 1fr) 5.5rem minmax(50px, .7fr); font-size: .9rem; } }
</style>
